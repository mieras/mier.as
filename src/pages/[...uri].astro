---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import { getAllUris } from '../lib/sanity';
import { getNodeData, getTemplateByRoute } from '../lib/routes';

export const prerender = true;

export async function getStaticPaths() {
  try {
    const paths = await getAllUris();
    // Log tijdens build om te zien wat er gebeurt
    console.log('📦 Building static paths:', paths.length);
    return paths;
  } catch (error) {
    console.error('❌ Failed to generate static paths:', error);
    throw error; // Laat de build falen als paths niet kunnen worden gegenereerd
  }
}

import { getSiteSettings } from '../lib/sanity';
import { getSeoData } from '../lib/seo-helpers';

// Dynamische parameter ophalen
const { uri } = Astro.params;
// Als uri undefined of lege string is, is het de homepage
const slug = uri === undefined || uri === '' ? '/' : `/${uri}/`;

let node;
let error: string | null = null;

try {
  node = await getNodeData(slug);
  // Log tijdens build om te zien of data wordt opgehaald
  console.log(
    `📄 Building page: ${slug}, hasData: ${!!node}, title: ${node?.title || 'N/A'}`,
  );
} catch (e) {
  error = e instanceof Error ? e.message : 'Unknown error';
  console.error(`❌ Failed to load data for ${slug}:`, error);
  // Tijdens build: laat de build falen zodat je het ziet
  throw new Error(`Failed to load page data for ${slug}: ${error}`);
}

if (!node) {
  console.error(`❌ No data returned for ${slug}`);
  throw new Error(`No data returned for ${slug}`);
}

const Template = getTemplateByRoute(node);

// Haal site settings op voor SEO fallbacks
let siteSettings;
try {
  siteSettings = await getSiteSettings();
} catch (e) {
  console.error('❌ Failed to load site settings:', e);
  // Site settings zijn niet kritiek, gebruik fallbacks
  siteSettings = null;
}

// Build URL voor deze pagina
const pageUrl = Astro.site
  ? `${Astro.site}${slug === '/' ? '' : slug}`
  : `https://accessible-astro.dev${slug === '/' ? '' : slug}`;

// Get SEO data met fallbacks
const seoData = getSeoData(
  node.seo,
  siteSettings || undefined, // Convert null to undefined
  node.title,
  'Our amazing studio from Rotterdam',
  pageUrl,
);

// Debug logging (uitgecomment - alleen nodig bij troubleshooting)
// if (import.meta.env.DEV) {
//   console.log('📊 Page:', { slug, hasSeo: !!node.seo, seoKeys: node.seo ? Object.keys(node.seo) : [] });
// }
---

<DefaultLayout
  title={seoData.title}
  description={seoData.description}
  seo={seoData}
  url={pageUrl}
>
  <Template data={node} />
</DefaultLayout>
