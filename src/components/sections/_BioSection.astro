---
import { PortableText } from 'astro-portabletext';

type Props = {
  introCols?: Array<{
    _key: string;
    content: any[];
  }>;
};

const { introCols } = Astro.props;

// PortableText components
const components = {
  types: {},
  marks: {},
  block: {},
  list: {},
  listItem: {},
};

// Get bio content - eerste kolom is About, tweede is Contact
const aboutContent = introCols?.[0]?.content;
const contactContent = introCols?.[1]?.content;
---

{
  (aboutContent || contactContent) && (
    <section class="bio-section">
      {aboutContent && (
        <div class="bio-column">
          <h3 class="bio-label">About</h3>
          <div class="bio-content">
            <PortableText value={aboutContent} components={components} />
          </div>
        </div>
      )}
      {contactContent && (
        <div class="bio-column">
          <h3 class="bio-label">Contact</h3>
          <div class="bio-content">
            <PortableText value={contactContent} components={components} />
          </div>
        </div>
      )}
    </section>
  )
}

<style>
  .bio-section {
    padding: var(--space-s) var(--default-padding);
    color: #ffffff;
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    background: var(--section-hero-bg);
  }

  .bio-column :global(p) {
    font-size: var(--fs-sm);
    line-height: 133%;
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
  }

  .bio-column :global(p + p) {
    margin-top: 1em;
  }

  .bio-label {
    font-size: var(--fs--3);
    font-weight: 700;
    text-transform: uppercase;
    opacity: 0.3;
    margin-bottom: var(--space-xs);
  }
</style>
