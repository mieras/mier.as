---
import { urlForImage } from '../../../sanity/lib/image';

type Project = {
  _id: string;
  title: string;
  slug?: string;
  year?: number;
  subtitle?: string;
  intro?: string;
  role?: string;
  thumbnail?: {
    image?: any;
    aspectRatio?: string;
  };
  client?: {
    title: string;
  };
};

type PhotographyItem = {
  _id: string;
  title: string;
  year?: number;
  city?: string;
  country?: string;
  camera?: string;
};

type Props = {
  project?: Project;
  photography?: PhotographyItem;
  type?: 'design' | 'photography';
  showThumbnail?: boolean;
};

const {
  project,
  photography,
  type = 'design',
  showThumbnail = false,
} = Astro.props;

// Determine which data to use
const item = type === 'photography' ? photography : project;
if (!item) return null;

const imageUrl = project?.thumbnail?.image?.asset
  ? urlForImage(project.thumbnail.image)?.width(1200).height(800).url()
  : null;

const year = item.year || null;
const title = item.title || '';

// For design projects
const client = project?.client?.title || '';
const role = project?.role || '';

// For photography
const city = photography?.city || '';
const country = photography?.country || '';
const location = [city, country].filter(Boolean).join(', ');
const camera = photography?.camera || '';

const dataId =
  type === 'photography'
    ? { 'data-photo-id': item._id }
    : { 'data-project-id': item._id, 'data-project-slug': project?.slug || '' };
---

<li class="work-item project-item" {...dataId}>
  {
    showThumbnail && imageUrl && (
      <div class="project-thumb project-thumb-mobile">
        <img src={imageUrl} alt={title || 'Project thumbnail'} loading="lazy" />
      </div>
    )
  }
  <div class="project-info">
    {year && <p class="project-year">{year}</p>}
    <div class="project-client">
      {
        type === 'design' ? (
          <>
            {client && <h3 class="project-client-title">{client}</h3>}
            {role && <h4 class="project-role">{role}</h4>}
          </>
        ) : (
          <>
            {location && <h3 class="project-client-title">{location}</h3>}
            {camera && <h4 class="project-role">{camera}</h4>}
          </>
        )
      }
    </div>
    <p class="project-name">{title}</p>
  </div>
  <div class="work-item__media"></div>
</li>

<style>
  .work-item {
    padding: var(--space-m);
    cursor: pointer;
    position: relative;
    transition:
      background 0.2s cubic-bezier(0.83, 0, 0.17, 1),
      border-radius 0.3s cubic-bezier(0.83, 0, 0.17, 1);
    border-radius: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    gap: var(--grid-gutter);
    align-items: baseline;
    justify-content: center;
    background: transparent;
  }

  .work-item:hover {
    background: var(--work-items-hover-bg);
  }

  .work-item.is-active {
    background: var(--work-items-active-bg);
    border-radius: 999px;
  }

  .project-item {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-s);
  }

  .project-thumb-mobile {
    width: 100%;
    overflow: hidden;
    grid-row: 1;
  }

  .project-thumb-mobile img {
    width: 100%;
    height: auto;
    object-fit: cover;
    opacity: 0.9;
    transition: opacity 0.3s ease;
    display: block;
  }

  .project-thumb-mobile:hover img {
    opacity: 1;
  }

  .project-info {
    display: flex;
    gap: var(--space-xs);
    align-items: baseline;
    flex: 1;
    min-width: 0;
  }

  /* Desktop: verberg mobile thumbnail en gebruik normale layout */
  @media (min-width: 48em) {
    .project-item {
      display: flex;
      gap: var(--grid-gutter);
      align-items: baseline;
    }

    .project-thumb-mobile {
      display: none;
    }

    .project-info {
      display: flex;
      gap: var(--space-xs);
      align-items: baseline;
      flex: 1;
    }
  }

  .project-year {
    font-family: var(--font-mono);
    font-size: var(--fs--3);
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
    color: var(--work-items-secondary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .project-client {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
    min-width: 0;
  }

  .project-client-title {
    font-family: var(--font-family-heading);
    font-size: var(--fs-0);
    font-weight: 700;
    line-height: 1;
    margin: 0;
    color: var(--work-items-text);
    letter-spacing: -0.48px;
  }

  .project-role {
    font-size: var(--fs--2);
    font-weight: 400;
    line-height: 1.2;
    color: var(--work-items-secondary);
    margin: 0;
  }

  .project-name {
    font-size: var(--fs--2);
    line-height: 1.2;
    font-weight: 400;
    margin: 0;
    color: var(--work-items-secondary);
    flex: 1;
    min-width: 0;
  }

  .work-item.is-active .project-name {
    color: var(--work-items-text);
  }

  .work-item__media {
    display: none;
    margin-top: 1rem;
    padding-top: 1rem;
  }

  /* Op desktop: media blijft altijd verborgen in work items */
  @media (min-width: 1200px) {
    .work-item__media {
      display: none !important;
    }
  }

  /* Op tablet/mobiel: toon media in actief work item */
  @media (max-width: 1199px) {
    .work-item,
    .work-item.is-active {
      border-radius: 1.5rem;
    }

    .work-item.is-active .work-item__media {
      display: block;
    }
  }
</style>
