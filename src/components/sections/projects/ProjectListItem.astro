---
import { urlForImage } from '../../../sanity/lib/image';

type Project = {
  _id: string;
  title: string;
  year?: number;
  subtitle?: string;
  intro?: string;
  role?: string;
  thumbnail?: {
    image?: any;
    aspectRatio?: string;
  };
  client?: {
    title: string;
  };
};

type PhotographyItem = {
  _id: string;
  title: string;
  year?: number;
  city?: string;
  country?: string;
  camera?: string;
};

type Props = {
  project?: Project;
  photography?: PhotographyItem;
  type?: 'design' | 'photography';
  showThumbnail?: boolean;
};

const {
  project,
  photography,
  type = 'design',
  showThumbnail = false,
} = Astro.props;

// Determine which data to use
const item = type === 'photography' ? photography : project;
if (!item) return null;

const imageUrl = project?.thumbnail?.image?.asset
  ? urlForImage(project.thumbnail.image)?.width(1200).height(800).url()
  : null;

const year = item.year || null;
const title = item.title || '';

// For design projects
const client = project?.client?.title || '';
const role = project?.role || '';

// For photography
const city = photography?.city || '';
const country = photography?.country || '';
const location = [city, country].filter(Boolean).join(', ');
const camera = photography?.camera || '';

const dataId =
  type === 'photography'
    ? { 'data-photo-id': item._id }
    : { 'data-project-id': item._id };
---

<li class="project-item" {...dataId}>
  {
    showThumbnail && imageUrl && (
      <div class="project-thumb project-thumb-mobile">
        <img src={imageUrl} alt={title || 'Project thumbnail'} loading="lazy" />
      </div>
    )
  }
  <div class="project-info">
    {year && <p class="project-year">{year}</p>}
    <div class="project-client">
      {
        type === 'design' ? (
          <>
            {client && <h3 class="project-client-title">{client}</h3>}
            {role && <h4 class="project-role">{role}</h4>}
          </>
        ) : (
          <>
            {location && <h3 class="project-client-title">{location}</h3>}
            {camera && <h4 class="project-role">{camera}</h4>}
          </>
        )
      }
    </div>
    <p class="project-name">{title}</p>
  </div>
</li>

<style>
  .project-item {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-s);
    padding: var(--space-s) var(--default-padding);
    border-top: 1px solid var(--border);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .project-thumb-mobile {
    width: 100%;
    overflow: hidden;
    grid-row: 1;
  }

  .project-thumb-mobile img {
    width: 100%;
    height: auto;
    object-fit: cover;
    opacity: 0.9;
    transition: opacity 0.3s ease;
    display: block;
  }

  .project-thumb-mobile:hover img {
    opacity: 1;
  }

  .project-info {
    grid-row: 2;
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    align-items: baseline;
    gap: var(--space-s);
  }

  /* Desktop: verberg mobile thumbnail en gebruik normale layout */
  @media (min-width: 48em) {
    .project-item {
      grid-template-columns: auto 1fr 1fr;
      grid-template-rows: auto;
    }

    .project-thumb-mobile {
      display: none;
    }

    .project-info {
      grid-row: auto;
      grid-column: 1 / -1;
      display: contents;
    }
  }

  .project-year {
    font-size: var(--fs--3);
    font-weight: 400;
    margin: 0;
  }

  .project-client {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .project-client-title {
    font-size: var(--fs-0);
    font-weight: 400;
    line-height: 112.5%;
    margin: 0;
  }

  .project-role {
    font-size: var(--fs--3);
    font-weight: 500;
    line-height: 112.5%;
    opacity: 0.5;
  }

  .project-name {
    font-size: var(--fs--1);
    line-height: 112.5%;
    font-weight: 400;
    margin: 0;
    opacity: 0.5;
  }
</style>
