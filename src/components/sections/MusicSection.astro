---
import RecentlyPlayed from './music/RecentlyPlayed.astro';
import Mixtapes from './music/Mixtapes.astro';
import LatestRecords from './music/LatestRecords.astro';
import TabGroup from '../ui/TabGroup.astro';
---

<TabGroup
  tabs={[
    { id: 'now-listening', label: 'Now listening' },
    { id: 'mixtapes', label: 'Mixtapes' },
    { id: 'collections', label: 'Collections' },
  ]}
  defaultTab="now-listening"
  sectionClass="music-section"
>
  <!-- Now Listening Tab -->
  <div class="tab-content tab-content-active" data-tab-content="now-listening">
    <RecentlyPlayed />
  </div>

  <!-- Mixtapes Tab -->
  <div class="tab-content" data-tab-content="mixtapes">
    <Mixtapes />
  </div>

  <!-- Collections Tab -->
  <div class="tab-content" data-tab-content="collections">
    <LatestRecords />
  </div>
</TabGroup>

<script>
  import {
    initSwiper,
    musicTickerPreset,
    mixtapesPreset,
  } from '../../lib/swiper-utils';

  // Re-initialize Swiper instances when tab changes
  // Note: Swiper initialization is now handled by individual components after data loads
  // This function serves as a backup and will only initialize if content is already loaded
  const handleTabChange = (event: CustomEvent) => {
    const { content } = event.detail;

    // Wait for content to be visible and check if data is already loaded
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        setTimeout(() => {
          // Only initialize if content-state is active (data has been loaded)
          const contentState = content.querySelector('[data-content="true"]');
          if (
            !contentState ||
            !content.classList.contains('tab-content-active')
          ) {
            return;
          }

          const latestRecordsSwiper = content.querySelector(
            '.latest-records-swiper',
          ) as HTMLElement;
          const recentlyPlayedSwiper = content.querySelector(
            '.recently-played-swiper',
          ) as HTMLElement;
          const mixtapesSwiper = content.querySelector(
            '.mixtapes-swiper',
          ) as HTMLElement;

          if (
            latestRecordsSwiper &&
            latestRecordsSwiper.querySelector('.swiper-wrapper')?.children
              .length
          ) {
            // Only initialize if not already initialized
            if (!(latestRecordsSwiper as any).swiper) {
              const swiper = initSwiper(
                latestRecordsSwiper,
                musicTickerPreset,
                true,
              );
              if (swiper) {
                requestAnimationFrame(() => {
                  swiper.update();
                  swiper.updateSize();
                });
              }
            }
          }

          if (
            recentlyPlayedSwiper &&
            recentlyPlayedSwiper.querySelector('.swiper-wrapper')?.children
              .length
          ) {
            if (!(recentlyPlayedSwiper as any).swiper) {
              const swiper = initSwiper(
                recentlyPlayedSwiper,
                musicTickerPreset,
                true,
              );
              if (swiper) {
                requestAnimationFrame(() => {
                  swiper.update();
                  swiper.updateSize();
                });
              }
            }
          }

          if (
            mixtapesSwiper &&
            mixtapesSwiper.querySelector('.swiper-wrapper')?.children.length
          ) {
            if (!(mixtapesSwiper as any).swiper) {
              const swiperInstance = initSwiper(
                mixtapesSwiper,
                mixtapesPreset,
                true,
              );
              if (swiperInstance && mixtapesSwiper) {
                (mixtapesSwiper as any).swiper = swiperInstance;
                requestAnimationFrame(() => {
                  swiperInstance.update();
                  swiperInstance.updateSize();
                });
              }
            }
          }
        }, 100);
      });
    });
  };

  // Initialize Swiper for the default active tab on load
  // Note: Components now handle their own Swiper initialization after data loads
  // This is kept as a backup for edge cases
  const initDefaultTabSwiper = () => {
    const activeTab = document.querySelector(
      '.music-section .tab-content.tab-content-active',
    );
    if (!activeTab) return;

    // Wait a bit longer to allow components to load data first
    setTimeout(() => {
      const contentState = activeTab.querySelector('[data-content="true"]');
      if (!contentState) return; // Data not loaded yet, component will handle it

      const latestRecordsSwiper = activeTab.querySelector(
        '.latest-records-swiper',
      ) as HTMLElement;
      const recentlyPlayedSwiper = activeTab.querySelector(
        '.recently-played-swiper',
      ) as HTMLElement;
      const mixtapesSwiper = activeTab.querySelector(
        '.mixtapes-swiper',
      ) as HTMLElement;

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (
            latestRecordsSwiper &&
            latestRecordsSwiper.querySelector('.swiper-wrapper')?.children
              .length &&
            !(latestRecordsSwiper as any).swiper
          ) {
            const swiper = initSwiper(
              latestRecordsSwiper,
              musicTickerPreset,
              true,
            );
            if (swiper) {
              requestAnimationFrame(() => {
                swiper.update();
                swiper.updateSize();
              });
            }
          }

          if (
            recentlyPlayedSwiper &&
            recentlyPlayedSwiper.querySelector('.swiper-wrapper')?.children
              .length &&
            !(recentlyPlayedSwiper as any).swiper
          ) {
            const swiper = initSwiper(
              recentlyPlayedSwiper,
              musicTickerPreset,
              true,
            );
            if (swiper) {
              requestAnimationFrame(() => {
                swiper.update();
                swiper.updateSize();
              });
            }
          }

          if (
            mixtapesSwiper &&
            mixtapesSwiper.querySelector('.swiper-wrapper')?.children.length &&
            !(mixtapesSwiper as any).swiper
          ) {
            const swiperInstance = initSwiper(
              mixtapesSwiper,
              mixtapesPreset,
              true,
            );
            if (swiperInstance && mixtapesSwiper) {
              (mixtapesSwiper as any).swiper = swiperInstance;
              requestAnimationFrame(() => {
                swiperInstance.update();
                swiperInstance.updateSize();
              });
            }
          }
        });
      });
    }, 200);
  };

  const initMusicSection = () => {
    const musicSection = document.querySelector('.music-section');
    if (!musicSection) return;

    musicSection.addEventListener(
      'tab-change',
      handleTabChange as EventListener,
    );

    // Initialize Swiper for default active tab
    initDefaultTabSwiper();
  };

  document.addEventListener('DOMContentLoaded', initMusicSection);
  document.addEventListener('astro:page-load', initMusicSection);
</script>

<style>
  .tab-content {
    display: none;
  }

  .tab-content.tab-content-active {
    display: block;
  }
</style>
