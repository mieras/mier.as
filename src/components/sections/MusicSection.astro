---
import ScrollMarquee from '../ui/ScrollMarquee.astro';
import RecentlyPlayed from './music/RecentlyPlayed.astro';
import Mixtapes from './music/Mixtapes.astro';
import LatestRecords from './music/LatestRecords.astro';
---

<section class="music" id="music" aria-label="Music">
  <ScrollMarquee
    word="Music"
    repeat={12}
    variant="light"
    direction="right"
    ariaLabel="Music section title"
  />

  <div class="music__grid" aria-label="Music grid">
    <section class="music__col" aria-label="Now listening">
      <header class="music__col-header">
        <h4 class="music__title">Now listening</h4>
      </header>
      <RecentlyPlayed />
    </section>

    <section class="music__col" aria-label="Collection">
      <header class="music__col-header">
        <h4 class="music__title">Collection</h4>
      </header>
      <LatestRecords />
    </section>

    <section class="music__col" aria-label="Mixtapes">
      <header class="music__col-header">
        <h4 class="music__title">Mixtapes</h4>
      </header>
      <Mixtapes />
    </section>
  </div>
</section>

<style>
  .music {
    background-color: var(--section-music-bg);
    color: var(--text-light);
    width: 100%;
  }

  .music__marquee {
    width: 100%;
    overflow: hidden;
  }

  .music__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: var(--space-s);
    gap: var(--space-s);
  }

  .music__col {
  }

  .music__col-header {
    margin-bottom: var(--space-s);
  }

  .music__title {
    font-size: var(--fs-0);
    font-weight: 600;
    opacity: 0.9;
    margin: 0;
    color: var(--text-light);
  }

  /* Mobile: altijd 1 kolom (nooit 2) */
  @media (max-width: 900px) {
    .music__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
