---
import RecentlyPlayed from './music/RecentlyPlayed.astro';
import Mixtapes from './music/Mixtapes.astro';
import LatestRecords from './music/LatestRecords.astro';
---

<section class="music-section">
  <div class="music-tabs">
    <button class="tab-button tab-active" data-tab="now-listening" aria-label="Show now listening">
      Now listening
    </button>
    <button class="tab-button" data-tab="mixtapes" aria-label="Show mixtapes">
      Mixtapes
    </button>
    <button class="tab-button" data-tab="collections" aria-label="Show collections">
      Collections
    </button>
  </div>

  <!-- Now Listening Tab -->
  <div class="tab-content tab-content-active" data-tab-content="now-listening">
    <RecentlyPlayed />
  </div>

  <!-- Mixtapes Tab -->
  <div class="tab-content" data-tab-content="mixtapes">
    <Mixtapes />
  </div>

  <!-- Collections Tab -->
  <div class="tab-content" data-tab-content="collections">
    <LatestRecords />
  </div>
</section>

<script>
  // Tab switching functionality - scoped to music section only
  document.addEventListener('DOMContentLoaded', () => {
    const musicSection = document.querySelector('.music-section');
    if (!musicSection) return;

    const tabButtons = musicSection.querySelectorAll('.music-tabs .tab-button');
    const tabContents = musicSection.querySelectorAll('.tab-content');

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetTab = button.getAttribute('data-tab');

        // Update active button (only within music section)
        tabButtons.forEach((btn) => {
          btn.classList.remove('tab-active');
        });
        button.classList.add('tab-active');

        // Update active content (only within music section)
        tabContents.forEach((content) => {
          content.classList.remove('tab-content-active');
          if (content.getAttribute('data-tab-content') === targetTab) {
            content.classList.add('tab-content-active');
            
            // Restart ticker animations when tab becomes visible
            const tickerTracks = content.querySelectorAll('.ticker-track');
            tickerTracks.forEach((track) => {
              const trackElement = track as HTMLElement;
              // Force reflow to restart animation
              trackElement.style.animation = 'none';
              void trackElement.offsetWidth; // Trigger reflow
              trackElement.style.animation = '';
            });
          }
        });
      });
    });
  });
</script>

<style>
  .music-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
  }

  .tab-button {
    background: transparent;
    border: none;
    padding: var(--space-xs) var(--space-m);
    font-size: var(--fs-0);
    font-weight: 400;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: all 0.2s ease;
  }

  .tab-button.tab-active {
    background-color: var(--text);
    color: var(--bg);
    border-bottom-color: var(--border);
  }

  .tab-content {
    display: none;
  }

  .tab-content.tab-content-active {
    display: block;
  }
</style>

