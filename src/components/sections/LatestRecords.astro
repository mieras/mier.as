---
import { getLatestRecords } from '../../lib/discogs';

const discogsUsername = import.meta.env.PUBLIC_DISCOGS_USERNAME || '';
const discogsToken = import.meta.env.PUBLIC_DISCOGS_TOKEN || '';

let latestRecords: any[] = [];

if (discogsUsername && discogsToken) {
  try {
    latestRecords = await getLatestRecords(discogsUsername, discogsToken, 5);
  } catch (error) {
    console.error('Error fetching Discogs data:', error);
  }
} else {
  console.warn(
    '⚠️ Discogs credentials not configured. Add PUBLIC_DISCOGS_USERNAME and PUBLIC_DISCOGS_TOKEN to .env',
  );
}

// Helper function to format relative time (similar to Last.fm)
function getRelativeTime(dateString?: string): string {
  if (!dateString) return '';
  
  try {
    const now = new Date();
    const addedDate = new Date(dateString);
    const diffMs = now.getTime() - addedDate.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);
    
    if (diffMins < 1) return 'zojuist toegevoegd';
    if (diffMins < 60) return `${diffMins} min geleden toegevoegd`;
    if (diffHours < 24) return `${diffHours} uur geleden toegevoegd`;
    if (diffDays === 1) return 'gisteren toegevoegd';
    if (diffDays < 7) return `${diffDays} dagen geleden toegevoegd`;
    if (diffDays < 30) {
      const weeks = Math.floor(diffDays / 7);
      return `${weeks} ${weeks === 1 ? 'week' : 'weken'} geleden toegevoegd`;
    }
    if (diffDays < 365) {
      const months = Math.floor(diffDays / 30);
      return `${months} ${months === 1 ? 'maand' : 'maanden'} geleden toegevoegd`;
    }
    const years = Math.floor(diffDays / 365);
    return `${years} ${years === 1 ? 'jaar' : 'jaren'} geleden toegevoegd`;
  } catch (error) {
    return '';
  }
}
---

<div class="latest-records">
  {latestRecords.length > 0 ? (
    <div class="ticker-container">
      <div class="ticker-wrapper">
        <div class="ticker-track" style="--speed: 25s">
          {latestRecords.map((record, index) => (
            <div class="ticker-item">
              {record.thumb && (
                <img 
                  src={record.thumb} 
                  alt={record.title}
                  class="record-thumb"
                  loading="lazy"
                />
              )}
              <div class="record-info">
                <span class="record-title">{record.title}</span>
                {record.artist && (
                  <span class="record-artist">{record.artist}</span>
                )}
                {record.year && (
                  <span class="record-year">{record.year}</span>
                )}
                {record.dateAdded && (
                  <span class="record-date">
                    {getRelativeTime(record.dateAdded)}
                  </span>
                )}
              </div>
            </div>
          ))}
          {/* Duplicate for seamless loop */}
          {latestRecords.map((record) => (
            <div class="ticker-item">
              {record.thumb && (
                <img 
                  src={record.thumb} 
                  alt={record.title}
                  class="record-thumb"
                  loading="lazy"
                />
              )}
              <div class="record-info">
                <span class="record-title">{record.title}</span>
                {record.artist && (
                  <span class="record-artist">{record.artist}</span>
                )}
                {record.year && (
                  <span class="record-year">{record.year}</span>
                )}
                {record.dateAdded && (
                  <span class="record-date">
                    {getRelativeTime(record.dateAdded)}
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  ) : (
    <p class="no-records">No recent records available</p>
  )}
</div>

<style>
  .latest-records {
    margin-bottom: var(--space-xl);
  }

  .ticker-container {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .ticker-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .ticker-track {
    display: flex;
    width: fit-content;
    animation: ticker-scroll var(--speed, 25s) linear infinite;
  }

  .ticker-track:hover {
    animation-play-state: paused;
  }

  @keyframes ticker-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ticker-item {
    flex-shrink: 0;
    padding-right: var(--space-l);
    display: flex;
    gap: var(--space-s);
    align-items: center;
    min-width: 20rem;
  }

  .record-thumb {
    width: 3rem;
    height: 3rem;
    object-fit: cover;
    background-color: var(--clr-thumb-bg);
    flex-shrink: 0;
    opacity: 0.9;
  }

  .record-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    flex: 1;
    min-width: 0;
  }

  .record-title {
    font-size: var(--fs-0);
    font-weight: 400;
    line-height: 1.3;
    color: var(--clr-text);
  }

  .record-artist {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-weight: 300;
    color: var(--clr-text);
  }

  .record-year {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-weight: 300;
    color: var(--clr-text);
  }

  .record-date {
    font-size: var(--fs--1);
    opacity: 0.6;
    font-weight: 300;
    margin-top: var(--space-2xs);
    color: var(--clr-text);
  }

  .no-records {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
    color: var(--clr-text);
  }
</style>

