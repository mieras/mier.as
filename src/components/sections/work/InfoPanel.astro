---
type ProjectData = {
  title?: string;
  hero?: {
    title?: string;
    subtitle?: string;
    intro?: string;
  };
  role?: string;
  year?: number;
  client?: {
    title?: string;
  };
};

type Props = {
  project?: ProjectData;
  photography?: {
    title?: string;
    hero?: {
      title?: string;
      subtitle?: string;
      intro?: string;
    };
    year?: number;
    city?: string;
    country?: string;
    camera?: string;
  };
  type?: 'project' | 'photography';
};

const { project, photography, type = 'project' } = Astro.props;

const data = type === 'project' ? project : photography;
const heroTitle = data?.hero?.title || data?.title || '';
const heroSubtitle = data?.hero?.subtitle || '';
const heroIntro = data?.hero?.intro || '';
const year = data?.year;
const client = type === 'project' ? project?.client?.title : null;
const role = type === 'project' ? project?.role : null;
const location =
  type === 'photography' && photography
    ? [photography.city, photography.country].filter(Boolean).join(', ')
    : null;
const camera = type === 'photography' ? photography?.camera : null;
---

<div class="info-panel" data-info-panel>
  <div class="info-panel__overlay" data-info-overlay></div>
  <div class="info-panel__content" data-info-content>
    <button
      class="info-panel__close"
      aria-label="Close info panel"
      type="button"
      data-info-close
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M18 6L6 18M6 6l12 12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="info-panel__body">
      {heroTitle && <h1 class="info-panel__title">{heroTitle}</h1>}
      {heroSubtitle && <h2 class="info-panel__subtitle">{heroSubtitle}</h2>}
      {heroIntro && <p class="info-panel__intro">{heroIntro}</p>}

      <dl class="info-panel__meta">
        {
          client && (
            <>
              <dt>Client</dt>
              <dd>{client}</dd>
            </>
          )
        }
        {
          role && (
            <>
              <dt>Role</dt>
              <dd>{role}</dd>
            </>
          )
        }
        {
          year && (
            <>
              <dt>Year</dt>
              <dd>{year}</dd>
            </>
          )
        }
        {
          location && (
            <>
              <dt>Location</dt>
              <dd>{location}</dd>
            </>
          )
        }
        {
          camera && (
            <>
              <dt>Camera</dt>
              <dd>{camera}</dd>
            </>
          )
        }
      </dl>
    </div>
  </div>
</div>

<button
  class="info-panel__toggle"
  aria-label="Show project information"
  type="button"
  data-info-toggle
>
  <svg
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M12 22c5.421 0 10-4.579 10-10S17.421 2 12 2 2 6.579 2 12s4.579 10 10 10z"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M12 16v-4M12 8h.01"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  function initInfoPanel() {
    // Find panel within work preview container (for dynamically loaded panels)
    const workPreview = document.querySelector('.work__preview');
    const scope = workPreview || document;

    const panel = scope.querySelector('[data-info-panel]') as HTMLElement;
    const overlay = scope.querySelector('[data-info-overlay]') as HTMLElement;
    const content = scope.querySelector('[data-info-content]') as HTMLElement;
    const toggle = scope.querySelector('[data-info-toggle]') as HTMLElement;
    const close = scope.querySelector('[data-info-close]') as HTMLElement;

    if (!panel || !overlay || !content || !toggle || !close) return;

    // Remove existing listeners to prevent duplicates by cloning nodes
    const newToggle = toggle.cloneNode(true) as HTMLElement;
    toggle.parentNode?.replaceChild(newToggle, toggle);
    const newClose = close.cloneNode(true) as HTMLElement;
    close.parentNode?.replaceChild(newClose, close);

    function openPanel() {
      panel.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      // Hide info toggle, show close button
      if (newToggle) {
        newToggle.style.display = 'none';
      }
      if (newClose) {
        newClose.style.display = 'flex';
      }
    }

    function closePanel() {
      panel.classList.remove('is-open');
      document.body.style.overflow = '';
      // Show info toggle, hide close button
      if (newToggle) {
        newToggle.style.display = 'flex';
      }
      if (newClose) {
        newClose.style.display = 'none';
      }
    }

    // Initialize: hide close button, show toggle
    if (newClose) {
      newClose.style.display = 'none';
    }
    if (newToggle) {
      newToggle.style.display = 'flex';
    }

    newToggle.addEventListener('click', openPanel);
    newClose.addEventListener('click', closePanel);
    overlay.addEventListener('click', closePanel);

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        closePanel();
      }
    });
  }

  document.addEventListener('astro:page-load', initInfoPanel);
  if (document.readyState !== 'loading') {
    initInfoPanel();
  }
</script>

<style>
  .info-panel {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .info-panel.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .info-panel__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .info-panel.is-open .info-panel__overlay {
    opacity: 1;
  }

  .info-panel__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--section-work-bg, #fff);
    max-height: 80vh;
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: var(--space-m);
    padding-top: var(--space-l);
  }

  .info-panel.is-open .info-panel__content {
    transform: translateY(0);
  }

  .info-panel__close {
    position: absolute;
    bottom: var(--space-m);
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(30px);
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    cursor: pointer;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease,
      background-color 0.2s,
      color 0.2s;
    z-index: 60;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .info-panel.is-open .info-panel__close {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .info-panel__close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .info-panel__close:hover {
    opacity: 0.7;
  }

  .info-panel__close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .info-panel__body {
    max-width: 60ch;
    margin: 0 auto;
  }

  .info-panel__title {
    font-size: var(--fs-4);
    font-weight: 600;
    margin: 0 0 var(--space-s) 0;
    line-height: 1.2;
  }

  .info-panel__subtitle {
    font-size: var(--fs-2);
    font-weight: 400;
    margin: 0 0 var(--space-xs) 0;
    opacity: 0.8;
    line-height: 1.3;
  }

  .info-panel__intro {
    font-size: var(--fs-0);
    margin: 0 0 var(--space-m) 0;
    line-height: 1.6;
    opacity: 0.9;
  }

  .info-panel__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs) var(--space-s);
    margin: var(--space-m) 0 0 0;
    padding: 0;
  }

  .info-panel__meta dt {
    font-weight: 600;
    font-size: var(--fs--1);
    opacity: 0.7;
  }

  .info-panel__meta dd {
    margin: 0;
    font-size: var(--fs--1);
  }

  .info-panel__toggle {
    position: absolute;
    bottom: var(--space-m);
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(30px);
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #fff;
    transition:
      background-color 0.2s,
      color 0.2s,
      opacity 0.2s,
      visibility 0.2s;
    padding: 0;
  }

  .info-panel.is-open .info-panel__toggle {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .info-panel__toggle:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .info-panel__toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .info-panel__toggle svg {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 768px) {
    .info-panel__content {
      max-height: 90vh;
      padding: var(--space-s);
      padding-top: var(--space-m);
    }

    .info-panel__body {
      max-width: 100%;
    }
  }
</style>
