---
import { urlForImage } from '../../../sanity/lib/image';
import { PortableText } from 'astro-portabletext';

type Project = {
  _id: string;
  projectTitle?: string;
  title?: string; // Fallback for old data
  slug?: string;
  description?: any[];
  preview?: {
    image?: any;
  };
};

type Props = {
  project?: Project;
};

const { project } = Astro.props;

const coverImageUrl = project?.preview?.image?.asset
  ? urlForImage(project.preview.image)?.width(1920).height(1080).url()
  : null;

// PortableText components for description
const descriptionComponents = {
  types: {},
  marks: {
    strong: ({ children }: any) => <strong>{children}</strong>,
    em: ({ children }: any) => <em>{children}</em>,
  },
  block: {
    normal: ({ children }: any) => <p>{children}</p>,
  },
  list: {},
  listItem: {},
};
---

<div
  class="work__detail"
  data-detail
  role="region"
  aria-label={`Project detail: ${project?.projectTitle || project?.title || ''}`}
  aria-live="polite"
>
  {
    coverImageUrl && (
      <div class="work__detail-hero">
        <img
          src={coverImageUrl}
          alt={project?.projectTitle || project?.title || 'Project hero image'}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  {
    project?.description && project.description.length > 0 && (
      <div class="work__detail-content">
        <PortableText
          value={project.description}
          components={descriptionComponents}
        />
      </div>
    )
  }
</div>

<style>
  .work__detail {
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    background: var(--section-work-bg);
  }

  .work__detail-hero {
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .work__detail-hero img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .work__detail-content {
    padding: var(--space-m);
  }

  .work__detail-content :global(p) {
    margin-bottom: var(--space-m);
    line-height: 1.6;
  }

  .work__detail-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .work__detail-content :global(strong) {
    font-weight: 600;
  }

  .work__detail-content :global(em) {
    font-style: italic;
  }
</style>
