---
import { urlForImage } from '../../../sanity/lib/image';

type Props = {
  imageUrl?: string;
  defaultImage?: string;
};

const { imageUrl, defaultImage } = Astro.props;
const displayImage = imageUrl || defaultImage || '';
---

<div
  class="work__preview"
  data-preview
  role="region"
  aria-label="Project preview"
>
  {
    displayImage && (
      <img
        class="work__preview-img"
        src={displayImage}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )
  }
</div>

<style>
  .work__preview {
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: var(--work-items-hover-bg);
  }

  .work__preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1;
    transition: opacity 0.18s ease;
  }

  .work__preview.is-fading .work__preview-img {
    opacity: 0;
  }
</style>
