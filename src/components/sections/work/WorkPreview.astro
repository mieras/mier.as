---
type Props = {
  imageUrl?: string;
  defaultImage?: string;
};

const { imageUrl, defaultImage } = Astro.props;
const displayImage = imageUrl || defaultImage || '';
---

<div class="work__preview" data-preview role="region" aria-label="Work preview">
  {
    displayImage && (
      <img
        class="work__preview-img"
        src={displayImage}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )
  }
  <!-- Video will be dynamically inserted by WorkController -->
</div>

<style>
  .work__preview {
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: #fff;
    position: relative;
  }

  /* When carousel is loaded, ensure it fills */
  .work__preview .work-carousel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .work__preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1;
    transition: opacity 0.18s ease;
  }

  .work__preview.is-fading .work__preview-img {
    opacity: 0;
  }

  .work__preview-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1;
    transition: opacity 0.18s ease;
  }

  .work__preview.is-fading .work__preview-video {
    opacity: 0;
  }
</style>
