---
import WorkPreview from './WorkPreview.astro';
import ProjectCarousel from './ProjectCarousel.astro';
import InfoPanel from './InfoPanel.astro';

type Props = {
  mode?: 'preview' | 'detail';
  previewImage?: string;
  defaultImage?: string;
  projectSlug?: string;
  projectType?: 'project' | 'photography';
};

const {
  mode = 'preview',
  previewImage,
  defaultImage,
  projectSlug,
  projectType = 'project',
} = Astro.props;
---

<aside
  class="work__right"
  aria-label="Preview panel"
  data-mode={mode}
  data-project-slug={projectSlug || ''}
  data-project-type={projectType}
>
  <WorkPreview imageUrl={previewImage} defaultImage={defaultImage} />
  <div
    class="work__detail-container"
    data-detail-container
    style="display: none;"
  >
    <!-- Carousel and info panel will be loaded dynamically via client script -->
  </div>
</aside>

<style>
  .work__right {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100%;
    min-height: 0;
  }

  .work__detail-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    background: var(--section-work-bg);
  }

  .work__detail {
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: var(--section-work-bg);
    position: relative;
  }

  .work__detail-hero {
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .work__detail-hero img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .work__detail-content {
    padding: var(--space-m);
  }

  .work__detail-note {
    font-size: var(--fs--2);
    color: var(--work-items-secondary);
    margin: 0;
  }

  .work__detail-error {
    padding: var(--space-m);
    text-align: center;
    color: var(--work-items-secondary);
  }

  /* Project Carousel Styles */
  .project-carousel {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .project-carousel__swiper {
    width: 100%;
    height: 100%;
  }

  .project-carousel__swiper .swiper-wrapper {
    width: 100%;
    height: 100%;
  }

  .project-carousel__swiper .swiper-slide {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .project-carousel__image-wrapper,
  .project-carousel__video-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .project-carousel__image,
  .project-carousel__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-carousel__controls {
    position: absolute;
    bottom: var(--space-m);
    right: var(--space-m);
    z-index: 10;
    display: flex;
    gap: var(--space-xs);
    align-items: center;
  }

  .project-carousel__button {
    backdrop-filter: blur(30px);
    color: #fff;
    background-color: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
    padding: 0;
  }

  .project-carousel__button:hover {
    color: #000;
    background-color: #fff;
  }

  .project-carousel__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .project-carousel__button svg {
    width: 24px;
    height: 24px;
  }

  .project-carousel__button--prev svg {
    transform: rotate(180deg);
  }

  .project-carousel__empty {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary, rgba(255, 255, 255, 0.6));
  }

  /* Info Panel Styles */
  .info-panel {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .info-panel.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .info-panel__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .info-panel.is-open .info-panel__overlay {
    opacity: 1;
  }

  .info-panel__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--section-work-bg, #fff);
    max-height: 80vh;
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: var(--space-m);
    padding-top: var(--space-l);
  }

  .info-panel.is-open .info-panel__content {
    transform: translateY(0);
  }

  .info-panel__close {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    background: none;
    border: none;
    padding: var(--space-xs);
    cursor: pointer;
    color: currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .info-panel__close:hover {
    opacity: 0.7;
  }

  .info-panel__close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .info-panel__body {
    max-width: 60ch;
    margin: 0 auto;
  }

  .info-panel__title {
    font-size: var(--fs-4);
    font-weight: 600;
    margin: 0 0 var(--space-s) 0;
    line-height: 1.2;
  }

  .info-panel__subtitle {
    font-size: var(--fs-2);
    font-weight: 400;
    margin: 0 0 var(--space-xs) 0;
    opacity: 0.8;
    line-height: 1.3;
  }

  .info-panel__intro {
    font-size: var(--fs-0);
    margin: 0 0 var(--space-m) 0;
    line-height: 1.6;
    opacity: 0.9;
  }

  .info-panel__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs) var(--space-s);
    margin: var(--space-m) 0 0 0;
    padding: 0;
  }

  .info-panel__meta dt {
    font-weight: 600;
    font-size: var(--fs--1);
    opacity: 0.7;
  }

  .info-panel__meta dd {
    margin: 0;
    font-size: var(--fs--1);
  }

  .info-panel__toggle {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    z-index: 40;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(30px);
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #fff;
    transition:
      background-color 0.2s,
      color 0.2s;
    padding: 0;
  }

  .info-panel__toggle:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .info-panel__toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .info-panel__toggle svg {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 768px) {
    .info-panel__content {
      max-height: 90vh;
      padding: var(--space-s);
      padding-top: var(--space-m);
    }

    .info-panel__body {
      max-width: 100%;
    }
  }

  .work__right[data-mode='detail'] .work__preview {
    display: none;
  }

  .work__right[data-mode='detail'] .work__detail-container {
    display: block;
  }

  @media (max-width: 899px) {
    .work__right {
      position: relative;
      height: auto;
      min-height: 50vh;
    }

    .work__detail-container {
      position: relative;
    }
  }
</style>

<script>
  // Function to load project media
  function loadProjectMedia(
    mode: string,
    slug: string | undefined,
    projectType: string,
  ) {
    if (!slug) return;

    const panel = document.querySelector('.work__right') as HTMLElement;
    const detailContainer = panel?.querySelector(
      '[data-detail-container]',
    ) as HTMLElement;

    if (!panel || !detailContainer) return;

    if (mode === 'detail' && slug) {
      const apiUrl =
        projectType === 'photography'
          ? `/api/photography/${slug}.json`
          : `/api/work/${slug}.json`;

      // Fetch project/photography detail data
      fetch(apiUrl)
        .then((res) => {
          if (!res.ok)
            throw new Error(`Failed to load ${projectType}: ${res.status}`);
          return res.json();
        })
        .then((data) => {
          if (data && detailContainer) {
            // Build carousel HTML
            const projectMedia = data.projectMedia || [];
            const slidesHtml = projectMedia
              .map((slide: any) => {
                if (slide._type === 'videoSlide' && slide.video?.url) {
                  return `
                    <div class="swiper-slide" role="listitem" data-slide-key="${slide._key || ''}">
                      <div class="project-carousel__video-wrapper">
                        <video
                          class="project-carousel__video"
                          src="${slide.video.url}"
                          playsinline
                          loop
                          muted
                          autoplay
                          preload="metadata"
                        />
                      </div>
                    </div>
                  `;
                } else if (slide._type === 'imageSlide' && slide.image?.url) {
                  return `
                    <div class="swiper-slide" role="listitem" data-slide-key="${slide._key || ''}">
                      <div class="project-carousel__image-wrapper">
                        <img
                          src="${slide.image.url}"
                          alt="${slide.image.alt || ''}"
                          class="project-carousel__image"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                  `;
                }
                return '';
              })
              .filter(Boolean)
              .join('');

            const carouselHtml =
              projectMedia.length > 0
                ? `
                <div class="project-carousel" data-project-id="${data._id || ''}">
                  <div class="project-carousel__swiper swiper">
                    <div class="swiper-wrapper" role="list">
                      ${slidesHtml}
                    </div>
                    ${
                      projectMedia.length > 1
                        ? `
                      <div class="project-carousel__controls">
                        <button
                          class="project-carousel__button project-carousel__button--prev"
                          aria-label="Previous slide"
                          type="button"
                        >
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 12h14m0 0-7-7m7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                        <button
                          class="project-carousel__button project-carousel__button--next"
                          aria-label="Next slide"
                          type="button"
                        >
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 12h14m0 0-7-7m7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>
                      </div>
                    `
                        : ''
                    }
                  </div>
                </div>
              `
                : `
                <div class="project-carousel__empty">
                  <p>No media available</p>
                </div>
              `;

            // Build info panel HTML
            const heroTitle = data.hero?.title || data.title || '';
            const heroSubtitle = data.hero?.subtitle || '';
            const heroIntro = data.hero?.intro || '';
            const year = data.year;
            const client =
              projectType === 'project' ? data.client?.title : null;
            const role = projectType === 'project' ? data.role : null;
            const location =
              projectType === 'photography' && data.city && data.country
                ? `${data.city}, ${data.country}`
                : null;
            const camera = projectType === 'photography' ? data.camera : null;

            const infoPanelHtml = `
                <div class="info-panel" data-info-panel>
                  <div class="info-panel__overlay" data-info-overlay></div>
                  <div class="info-panel__content" data-info-content>
                    <button class="info-panel__close" aria-label="Close info panel" type="button" data-info-close>
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div class="info-panel__body">
                      ${heroTitle ? `<h1 class="info-panel__title">${heroTitle}</h1>` : ''}
                      ${heroSubtitle ? `<h2 class="info-panel__subtitle">${heroSubtitle}</h2>` : ''}
                      ${heroIntro ? `<p class="info-panel__intro">${heroIntro}</p>` : ''}
                      <dl class="info-panel__meta">
                        ${client ? `<dt>Client</dt><dd>${client}</dd>` : ''}
                        ${role ? `<dt>Role</dt><dd>${role}</dd>` : ''}
                        ${year ? `<dt>Year</dt><dd>${year}</dd>` : ''}
                        ${location ? `<dt>Location</dt><dd>${location}</dd>` : ''}
                        ${camera ? `<dt>Camera</dt><dd>${camera}</dd>` : ''}
                      </dl>
                    </div>
                  </div>
                </div>
                <button class="info-panel__toggle" aria-label="Show project information" type="button" data-info-toggle>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 22c5.421 0 10-4.579 10-10S17.421 2 12 2 2 6.579 2 12s4.579 10 10 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 16v-4M12 8h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              `;

            detailContainer.innerHTML = `
                <div class="work__detail" data-detail role="region" aria-label="${projectType === 'project' ? 'Project' : 'Photography'} detail: ${data.title || ''}" aria-live="polite">
                  ${carouselHtml}
                  ${infoPanelHtml}
                </div>
              `;

            // Initialize carousel
            if (projectMedia.length > 0) {
              import('swiper').then(({ default: Swiper }) => {
                import('swiper/modules').then(({ Navigation }) => {
                  const swiperEl = detailContainer.querySelector(
                    '.project-carousel__swiper',
                  ) as HTMLElement;
                  const prevButton = detailContainer.querySelector(
                    '.project-carousel__button--prev',
                  ) as HTMLElement;
                  const nextButton = detailContainer.querySelector(
                    '.project-carousel__button--next',
                  ) as HTMLElement;

                  if (swiperEl && projectMedia.length > 1) {
                    new Swiper(swiperEl, {
                      modules: [Navigation],
                      navigation: {
                        nextEl: nextButton,
                        prevEl: prevButton,
                      },
                      loop: false,
                      speed: 600,
                      keyboard: {
                        enabled: true,
                      },
                    });
                  }
                });
              });
            }

            // Initialize info panel
            const infoPanel = detailContainer.querySelector(
              '[data-info-panel]',
            ) as HTMLElement;
            const infoOverlay = detailContainer.querySelector(
              '[data-info-overlay]',
            ) as HTMLElement;
            const infoContent = detailContainer.querySelector(
              '[data-info-content]',
            ) as HTMLElement;
            const infoToggle = detailContainer.querySelector(
              '[data-info-toggle]',
            ) as HTMLElement;
            const infoClose = detailContainer.querySelector(
              '[data-info-close]',
            ) as HTMLElement;

            if (
              infoPanel &&
              infoOverlay &&
              infoContent &&
              infoToggle &&
              infoClose
            ) {
              function openInfoPanel() {
                infoPanel.classList.add('is-open');
                document.body.style.overflow = 'hidden';
              }

              function closeInfoPanel() {
                infoPanel.classList.remove('is-open');
                document.body.style.overflow = '';
              }

              infoToggle.addEventListener('click', openInfoPanel);
              infoClose.addEventListener('click', closeInfoPanel);
              infoOverlay.addEventListener('click', closeInfoPanel);

              document.addEventListener('keydown', (e) => {
                if (
                  e.key === 'Escape' &&
                  infoPanel.classList.contains('is-open')
                ) {
                  closeInfoPanel();
                }
              });
            }
          }
        })
        .catch((err) => {
          console.error(`Failed to load ${projectType} detail:`, err);
          if (detailContainer) {
            detailContainer.innerHTML = `
                <div class="work__detail-error">
                  <p>Failed to load ${projectType} details.</p>
                </div>
              `;
          }
        });
    } else {
      // Clear detail content
      if (detailContainer) {
        detailContainer.innerHTML = '';
      }
    }
  }

  // Handle panel mode switching
  const workSection = document.querySelector('#work');
  if (workSection) {
    workSection.addEventListener('work-panel-mode-change', (e: Event) => {
      const customEvent = e as CustomEvent;
      const { mode, slug, type } = customEvent.detail;
      const projectType = type || 'project';
      loadProjectMedia(mode, slug, projectType);
    });
  }

  // Also listen for astro:page-load to handle View Transitions
  document.addEventListener('astro:page-load', () => {
    // Check if we're on a work/photography detail page
    const path = window.location.pathname;
    const workMatch = path.match(/^\/work\/([^/]+)$/);
    const photoMatch = path.match(/^\/photography\/([^/]+)$/);

    if (workMatch || photoMatch) {
      const slug = workMatch?.[1] || photoMatch?.[1];
      const projectType = workMatch ? 'project' : 'photography';

      // Wait a bit for workController to initialize
      setTimeout(() => {
        loadProjectMedia('detail', slug, projectType);
      }, 100);
    }
  });
</script>
