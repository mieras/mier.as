---
import WorkPreview from './WorkPreview.astro';
import WorkCarousel from './WorkCarousel.astro';
import InfoPanel from './InfoPanel.astro';

type Props = {
  mode?: 'preview' | 'detail';
  previewImage?: string;
  defaultImage?: string;
  projectSlug?: string;
  projectType?: 'project' | 'photography';
  initialProjectSlug?: string | null;
};

const {
  mode = 'preview',
  previewImage,
  defaultImage,
  projectSlug,
  projectType = 'project',
  initialProjectSlug = null,
} = Astro.props;
---

<aside
  class="work__right"
  aria-label="Preview panel"
  data-mode={mode}
  data-work-slug={projectSlug || initialProjectSlug || ''}
  data-work-type={projectType}
  data-default-image={defaultImage || ''}
  data-initial-work-slug={initialProjectSlug || ''}
>
  <WorkPreview imageUrl={previewImage} defaultImage={defaultImage} />
  <div
    class="work__detail-container"
    data-detail-container
    style="display: none;"
  >
    <!-- Carousel and info panel will be loaded dynamically via client script -->
  </div>
</aside>

<style>
  .work__right {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100%;
    min-height: 0;
  }

  .work__detail-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    background: var(--section-work-bg);
  }

  .work__detail {
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: var(--section-work-bg);
    position: relative;
  }

  .work__detail-hero {
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .work__detail-hero img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .work__detail-content {
    padding: var(--space-m);
  }

  .work__detail-note {
    font-size: var(--fs--2);
    color: var(--work-items-secondary);
    margin: 0;
  }

  .work__detail-error {
    padding: var(--space-m);
    text-align: center;
    color: var(--work-items-secondary);
  }

  /* Work Carousel Styles */
  .work-carousel {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .work-carousel__swiper {
    width: 100% !important;
    height: 100% !important;
    flex: 1;
    min-height: 0;
  }

  .work-carousel__swiper .swiper-wrapper {
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: stretch;
  }

  .work-carousel__swiper .swiper-slide {
    width: 100% !important;
    height: 100% !important;
    min-width: 0 !important;
    min-height: 100% !important;
    max-width: 100% !important;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    box-sizing: border-box;
  }

  .work-carousel__image-wrapper,
  .work-carousel__video-wrapper {
    width: 100% !important;
    height: 100% !important;
    position: relative;
    flex: 1;
    min-width: 0;
    min-height: 0;
  }

  .work-carousel__image,
  .work-carousel__video {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    display: block;
    flex: 1;
  }

  .work-carousel__controls {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    display: flex;
    gap: var(--space-m);
    align-items: center;
    width: 100%;
    max-width: 1200px;
    justify-content: space-between;
    pointer-events: none;
  }

  .work-carousel__button {
    backdrop-filter: blur(30px);
    color: #fff;
    background-color: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
    padding: 0;
    pointer-events: auto;
  }

  .work-carousel__button:hover {
    color: #000;
    background-color: #fff;
  }

  .work-carousel__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .work-carousel__button svg {
    width: 24px;
    height: 24px;
  }

  .work-carousel__button--prev {
    margin-right: auto;
  }

  .work-carousel__button--prev svg {
    transform: rotate(180deg);
  }

  .work-carousel__button--next {
    margin-left: auto;
  }

  .work-carousel__info-toggle {
    position: absolute;
    bottom: var(--space-m);
    left: 50%;
    transform: translateX(-50%);
    z-index: 30;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(30px);
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #fff;
    transition:
      background-color 0.2s,
      color 0.2s;
    padding: 0;
  }

  .work-carousel__info-toggle:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .work-carousel__info-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .work-carousel__info-toggle svg {
    width: 24px;
    height: 24px;
  }

  .work-carousel__empty {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary, rgba(255, 255, 255, 0.6));
  }

  /* Info Panel Styles */
  .info-panel {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .info-panel.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .info-panel__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .info-panel.is-open .info-panel__overlay {
    opacity: 1;
  }

  .info-panel__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--section-work-bg, #fff);
    max-height: 80vh;
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: var(--space-m);
    padding-top: var(--space-l);
  }

  .info-panel.is-open .info-panel__content {
    transform: translateY(0);
  }

  .info-panel__close {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    background: none;
    border: none;
    padding: var(--space-xs);
    cursor: pointer;
    color: currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .info-panel__close:hover {
    opacity: 0.7;
  }

  .info-panel__close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .info-panel__body {
    max-width: 60ch;
    margin: 0 auto;
  }

  .info-panel__title {
    font-size: var(--fs-4);
    font-weight: 600;
    margin: 0 0 var(--space-s) 0;
    line-height: 1.2;
  }

  .info-panel__subtitle {
    font-size: var(--fs-2);
    font-weight: 400;
    margin: 0 0 var(--space-xs) 0;
    opacity: 0.8;
    line-height: 1.3;
  }

  .info-panel__intro {
    font-size: var(--fs-0);
    margin: 0 0 var(--space-m) 0;
    line-height: 1.6;
    opacity: 0.9;
  }

  .info-panel__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs) var(--space-s);
    margin: var(--space-m) 0 0 0;
    padding: 0;
  }

  .info-panel__meta dt {
    font-weight: 600;
    font-size: var(--fs--1);
    opacity: 0.7;
  }

  .info-panel__meta dd {
    margin: 0;
    font-size: var(--fs--1);
  }

  .info-panel__toggle {
    position: absolute;
    bottom: var(--space-m);
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(30px);
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #fff;
    transition:
      background-color 0.2s,
      color 0.2s;
    padding: 0;
  }

  .info-panel__toggle:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .info-panel__toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .info-panel__toggle svg {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 768px) {
    .info-panel__content {
      max-height: 90vh;
      padding: var(--space-s);
      padding-top: var(--space-m);
    }

    .info-panel__body {
      max-width: 100%;
    }
  }

  .work__right[data-mode='detail'] .work__preview {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .work__right[data-mode='detail'] .work__detail-container {
    display: none;
  }

  /* Tablet: adjust panel */
  @media (max-width: 1024px) and (min-width: 768px) {
    .work__right {
      position: relative;
      height: auto;
      min-height: 60vh;
    }

    .work__detail-container {
      position: relative;
    }

    .work-carousel__controls {
      gap: var(--space-s);
    }
  }

  /* Mobile: full width panel */
  @media (max-width: 767px) {
    .work__right {
      position: relative;
      height: auto;
      min-height: 50vh;
    }

    .work__detail-container {
      position: relative;
    }

    .work-carousel__controls {
      gap: var(--space-xs);
      max-width: 100%;
      padding: 0 var(--space-s);
    }

    .work-carousel__button {
      width: 2rem;
      height: 2rem;
    }

    .work-carousel__button svg {
      width: 20px;
      height: 20px;
    }

    .work-carousel__info-toggle {
      width: 2rem;
      height: 2rem;
      bottom: var(--space-s);
    }

    .work-carousel__info-toggle svg {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script>
  // @ts-nocheck
  import { urlForImage } from '../../../sanity/lib/image';

  // Store Swiper instance for cleanup
  let currentSwiper = null;

  // Function to load work media
  /**
   * @param {string} mode
   * @param {string|undefined} slug
   * @param {string} projectType
   * @returns {void}
   */
  function loadWorkMedia(mode, slug, projectType) {
    if (import.meta.env.DEV) {
      console.log('🔄 loadWorkMedia called:', { mode, slug, projectType });
    }

    if (!slug) {
      if (import.meta.env.DEV) {
        console.warn('⚠️ loadWorkMedia: No slug provided');
      }
      return;
    }

    const panel = document.querySelector('.work__right');
    const previewContainer = panel?.querySelector('.work__preview');

    if (!panel || !previewContainer) {
      if (import.meta.env.DEV) {
        console.warn('⚠️ loadWorkMedia: Panel or preview container not found', {
          hasPanel: !!panel,
          hasPreviewContainer: !!previewContainer,
        });
      }
      return;
    }

    if (mode === 'detail' && slug) {
      // Cleanup existing Swiper instance
      if (currentSwiper) {
        try {
          /** @type {any} */
          const swiper = currentSwiper;
          swiper.destroy(true, true);
          currentSwiper = null;
        } catch (e) {
          console.warn('Error destroying Swiper:', e);
        }
      }

      const apiUrl =
        projectType === 'photography'
          ? `/api/photography/${slug}.json`
          : `/api/project.json?slug=${encodeURIComponent(slug)}`;

      if (import.meta.env.DEV) {
        console.log('📡 Fetching project data from:', apiUrl);
      }

      // Fetch project/photography detail data
      if (import.meta.env.DEV) {
        console.log('📡 Starting fetch to:', apiUrl);
      }

      fetch(apiUrl)
        .then((res) => {
          if (import.meta.env.DEV) {
            console.log('📥 Fetch response:', {
              status: res.status,
              statusText: res.statusText,
              ok: res.ok,
              url: res.url,
            });
          }

          if (!res.ok) {
            throw new Error(
              `Failed to load ${projectType}: ${res.status} ${res.statusText}`,
            );
          }
          return res.json();
        })
        .then((data) => {
          if (import.meta.env.DEV) {
            console.log('✅ Project data loaded:', {
              title: data?.title,
              _id: data?._id,
              mediaCount: data?.projectMedia?.length || 0,
              hasProjectMedia: !!data?.projectMedia,
              projectMedia: data?.projectMedia,
              fullData: data,
            });
          }

          if (!data) {
            throw new Error('No data returned from API');
          }

          renderWorkData(data, previewContainer, projectType);
        })
        .catch((error) => {
          console.error('❌ Failed to load project:', error);
          if (previewContainer) {
            previewContainer.innerHTML = `
              <div class="work__detail-error">
                <p>Failed to load project details.</p>
                ${import.meta.env.DEV ? `<p style="font-size: 0.75rem; opacity: 0.7; margin-top: 0.5rem;">Error: ${error?.message || 'Unknown error'}</p>` : ''}
              </div>
            `;
          }
        });
    }
  }

  /**
   * Render work data into the preview container
   * @param {object} data - Work data
   * @param {HTMLElement} previewContainer - Container to render into
   * @param {string} projectType - Type of work ('project' or 'photography')
   */
  function renderWorkData(data, previewContainer, projectType = 'project') {
    if (data && previewContainer) {
      // Build carousel HTML
      const projectMedia = data.projectMedia || [];
      const slidesHtml = projectMedia
        .map((slide: any) => {
          // Process image slides
          if (slide._type === 'imageSlide' && slide.image?.asset) {
            try {
              const imageUrl =
                urlForImage(slide.image)?.width(1920).height(1080).url() || '';
              const imageAlt = slide.image.alt || '';

              if (!imageUrl) {
                return '';
              }

              return `
                <div class="swiper-slide" role="listitem" data-slide-key="${slide._key || ''}">
                  <div class="work-carousel__image-wrapper">
                    <img
                      src="${imageUrl}"
                      alt="${imageAlt}"
                      class="work-carousel__image"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              `;
            } catch (error) {
              if (import.meta.env.DEV) {
                console.warn('⚠️ Failed to generate image URL:', error);
              }
              return '';
            }
          }

          // Process video slides
          if (slide._type === 'videoSlide' && slide.video?.asset) {
            const videoAsset = slide.video.asset;
            let videoUrl = null;

            // Check if direct URL is available
            if (videoAsset.url) {
              videoUrl = videoAsset.url;
            } else if (videoAsset._ref) {
              // Construct URL from asset reference
              // Example: "file-4b92641f60b9d28cb7544bb7f5a1e53a0085aab1-mp4"
              const assetId = videoAsset._ref
                .replace('file-', '')
                .replace('-mp4', '');
              const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
              const dataset = import.meta.env.PUBLIC_SANITY_DATASET;
              videoUrl = `https://cdn.sanity.io/files/${projectId}/${dataset}/${assetId}.mp4`;
            }

            if (!videoUrl) {
              return '';
            }

            return `
              <div class="swiper-slide" role="listitem" data-slide-key="${slide._key || ''}">
                <div class="work-carousel__video-wrapper">
                  <video
                    class="work-carousel__video"
                    src="${videoUrl}"
                    playsinline
                    loop
                    muted
                    autoplay
                    preload="metadata"
                  />
                </div>
              </div>
            `;
          }

          return '';
        })
        .filter(Boolean)
        .join('');

      const carouselHtml =
        projectMedia.length > 0
          ? `
          <div class="work-carousel" data-work-id="${data._id || ''}">
            <div class="work-carousel__swiper swiper">
              <div class="swiper-wrapper" role="list">
                ${slidesHtml}
              </div>
              ${
                projectMedia.length > 1
                  ? `
                <div class="work-carousel__controls">
                  <button
                    class="work-carousel__button work-carousel__button--prev"
                    aria-label="Previous slide"
                    type="button"
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M5 12h14m0 0-7-7m7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button
                    class="work-carousel__button work-carousel__button--next"
                    aria-label="Next slide"
                    type="button"
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M5 12h14m0 0-7-7m7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              `
                  : ''
              }
            </div>
            <button
              class="work-carousel__info-toggle"
              aria-label="Show work information"
              type="button"
              data-info-toggle
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 22c5.421 0 10-4.579 10-10S17.421 2 12 2 2 6.579 2 12s4.579 10 10 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 16v-4M12 8h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        `
          : `
          <div class="work-carousel__empty">
            <p>No media available</p>
          </div>
        `;

      // Build info panel HTML
      const heroTitle = data.hero?.title || data.title || '';
      const heroSubtitle = data.hero?.subtitle || '';
      const heroIntro = data.hero?.intro || '';
      const year = data.year;
      const client = projectType === 'project' ? data.client?.title : null;
      const role = projectType === 'project' ? data.role : null;
      const location =
        projectType === 'photography' && data.city && data.country
          ? `${data.city}, ${data.country}`
          : null;
      const camera = projectType === 'photography' ? data.camera : null;

      const infoPanelHtml = `
                <div class="info-panel" data-info-panel>
                  <div class="info-panel__overlay" data-info-overlay></div>
                  <div class="info-panel__content" data-info-content>
                    <button class="info-panel__close" aria-label="Close info panel" type="button" data-info-close>
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div class="info-panel__body">
                      ${heroTitle ? `<h1 class="info-panel__title">${heroTitle}</h1>` : ''}
                      ${heroSubtitle ? `<h2 class="info-panel__subtitle">${heroSubtitle}</h2>` : ''}
                      ${heroIntro ? `<p class="info-panel__intro">${heroIntro}</p>` : ''}
                      <dl class="info-panel__meta">
                        ${client ? `<dt>Client</dt><dd>${client}</dd>` : ''}
                        ${role ? `<dt>Role</dt><dd>${role}</dd>` : ''}
                        ${year ? `<dt>Year</dt><dd>${year}</dd>` : ''}
                        ${location ? `<dt>Location</dt><dd>${location}</dd>` : ''}
                        ${camera ? `<dt>Camera</dt><dd>${camera}</dd>` : ''}
                      </dl>
                    </div>
                  </div>
                </div>
                <button class="info-panel__toggle" aria-label="Show work information" type="button" data-info-toggle>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 22c5.421 0 10-4.579 10-10S17.421 2 12 2 2 6.579 2 12s4.579 10 10 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 16v-4M12 8h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
      `;

      // Replace preview content with carousel
      previewContainer.innerHTML = `
        ${carouselHtml}
        ${infoPanelHtml}
      `;

      // Initialize carousel
      if (projectMedia.length > 0) {
        // Import Swiper CSS
        import('swiper/css').then(() => {
          import('swiper').then(({ default: Swiper }) => {
            import('swiper/modules').then(({ Navigation }) => {
              const swiperEl = previewContainer.querySelector(
                '.work-carousel__swiper',
              );
              const prevButton = previewContainer.querySelector(
                '.work-carousel__button--prev',
              );
              const nextButton = previewContainer.querySelector(
                '.work-carousel__button--next',
              );

              if (swiperEl && swiperEl instanceof HTMLElement) {
                // Cleanup existing Swiper instance if present
                if ((swiperEl as any).swiper) {
                  (swiperEl as any).swiper.destroy(true, true);
                }

                currentSwiper = /** @type {any} */ (
                  new Swiper(swiperEl, {
                    modules: [Navigation],
                    navigation: {
                      nextEl:
                        projectMedia.length > 1 &&
                        prevButton instanceof HTMLElement
                          ? prevButton
                          : null,
                      prevEl:
                        projectMedia.length > 1 &&
                        nextButton instanceof HTMLElement
                          ? nextButton
                          : null,
                    },
                    loop: false,
                    speed: 600,
                    keyboard: {
                      enabled: true,
                    },
                    slidesPerView: 1,
                    spaceBetween: 0,
                    width: null,
                    height: null,
                    autoHeight: false,
                    observer: true,
                    observeParents: true,
                    on: {
                      init: function () {
                        // Force update size after init
                        this.update();
                      },
                    },
                  })
                );

                // Force update size to ensure 100% width
                setTimeout(() => {
                  if (currentSwiper) {
                    currentSwiper.update();
                    currentSwiper.updateSize();
                  }
                }, 100);
                if (import.meta.env.DEV) {
                  console.log('✅ Swiper initialized');
                }
              }
            });
          });
        });
      }

      // Initialize info panel
      const infoPanel = previewContainer.querySelector('[data-info-panel]');
      const infoOverlay = previewContainer.querySelector('[data-info-overlay]');
      const infoContent = previewContainer.querySelector('[data-info-content]');
      // Find both the carousel info toggle and the existing info toggle
      const infoToggle =
        previewContainer.querySelector('.work-carousel__info-toggle') ||
        previewContainer.querySelector('[data-info-toggle]');
      const infoClose = previewContainer.querySelector('[data-info-close]');

      if (infoPanel && infoOverlay && infoContent && infoToggle && infoClose) {
        /** @type {HTMLElement} */
        const panel = infoPanel;

        // Ensure info panel starts closed (not visible)
        panel.classList.remove('is-open');

        // Get the info toggle button (from carousel or separate)
        const carouselInfoToggle = previewContainer.querySelector(
          '.work-carousel__info-toggle',
        );
        const separateInfoToggle = previewContainer.querySelector(
          '.info-panel__toggle',
        );
        const activeToggle = carouselInfoToggle || separateInfoToggle;

        function openInfoPanel() {
          panel.classList.add('is-open');
          document.body.style.overflow = 'hidden';
          // Hide info toggle, show close button
          if (activeToggle) {
            (activeToggle as HTMLElement).style.display = 'none';
          }
          if (infoClose) {
            (infoClose as HTMLElement).style.display = 'flex';
          }
        }

        function closeInfoPanel() {
          panel.classList.remove('is-open');
          document.body.style.overflow = '';
          // Show info toggle, hide close button
          if (activeToggle) {
            (activeToggle as HTMLElement).style.display = 'flex';
          }
          if (infoClose) {
            (infoClose as HTMLElement).style.display = 'none';
          }
        }

        // Initialize: hide close button, show toggle
        if (infoClose) {
          (infoClose as HTMLElement).style.display = 'none';
        }
        if (activeToggle) {
          (activeToggle as HTMLElement).style.display = 'flex';
        }

        if (activeToggle) {
          activeToggle.addEventListener('click', openInfoPanel);
        }
        if (infoClose) {
          infoClose.addEventListener('click', closeInfoPanel);
        }
        if (infoOverlay) {
          infoOverlay.addEventListener('click', closeInfoPanel);
        }

        document.addEventListener(
          'keydown',
          (/** @type {KeyboardEvent} */ e) => {
            if (e.key === 'Escape' && panel.classList.contains('is-open')) {
              closeInfoPanel();
            }
          },
        );
      }
    } else {
      // Clear detail content and restore preview
      if (previewContainer) {
        const panel = document.querySelector('.work__right');
        const defaultImage = panel?.getAttribute('data-default-image') || '';

        // Cleanup Swiper
        if (currentSwiper) {
          try {
            currentSwiper.destroy(true, true);
            currentSwiper = null;
          } catch (e) {
            console.warn('Error destroying Swiper:', e);
          }
        }

        // Restore default preview image
        previewContainer.innerHTML = `
          <img
            class="work__preview-img"
            src="${defaultImage}"
            alt=""
            loading="lazy"
            decoding="async"
          />
        `;
      }
    }
  }

  // Function to bind event listeners
  function bindEventListeners() {
    const workSection = document.querySelector('#work');
    if (workSection) {
      // Remove existing listeners if any (to prevent duplicates)
      workSection.removeEventListener(
        'work-panel-mode-change',
        handleModeChange,
      );
      workSection.removeEventListener(
        'work-panel-project-loaded',
        handleProjectLoaded,
      );
      workSection.removeEventListener(
        'work-panel-project-error',
        handleProjectError,
      );

      // Add event listeners
      workSection.addEventListener('work-panel-mode-change', handleModeChange);
      workSection.addEventListener(
        'work-panel-project-loaded',
        handleProjectLoaded,
      );
      workSection.addEventListener(
        'work-panel-project-error',
        handleProjectError,
      );

      if (import.meta.env.DEV) {
        console.log('✅ Event listeners bound');
      }
    } else {
      if (import.meta.env.DEV) {
        console.warn('⚠️ Work section not found for event binding');
      }
    }
  }

  // Handle project loaded event from workController
  /**
   * @param {Event} e
   */
  function handleProjectLoaded(e) {
    const customEvent = /** @type {CustomEvent} */ (e);
    const { projectData, slug } = customEvent.detail;

    if (import.meta.env.DEV) {
      console.log('✅ Project data received from workController:', {
        title: projectData?.title,
        slug,
        hasProjectMedia: !!projectData?.projectMedia,
        mediaCount: projectData?.projectMedia?.length || 0,
      });
    }

    // Use the loaded work data directly instead of fetching again
    if (projectData) {
      loadWorkMedia('detail', slug, 'project', projectData);
    }
  }

  // Handle project error event from workController
  /**
   * @param {Event} e
   */
  function handleProjectError(e) {
    const customEvent = /** @type {CustomEvent} */ (e);
    const { error, slug } = customEvent.detail;

    console.error('❌ Project load error:', error);

    const panel = document.querySelector('.work__right');
    const previewContainer = panel?.querySelector('.work__preview');

    if (previewContainer) {
      previewContainer.innerHTML = `
        <div class="work__detail-error">
          <p>Failed to load project details.</p>
          ${import.meta.env.DEV ? `<p style="font-size: 0.75rem; opacity: 0.7; margin-top: 0.5rem;">Error: ${error?.message || 'Unknown error'}</p>` : ''}
        </div>
      `;
    }
  }

  // Event handler function
  /**
   * @param {Event} e
   */
  function handleModeChange(e) {
    const customEvent = /** @type {CustomEvent} */ (e);
    const { mode, slug, type } = customEvent.detail;
    const projectType = type || 'project';

    if (import.meta.env.DEV) {
      console.log('🎯 work-panel-mode-change event:', { mode, slug, type });
    }

    loadWorkMedia(mode, slug, projectType);
  }

  // Check for initial work slug from SSR
  function checkInitialWork() {
    const panel = document.querySelector('.work__right');
    const initialSlug = panel?.getAttribute('data-initial-work-slug');

    if (initialSlug) {
      if (import.meta.env.DEV) {
        console.log('🎯 Initial work slug detected from SSR:', initialSlug);
      }
      // Wait a bit for workController to initialize and load the work
      setTimeout(() => {
        // The workController will handle loading via API and dispatch event
        // We just need to make sure the mode is set correctly
        const workSection = document.querySelector('#work');
        if (workSection) {
          workSection.dispatchEvent(
            new CustomEvent('work-panel-mode-change', {
              detail: { mode: 'detail', slug: initialSlug, type: 'project' },
              bubbles: true,
            }),
          );
        }
      }, 500);
    }
  }

  // Bind event listeners on initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      bindEventListeners();
      checkInitialWork();
    });
  } else {
    bindEventListeners();
    checkInitialWork();
  }

  // Also listen for astro:page-load to handle View Transitions
  document.addEventListener('astro:page-load', () => {
    // Re-bind event listeners after view transition
    bindEventListeners();

    // Check for pending project from sessionStorage (after navigation from detail page)
    const pendingSlug = sessionStorage.getItem('pendingProjectSlug');
    const pendingType = sessionStorage.getItem('pendingProjectType');

    if (pendingSlug && pendingType) {
      if (import.meta.env.DEV) {
        console.log('🎯 astro:page-load - Opening pending project:', {
          slug: pendingSlug,
          type: pendingType,
        });
      }

      // Wait a bit for workController to initialize
      setTimeout(() => {
        loadWorkMedia('detail', pendingSlug, pendingType);
        // Clear sessionStorage after loading
        sessionStorage.removeItem('pendingProjectSlug');
        sessionStorage.removeItem('pendingProjectType');
      }, 300);
    }
  });
</script>
