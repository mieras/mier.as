---
import WorkPreview from './WorkPreview.astro';
import ProjectViewer from './ProjectViewer.astro';

type Props = {
  mode?: 'preview' | 'detail';
  previewImage?: string;
  defaultImage?: string;
  projectSlug?: string;
  projectType?: 'project' | 'photography';
  initialProjectSlug?: string | null;
};

const {
  mode = 'preview',
  previewImage,
  defaultImage,
  projectSlug,
  projectType = 'project',
  initialProjectSlug = null,
} = Astro.props;
---

<aside
  class="work__right"
  aria-label="Preview panel"
  data-mode={mode}
  data-work-slug={projectSlug || initialProjectSlug || ''}
  data-work-type={projectType}
  data-default-image={defaultImage || ''}
  data-initial-work-slug={initialProjectSlug || ''}
>
  <WorkPreview imageUrl={previewImage} defaultImage={defaultImage} />
  <ProjectViewer />
</aside>

<style>
  .work__right {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100%;
    min-height: 0;
  }

  .work__detail-error {
    padding: var(--space-m);
    text-align: center;
    color: var(--work-items-secondary);
  }

  /* Work Carousel Styles - Global for dynamic HTML */
  :global(.work-carousel) {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  :global(.work-carousel__swiper) {
    width: 100% !important;
    height: 100% !important;
    flex: 1;
    min-height: 0;
  }

  :global(.work-carousel__swiper .swiper-wrapper) {
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: stretch;
  }

  :global(.work-carousel__swiper .swiper-slide) {
    width: 100% !important;
    height: 100% !important;
    min-width: 0 !important;
    min-height: 100% !important;
    max-width: 100% !important;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    box-sizing: border-box;
  }

  :global(.work-carousel__image-wrapper),
  :global(.work-carousel__video-wrapper) {
    width: 100% !important;
    height: 100% !important;
    position: relative;
    flex: 1;
    min-width: 0;
    min-height: 0;
  }

  :global(.work-carousel__image),
  :global(.work-carousel__video) {
    display: block;
    flex: 1;
  }

  /* Fit mode: fill (default) - fills container, may crop */
  :global(.work-carousel__media--fill .work-carousel__image),
  :global(.work-carousel__media--fill .work-carousel__video) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
  }

  /* Fit mode: fit - maintains aspect ratio, centered at 80% of container */
  :global(.work-carousel__media--fit) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.work-carousel__media--fit .work-carousel__image),
  :global(.work-carousel__media--fit .work-carousel__video) {
    object-fit: contain;
    max-width: 80%;
    max-height: 80%;
    width: auto;
    height: auto;
  }

  :global(.work-carousel__controls) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 20;
    display: flex;
    gap: var(--space-m);
    align-items: center;
    width: 100%;
    max-width: 1200px;
    justify-content: space-between;
    pointer-events: none;
  }

  :global(.work-carousel__button) {
    backdrop-filter: blur(30px);
    color: #fff;
    background-color: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
    padding: 0;
    pointer-events: auto;
  }

  :global(.work-carousel__button:hover) {
    color: #000;
    background-color: #fff;
  }

  :global(.work-carousel__button:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  :global(.work-carousel__button svg) {
    width: 24px;
    height: 24px;
  }

  :global(.work-carousel__button--prev) {
    margin-right: auto;
  }

  :global(.work-carousel__button--prev svg) {
    transform: rotate(180deg);
  }

  :global(.work-carousel__button--next) {
    margin-left: auto;
  }

  :global(.work-carousel__empty) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary, rgba(255, 255, 255, 0.6));
  }

  .work__right[data-mode='detail'] .work__preview {
    display: none;
  }

  .work__right[data-mode='preview'] .project-viewer {
    display: none;
  }

  /* Tablet: adjust panel */
  @media (max-width: 1024px) and (min-width: 768px) {
    .work__right {
      position: relative;
      height: auto;
      min-height: 60vh;
    }

    .work-carousel__controls {
      gap: var(--space-s);
    }
  }

  /* Mobile: full width panel */
  @media (max-width: 767px) {
    .work__right {
      position: relative;
      height: auto;
      min-height: 50vh;
    }

    .work-carousel__controls {
      gap: var(--space-xs);
      max-width: 100%;
      padding: 0 var(--space-s);
    }

    .work-carousel__button {
      width: 2rem;
      height: 2rem;
    }

    .work-carousel__button svg {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script>
  // @ts-nocheck
  import { urlForImage } from '../../../sanity/lib/image';

  // Store Swiper instance for cleanup
  let currentSwiper = null;
  const projectCache = new Map();
  const photographyCache = new Map();

  function getPanelElements() {
    const panel = document.querySelector('.work__right');
    return {
      panel,
      previewContainer: panel?.querySelector('.work__preview'),
      projectViewer: panel?.querySelector('[data-project-viewer]'),
      mediaContainer: panel?.querySelector('[data-project-media]'),
    };
  }

  function destroySwiper() {
    if (!currentSwiper) return;
    try {
      currentSwiper.destroy(true, true);
      currentSwiper = null;
    } catch (e) {
      console.warn('Error destroying Swiper:', e);
    }
  }

  // Function to load work media
  /**
   * @param {string} mode
   * @param {string|undefined} slug
   * @param {string} projectType
   * @param {any} workData
   * @returns {void}
   */
  function loadWorkMedia(mode, slug, projectType, workData) {
    if (import.meta.env.DEV) {
      console.log('🔄 loadWorkMedia called:', { mode, slug, projectType });
    }

    const { panel, previewContainer, mediaContainer } = getPanelElements();

    if (!panel || !previewContainer || !mediaContainer) {
      if (import.meta.env.DEV) {
        console.warn('⚠️ loadWorkMedia: Required containers not found', {
          hasPanel: !!panel,
          hasPreviewContainer: !!previewContainer,
          hasMediaContainer: !!mediaContainer,
        });
      }
      return;
    }

    if (mode !== 'detail') {
      destroySwiper();
      mediaContainer.innerHTML = '';
      resetInfoPanel(panel);
      return;
    }

    if (!slug) {
      if (import.meta.env.DEV) {
        console.warn('⚠️ loadWorkMedia: No slug provided');
      }
      return;
    }

    if (workData) {
      renderWorkData(workData, mediaContainer, panel, projectType);
      return;
    }

    const apiUrl =
      projectType === 'photography'
        ? `/api/photography/${slug}.json`
        : `/api/project.json?slug=${encodeURIComponent(slug)}`;

    if (import.meta.env.DEV) {
      console.log('📡 Fetching project data from:', apiUrl);
    }

    fetch(apiUrl)
      .then((res) => {
        if (import.meta.env.DEV) {
          console.log('📥 Fetch response:', {
            status: res.status,
            statusText: res.statusText,
            ok: res.ok,
            url: res.url,
          });
        }

        if (!res.ok) {
          throw new Error(
            `Failed to load ${projectType}: ${res.status} ${res.statusText}`,
          );
        }
        return res.json();
      })
      .then((data) => {
        if (import.meta.env.DEV) {
          console.log('✅ Project data loaded:', {
            title: data?.title,
            _id: data?._id,
            mediaCount: data?.projectMedia?.length || 0,
            hasProjectMedia: !!data?.projectMedia,
            projectMedia: data?.projectMedia,
            fullData: data,
          });
        }

        if (!data) {
          throw new Error('No data returned from API');
        }

        if (projectType === 'project' && slug) {
          projectCache.set(slug, data);
        }
        if (projectType === 'photography' && slug) {
          photographyCache.set(slug, data);
        }

        renderWorkData(data, mediaContainer, panel, projectType);
      })
      .catch((error) => {
        console.error('❌ Failed to load project:', error);
        if (mediaContainer) {
          mediaContainer.innerHTML = `
            <div class="work__detail-error">
              <p>Failed to load project details.</p>
              ${import.meta.env.DEV ? `<p style="font-size: 0.75rem; opacity: 0.7; margin-top: 0.5rem;">Error: ${error?.message || 'Unknown error'}</p>` : ''}
            </div>
          `;
        }
      });
  }

  /**
   * Render work data into the preview container
   * @param {object} data - Work data
   * @param {HTMLElement} mediaContainer - Container to render into
   * @param {HTMLElement} panel - Work panel element
   * @param {string} projectType - Type of work ('project' or 'photography')
   */
  function renderWorkData(
    data,
    mediaContainer,
    panel,
    projectType = 'project',
  ) {
    if (!data || !mediaContainer || !panel) return;

    destroySwiper();

    const projectMedia = data.projectMedia || [];
    const slides = projectMedia
      .map((slide) => {
        const imageUrl =
          slide?.image?.url ||
          (slide?.image?.asset
            ? urlForImage(slide.image)
                ?.width(1920)
                .fit('max')
                .auto('format')
                .url()
            : '');
        const imageAlt = slide?.image?.alt || '';

        let videoUrl = slide?.video?.url || slide?.video?.asset?.url || null;

        if (!videoUrl && slide?.video?.asset?._ref) {
          const assetId = slide.video.asset._ref
            .replace('file-', '')
            .replace('-mp4', '');
          const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
          const dataset = import.meta.env.PUBLIC_SANITY_DATASET;
          videoUrl = `https://cdn.sanity.io/files/${projectId}/${dataset}/${assetId}.mp4`;
        }

        return {
          key: slide?._key || '',
          imageUrl,
          imageAlt,
          videoUrl,
          fitMode: slide?.fitMode || 'fill', // Include fitMode for photography
        };
      })
      .filter((slide) => slide.imageUrl || slide.videoUrl);

    const slidesHtml = slides
      .map((slide) => {
        const fitModeClass = `work-carousel__media--${slide.fitMode || 'fill'}`;
        if (slide.videoUrl) {
          return `
            <div class="swiper-slide" role="listitem" data-slide-key="${slide.key}">
              <div class="work-carousel__video-wrapper ${fitModeClass}">
                <video
                  class="work-carousel__video"
                  src="${slide.videoUrl}"
                  playsinline
                  loop
                  muted
                  autoplay
                  preload="metadata"
                />
              </div>
            </div>
          `;
        }

        return `
          <div class="swiper-slide" role="listitem" data-slide-key="${slide.key}">
            <div class="work-carousel__image-wrapper ${fitModeClass}">
              <img
                src="${slide.imageUrl}"
                alt="${slide.imageAlt}"
                class="work-carousel__image"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        `;
      })
      .join('');

    mediaContainer.innerHTML =
      slides.length > 0
        ? `
        <div class="work-carousel" data-work-id="${data._id || ''}">
          <div class="work-carousel__swiper swiper">
            <div class="swiper-wrapper" role="list">
              ${slidesHtml}
            </div>
            ${
              slides.length > 1
                ? `
              <div class="work-carousel__controls">
                <button
                  class="work-carousel__button work-carousel__button--prev"
                  aria-label="Previous slide"
                  type="button"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 12h14m0 0-7-7m7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <button
                  class="work-carousel__button work-carousel__button--next"
                  aria-label="Next slide"
                  type="button"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 12h14m0 0-7-7m7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            `
                : ''
            }
          </div>
        </div>
      `
        : `
        <div class="work-carousel__empty">
          <p>No media available</p>
        </div>
      `;

    if (slides.length > 0) {
      import('swiper/css').then(() => {
        import('swiper').then(({ default: Swiper }) => {
          import('swiper/modules').then(({ Navigation }) => {
            const swiperEl = mediaContainer.querySelector(
              '.work-carousel__swiper',
            );
            const prevButton = mediaContainer.querySelector(
              '.work-carousel__button--prev',
            );
            const nextButton = mediaContainer.querySelector(
              '.work-carousel__button--next',
            );

            if (swiperEl && swiperEl instanceof HTMLElement) {
              if ((swiperEl as any).swiper) {
                (swiperEl as any).swiper.destroy(true, true);
              }

              currentSwiper = /** @type {any} */ (
                new Swiper(swiperEl, {
                  modules: [Navigation],
                  navigation: {
                    nextEl:
                      slides.length > 1 && nextButton instanceof HTMLElement
                        ? nextButton
                        : null,
                    prevEl:
                      slides.length > 1 && prevButton instanceof HTMLElement
                        ? prevButton
                        : null,
                  },
                  loop: slides.length > 1,
                  speed: 600,
                  keyboard: {
                    enabled: true,
                  },
                  slidesPerView: 1,
                  spaceBetween: 0,
                  autoHeight: false,
                  observer: true,
                  observeParents: true,
                  on: {
                    init: function () {
                      this.update();
                    },
                  },
                })
              );

              setTimeout(() => {
                if (currentSwiper) {
                  currentSwiper.update();
                  currentSwiper.updateSize();
                }
              }, 100);
              if (import.meta.env.DEV) {
                console.log('✅ Swiper initialized');
              }
            }
          });
        });
      });
    }

    updateInfoPanel(panel, data, projectType);
    initInfoPanel(panel);
  }

  function resetInfoPanel(panel) {
    if (!panel) return;
    const infoPanel = panel.querySelector('[data-info-panel]');
    if (infoPanel) {
      infoPanel.classList.remove('is-open');
    }
    const infoClose = panel.querySelector('[data-info-close]');
    const infoToggle = panel.querySelector('[data-info-toggle]');
    if (infoClose) {
      infoClose.style.display = 'none';
    }
    if (infoToggle) {
      infoToggle.style.display = 'flex';
    }
    document.body.style.overflow = '';
  }

  function updateInfoPanel(panel, data, projectType) {
    const infoPanel = panel?.querySelector('[data-info-panel]');
    if (!infoPanel) return;

    const heroTitle = data.projectTitle || data.title || '';
    const heroSubtitle = data.subtitle || '';
    const heroIntro = ''; // Description is now separate, not in hero
    const year = data.year ? String(data.year) : '';
    const client = projectType === 'project' ? data.client?.title : '';
    const role = ''; // Role removed from schema
    const location =
      projectType === 'photography' &&
      data.location &&
      Array.isArray(data.location)
        ? data.location.join(', ')
        : '';
    const camera =
      projectType === 'photography' && data.camera && Array.isArray(data.camera)
        ? data.camera.join(', ')
        : '';
    const film =
      projectType === 'photography' && data.film && Array.isArray(data.film)
        ? data.film.join(', ')
        : '';

    const setText = (el, value) => {
      if (!el) return;
      if (value) {
        el.textContent = value;
        el.hidden = false;
      } else {
        el.textContent = '';
        el.hidden = true;
      }
    };

    setText(infoPanel.querySelector('[data-info-title]'), heroTitle);
    setText(infoPanel.querySelector('[data-info-subtitle]'), heroSubtitle);
    setText(infoPanel.querySelector('[data-info-intro]'), heroIntro);

    const fields = { client, year, location, camera, film };
    Object.entries(fields).forEach(([key, value]) => {
      const label = infoPanel.querySelector(`[data-info-label="${key}"]`);
      const val = infoPanel.querySelector(`[data-info-value="${key}"]`);
      if (value) {
        if (label) label.hidden = false;
        if (val) {
          val.hidden = false;
          val.textContent = value;
        }
      } else {
        if (label) label.hidden = true;
        if (val) {
          val.hidden = true;
          val.textContent = '';
        }
      }
    });
  }

  function initInfoPanel(panel) {
    if (!panel) return;
    const infoPanel = panel.querySelector('[data-info-panel]');
    const infoOverlay = panel.querySelector('[data-info-overlay]');
    const infoToggle = panel.querySelector('[data-info-toggle]');
    const infoClose = panel.querySelector('[data-info-close]');

    if (!infoPanel || !infoOverlay || !infoToggle || !infoClose) return;

    const newToggle = infoToggle.cloneNode(true);
    infoToggle.parentNode?.replaceChild(newToggle, infoToggle);
    const newClose = infoClose.cloneNode(true);
    infoClose.parentNode?.replaceChild(newClose, infoClose);

    const openInfoPanel = () => {
      infoPanel.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      newToggle.style.display = 'none';
      newClose.style.display = 'flex';
    };

    const closeInfoPanel = () => {
      infoPanel.classList.remove('is-open');
      document.body.style.overflow = '';
      newToggle.style.display = 'flex';
      newClose.style.display = 'none';
    };

    newClose.style.display = 'none';
    newToggle.style.display = 'flex';

    newToggle.addEventListener('click', openInfoPanel);
    newClose.addEventListener('click', closeInfoPanel);
    infoOverlay.addEventListener('click', closeInfoPanel);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && infoPanel.classList.contains('is-open')) {
        closeInfoPanel();
      }
    });
  }

  // Function to bind event listeners
  function bindEventListeners() {
    const workSection = document.querySelector('#work');
    if (workSection) {
      // Remove existing listeners if any (to prevent duplicates)
      workSection.removeEventListener(
        'work-panel-mode-change',
        handleModeChange,
      );
      workSection.removeEventListener(
        'work-panel-project-loaded',
        handleProjectLoaded,
      );
      workSection.removeEventListener(
        'work-panel-project-error',
        handleProjectError,
      );
      workSection.removeEventListener(
        'work-panel-photography-loaded',
        handlePhotographyLoaded,
      );
      workSection.removeEventListener(
        'work-panel-photography-error',
        handlePhotographyError,
      );

      // Add event listeners
      workSection.addEventListener('work-panel-mode-change', handleModeChange);
      workSection.addEventListener(
        'work-panel-project-loaded',
        handleProjectLoaded,
      );
      workSection.addEventListener(
        'work-panel-project-error',
        handleProjectError,
      );
      workSection.addEventListener(
        'work-panel-photography-loaded',
        handlePhotographyLoaded,
      );
      workSection.addEventListener(
        'work-panel-photography-error',
        handlePhotographyError,
      );

      if (import.meta.env.DEV) {
        console.log('✅ Event listeners bound');
      }
    } else {
      if (import.meta.env.DEV) {
        console.warn('⚠️ Work section not found for event binding');
      }
    }
  }

  // Handle project loaded event from workController
  /**
   * @param {Event} e
   */
  function handleProjectLoaded(e) {
    const customEvent = /** @type {CustomEvent} */ (e);
    const { projectData, slug } = customEvent.detail;

    if (import.meta.env.DEV) {
      console.log('✅ Project data received from workController:', {
        title: projectData?.title,
        slug,
        hasProjectMedia: !!projectData?.projectMedia,
        mediaCount: projectData?.projectMedia?.length || 0,
      });
    }

    // Use the loaded work data directly instead of fetching again
    if (projectData) {
      projectCache.set(slug, projectData);
      loadWorkMedia('detail', slug, 'project', projectData);
    }
  }

  // Handle project error event from workController
  /**
   * @param {Event} e
   */
  function handleProjectError(e) {
    const customEvent = /** @type {CustomEvent} */ (e);
    const { error, slug } = customEvent.detail;

    console.error('❌ Project load error:', error);

    const { panel, mediaContainer } = getPanelElements();

    if (panel && mediaContainer) {
      mediaContainer.innerHTML = `
        <div class="work__detail-error">
          <p>Failed to load project details.</p>
          ${import.meta.env.DEV ? `<p style="font-size: 0.75rem; opacity: 0.7; margin-top: 0.5rem;">Error: ${error?.message || 'Unknown error'}</p>` : ''}
        </div>
      `;
    }
  }

  // Handle photography loaded event from workController
  /**
   * @param {Event} e
   */
  function handlePhotographyLoaded(e) {
    const customEvent = /** @type {CustomEvent} */ (e);
    const { photographyData, slug } = customEvent.detail;

    if (import.meta.env.DEV) {
      console.log('✅ Photography data received from workController:', {
        title: photographyData?.projectTitle,
        slug,
        hasProjectMedia: !!photographyData?.projectMedia,
        mediaCount: photographyData?.projectMedia?.length || 0,
      });
    }

    // Use the loaded photography data directly instead of fetching again
    if (photographyData) {
      photographyCache.set(slug, photographyData);
      loadWorkMedia('detail', slug, 'photography', photographyData);
    }
  }

  // Handle photography error event from workController
  /**
   * @param {Event} e
   */
  function handlePhotographyError(e) {
    const customEvent = /** @type {CustomEvent} */ (e);
    const { error, slug } = customEvent.detail;

    console.error('❌ Photography load error:', error);

    const { panel, mediaContainer } = getPanelElements();

    if (panel && mediaContainer) {
      mediaContainer.innerHTML = `
        <div class="work__detail-error">
          <p>Failed to load photography details.</p>
          ${import.meta.env.DEV ? `<p style="font-size: 0.75rem; opacity: 0.7; margin-top: 0.5rem;">Error: ${error?.message || 'Unknown error'}</p>` : ''}
        </div>
      `;
    }
  }

  // Event handler function
  /**
   * @param {Event} e
   */
  function handleModeChange(e) {
    const customEvent = /** @type {CustomEvent} */ (e);
    const { mode, slug, type } = customEvent.detail;
    const projectType = type || 'project';

    if (import.meta.env.DEV) {
      console.log('🎯 work-panel-mode-change event:', { mode, slug, type });
    }

    if (mode !== 'detail') {
      loadWorkMedia(mode, slug, projectType);
      return;
    }

    if (projectType === 'project' && slug && projectCache.has(slug)) {
      loadWorkMedia('detail', slug, projectType, projectCache.get(slug));
      return;
    }

    if (projectType === 'photography' && slug && photographyCache.has(slug)) {
      loadWorkMedia('detail', slug, projectType, photographyCache.get(slug));
      return;
    }

    if (projectType === 'photography') {
      loadWorkMedia(mode, slug, projectType);
    }
  }

  // Check for initial work slug from SSR
  function checkInitialWork() {
    const panel = document.querySelector('.work__right');
    const initialSlug = panel?.getAttribute('data-initial-work-slug');

    if (initialSlug) {
      if (import.meta.env.DEV) {
        console.log('🎯 Initial work slug detected from SSR:', initialSlug);
      }
      // Wait a bit for workController to initialize and load the work
      setTimeout(() => {
        // The workController will handle loading via API and dispatch event
        // We just need to make sure the mode is set correctly
        const workSection = document.querySelector('#work');
        if (workSection) {
          workSection.dispatchEvent(
            new CustomEvent('work-panel-mode-change', {
              detail: { mode: 'detail', slug: initialSlug, type: 'project' },
              bubbles: true,
            }),
          );
        }
      }, 500);
    }
  }

  // Bind event listeners on initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      bindEventListeners();
      checkInitialWork();
    });
  } else {
    bindEventListeners();
    checkInitialWork();
  }

  // Also listen for astro:page-load to handle View Transitions
  document.addEventListener('astro:page-load', () => {
    // Re-bind event listeners after view transition
    bindEventListeners();

    // Check for pending project from sessionStorage (after navigation from detail page)
    const pendingSlug = sessionStorage.getItem('pendingProjectSlug');
    const pendingType = sessionStorage.getItem('pendingProjectType');

    if (pendingSlug && pendingType) {
      if (import.meta.env.DEV) {
        console.log('🎯 astro:page-load - Opening pending project:', {
          slug: pendingSlug,
          type: pendingType,
        });
      }

      if (pendingType === 'photography') {
        setTimeout(() => {
          loadWorkMedia('detail', pendingSlug, pendingType);
          sessionStorage.removeItem('pendingProjectSlug');
          sessionStorage.removeItem('pendingProjectType');
        }, 300);
      }
    }
  });
</script>
