---
import { Image } from 'astro:assets';
import { urlForImage } from '../../../sanity/lib/image';

type WorkMediaSlide = {
  _key: string;
  _type: 'imageSlide' | 'videoSlide';
  image?: any;
  video?: {
    asset?: {
      url?: string;
      _ref?: string;
    };
  };
  fitMode?: 'fill' | 'fit';
};

type Props = {
  workMedia?: WorkMediaSlide[];
  workId?: string;
};

const { workMedia = [], workId = '' } = Astro.props;

// Process media slides
const slides = workMedia
  .map((slide) => {
    let imageUrl = '';
    let imageAlt = '';
    let videoUrl = '';

    if (slide._type === 'imageSlide' && slide.image?.asset) {
      try {
        imageUrl =
          urlForImage(slide.image)
            ?.width(1920)
            .fit('max')
            .auto('format')
            .url() || '';
        imageAlt = slide.image.alt || '';
      } catch (error) {
        if (import.meta.env.DEV) {
          console.warn('⚠️ Failed to generate image URL:', error);
        }
      }
    } else if (slide._type === 'videoSlide' && slide.video?.asset?.url) {
      videoUrl = slide.video.asset.url;
    }

    return {
      _key: slide._key,
      _type: slide._type,
      imageUrl,
      imageAlt,
      videoUrl,
      fitMode: slide.fitMode || 'fill', // Default to 'fill' if not specified
      hasImage: !!imageUrl,
      hasVideo: !!videoUrl,
    };
  })
  .filter((slide) => slide.hasImage || slide.hasVideo);

if (import.meta.env.DEV) {
  console.log('🎠 WorkCarousel slides:', slides.length);
}
---

<div class="work-carousel" data-work-id={workId}>
  {
    slides.length > 0 ? (
      <div class="work-carousel__swiper swiper">
        <div class="swiper-wrapper" role="list">
          {slides.map((slide) => (
            <div
              class="swiper-slide"
              role="listitem"
              data-slide-key={slide._key}
            >
              {slide.hasVideo ? (
                <div
                  class={`work-carousel__video-wrapper work-carousel__media--${slide.fitMode}`}
                >
                  <video
                    class="work-carousel__video"
                    src={slide.videoUrl}
                    playsinline
                    loop
                    muted
                    autoplay
                    preload="metadata"
                  />
                </div>
              ) : slide.hasImage ? (
                <div
                  class={`work-carousel__image-wrapper work-carousel__media--${slide.fitMode}`}
                >
                  <Image
                    src={slide.imageUrl}
                    alt={slide.imageAlt}
                    width={1920}
                    height={1080}
                    format="avif"
                    class="work-carousel__image"
                  />
                </div>
              ) : null}
            </div>
          ))}
        </div>

        {slides.length > 1 && (
          <div class="work-carousel__controls">
            <button
              class="work-carousel__button work-carousel__button--prev"
              aria-label="Previous slide"
              type="button"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M5 12h14m0 0-7-7m7 7-7 7"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <button
              class="work-carousel__button work-carousel__button--next"
              aria-label="Next slide"
              type="button"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M5 12h14m0 0-7-7m7 7-7 7"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        )}
      </div>
    ) : (
      <div class="work-carousel__empty">
        <p>No media available</p>
      </div>
    )
  }
</div>

<style>
  :global(.work-carousel) {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  :global(.work-carousel__swiper) {
    width: 100%;
    height: 100%;
  }

  :global(.work-carousel__swiper .swiper-wrapper) {
    width: 100%;
    height: 100%;
  }

  :global(.work-carousel__swiper .swiper-slide) {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  :global(.work-carousel__image-wrapper),
  :global(.work-carousel__video-wrapper) {
    width: 100%;
    height: 100%;
    position: relative;
  }

  :global(.work-carousel__image),
  :global(.work-carousel__video) {
    display: block;
  }

  /* Fit mode: fill (default) - fills container, may crop */
  :global(.work-carousel__media--fill .work-carousel__image),
  :global(.work-carousel__media--fill .work-carousel__video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Fit mode: fit - maintains aspect ratio, centered at 80% of container */
  :global(.work-carousel__media--fit) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.work-carousel__media--fit .work-carousel__image),
  :global(.work-carousel__media--fit .work-carousel__video) {
    object-fit: contain;
    max-width: 80%;
    max-height: 80%;
    width: auto;
    height: auto;
  }

  :global(.work-carousel__controls) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    display: flex;
    gap: var(--space-m);
    align-items: center;
    width: 100%;
    max-width: 1200px;
    justify-content: space-between;
    pointer-events: none;
  }

  :global(.work-carousel__button) {
    backdrop-filter: blur(30px);
    color: #fff;
    background-color: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
    padding: 0;
    pointer-events: auto;
  }

  :global(.work-carousel__button:hover) {
    color: #000;
    background-color: #fff;
  }

  :global(.work-carousel__button:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  :global(.work-carousel__button svg) {
    width: 24px;
    height: 24px;
  }

  :global(.work-carousel__button--prev) {
    margin-right: auto;
  }

  :global(.work-carousel__button--prev svg) {
    transform: rotate(180deg);
  }

  :global(.work-carousel__button--next) {
    margin-left: auto;
  }

  :global(.work-carousel__empty) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary, rgba(255, 255, 255, 0.6));
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation } from 'swiper/modules';
  import 'swiper/css';

  document.addEventListener('astro:page-load', initWorkCarousel);
  if (document.readyState !== 'loading') {
    initWorkCarousel();
  }

  function initWorkCarousel() {
    const carousels = document.querySelectorAll('.work-carousel__swiper');

    carousels.forEach((carouselEl) => {
      // Skip if already initialized (check for existing Swiper instance)
      if ((carouselEl as any).swiper) {
        return;
      }

      const prevButton = carouselEl.querySelector(
        '.work-carousel__button--prev',
      ) as HTMLElement;
      const nextButton = carouselEl.querySelector(
        '.work-carousel__button--next',
      ) as HTMLElement;

      new Swiper(carouselEl as HTMLElement, {
        modules: [Navigation],
        navigation: {
          nextEl: nextButton,
          prevEl: prevButton,
        },
        loop: false,
        speed: 600,
        keyboard: {
          enabled: true,
        },
      });
    });
  }

  // Export function for manual initialization (e.g., from WorkPanel)
  (window as any).initWorkCarousel = initWorkCarousel;
</script>
