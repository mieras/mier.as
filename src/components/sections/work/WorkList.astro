---
import WorkListItem from './WorkListItem.astro';

type Project = {
  _id: string;
  projectTitle?: string;
  title?: string; // Fallback for old data
  slug?: string;
  year?: number;
  subtitle?: string;
  preview?: {
    image?: any;
    video?: any;
  };
  client?: {
    title: string;
  };
};

type PhotographyItem = {
  _id: string;
  projectTitle?: string;
  title?: string; // Fallback for old data
  slug?: string;
  year?: number;
  location?: string[];
  preview?: any;
};

type Props = {
  projects?: Project[];
  photography?: PhotographyItem[];
  activeTab?: 'design' | 'photography';
};

const { projects = [], photography = [], activeTab = 'design' } = Astro.props;

const filteredItems = activeTab === 'design' ? projects : photography;
---

<div class="work__list" aria-label="Projects">
  {
    filteredItems.map((item) =>
      activeTab === 'design' ? (
        <WorkListItem project={item as Project} type="design" />
      ) : (
        <WorkListItem
          photography={item as PhotographyItem}
          type="photography"
        />
      ),
    )
  }
</div>

<style>
  .work__list {
    display: grid;
    min-height: 0;
    overflow: auto;
  }
</style>
