---
import InfoPanel from './InfoPanel.astro';
---

<div class="project-viewer" data-project-viewer>
  <div class="project-viewer__media" data-project-media></div>
  <div class="project-viewer__info">
    <InfoPanel />
  </div>
</div>

<style>
  .project-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background: var(--section-work-bg);
  }

  .project-viewer__media {
    width: 100%;
    height: 100%;
    min-height: 0;
    position: relative;
  }

  .project-viewer__info {
    position: absolute;
    inset: 0;
  }
</style>
