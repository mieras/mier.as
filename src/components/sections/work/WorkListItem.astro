---
import { urlForImage } from '../../../sanity/lib/image';

type Project = {
  _id: string;
  projectTitle?: string;
  title?: string; // Fallback for old data
  slug?: string;
  year?: number;
  subtitle?: string;
  preview?: {
    image?: any;
    video?: any;
  };
  client?: {
    title: string;
  };
};

type PhotographyItem = {
  _id: string;
  projectTitle?: string;
  title?: string; // Fallback for old data
  slug?: string;
  year?: number;
  location?: string[];
  preview?: any;
};

type Props = {
  project?: Project;
  photography?: PhotographyItem;
  type?: 'design' | 'photography';
};

const { project, photography, type = 'design' } = Astro.props;

// Determine which data to use
const item = type === 'photography' ? photography : project;
if (!item) return null;

// Debug: log photography data to see what we're getting
if (import.meta.env.DEV && type === 'photography') {
  console.log('📸 Photography item data:', {
    _id: item._id,
    projectTitle: item.projectTitle,
    title: item.title,
    location: photography?.location,
    year: item.year,
    fullItem: item,
  });
}

// Get preview image URL
let imageUrl: string | null = null;
if (type === 'design' && project?.preview) {
  if (project.preview.image?.asset) {
    imageUrl =
      urlForImage(project.preview.image)?.width(1200).height(800).url() || null;
  } else if (project.preview.video?.asset) {
    // For video, we'd need to get a thumbnail or use a placeholder
    // For now, we'll leave it null and handle it in the component
    imageUrl = null;
  }
} else if (type === 'photography' && photography?.preview?.asset) {
  imageUrl =
    urlForImage(photography.preview)?.width(1200).height(800).url() || null;
}

const year = item.year || null;
const projectTitle = item.projectTitle || item.title || '';

// For design projects: show client and project title
const client = project?.client?.title || '';
const description = projectTitle;

// For photography: show location and project title (only Project Title, Location and Year are shown)
const location =
  photography?.location && photography.location.length > 0
    ? photography.location.join(', ')
    : '';
const photoDescription = projectTitle;

const dataId =
  type === 'photography'
    ? {
        'data-photo-id': item._id,
        'data-preview': imageUrl || '',
      }
    : {
        'data-work-id': item._id,
        'data-work-slug': project?.slug || '',
        'data-preview': imageUrl || '',
      };
---

<a
  class="work-row"
  href="#"
  data-type={type}
  {...dataId}
  role="button"
  tabindex="0"
  aria-label={`${type === 'design' ? client : location} - ${projectTitle}`}
>
  <span class="work-row__client">{type === 'design' ? client : location}</span>
  <span class="work-row__desc"
    >{type === 'design' ? description : photoDescription}</span
  >
  {year && <span class="work-row__year">{year}</span>}
</a>

<style>
  .work-row {
    display: grid;
    grid-template-columns: 1.25fr 1.5fr 0.5fr;
    gap: var(--space-s);
    align-items: center;
    padding: 0;
    text-decoration: none;
    color: inherit;
    background: var(--section-work-bg);
    border-top: 1px solid var(--work-items-hover-bg);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .work-row:hover {
    background: var(--work-items-hover-bg);
    color: var(--work-items-text);
  }

  .work-row.is-active {
    background: #000;
    color: var(--text-light);
  }

  .work-row.is-active:hover {
    background: #000;
    color: var(--text-light);
  }

  .work-row__client {
    font-family: var(--font-family-heading);
    font-size: var(--fs-0);
    font-weight: 650;
    line-height: 1.2;
    padding: var(--space-xs);
  }

  .work-row__desc {
    font-size: var(--fs--2);
    opacity: 0.6;
    line-height: 1.2;
    padding: var(--space-xs);
  }

  .work-row.is-active .work-row__desc {
    opacity: 0.9;
  }

  .work-row__year {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: var(--fs--2);
    opacity: 0.6;
    line-height: 1.2;
    padding: var(--space-xs);
    padding-right: var(--space-xs);
  }

  .work-row.is-active .work-row__year {
    opacity: 0.9;
  }

  /* Mobile: stack columns */
  @media (max-width: 768px) {
    .work-row {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }

    .work-row__year {
      justify-self: start;
    }
  }

  /* Focus states for accessibility */
  .work-row:focus-visible {
    outline: 2px solid var(--work-tabs-active-bg);
    outline-offset: 2px;
    background: var(--work-items-hover-bg);
  }

  .work-row.is-active:focus-visible {
    background: var(--work-items-active-bg);
    outline-color: var(--text-light);
  }
</style>
