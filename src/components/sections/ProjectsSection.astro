---
import ProjectListItem from './projects/ProjectListItem.astro';

type Project = {
  _id: string;
  title: string;
  slug: string;
  year?: number;
  subtitle?: string;
  intro?: string;
  role?: string;
  thumbnail?: {
    image?: any;
    aspectRatio?: string;
  };
  client?: {
    title: string;
  };
};

type PhotographyItem = {
  _id: string;
  title: string;
  year?: number;
  city?: string;
  country?: string;
  camera?: string;
  thumbnail?: any;
};

type Props = {
  projects: Project[];
  photography: PhotographyItem[];
};

const { projects, photography } = Astro.props;
---

<section class="relative projects-section">
  <div class="flex sticky top-0 projects-tabs">
    <button class="tab-button tab-active" data-tab="design" aria-label="Show design projects">
      Design
    </button>
    <button class="tab-button" data-tab="photography" aria-label="Show photography">
      Photography
    </button>
  </div>

  <!-- Design Projects Tab -->
  <div class="tab-content tab-content-active" data-tab-content="design">
    <ul class="projects-list">
      {projects.map((project) => (
        <ProjectListItem 
          project={project} 
          type="design" 
          showThumbnail={true}
        />
      ))}
    </ul>
  </div>

  <!-- Photography Tab -->
  <div class="tab-content" data-tab-content="photography">
    <ul class="projects-list">
      {photography.map((photo) => (
        <ProjectListItem 
          photography={photo} 
          type="photography" 
        />
      ))}
    </ul>
  </div>
</section>

<script>
  // Tab switching functionality - scoped to projects section only
  document.addEventListener('DOMContentLoaded', () => {
    const projectsSection = document.querySelector('.projects-section');
    if (!projectsSection) return;

    const tabButtons = projectsSection.querySelectorAll('.projects-tabs .tab-button');
    const tabContents = projectsSection.querySelectorAll('.tab-content');

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetTab = button.getAttribute('data-tab');

        // Update active button (only within projects section)
        tabButtons.forEach((btn) => {
          btn.classList.remove('tab-active');
        });
        button.classList.add('tab-active');

        // Update active content (only within projects section)
        tabContents.forEach((content) => {
          content.classList.remove('tab-content-active');
          if (content.getAttribute('data-tab-content') === targetTab) {
            content.classList.add('tab-content-active');
          }
        });
      });
    });
  });
</script>

<style>
  .projects-section {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    min-height: 0;
  }

  .projects-tabs {
    display: flex;
    gap: 0;
    margin-bottom: -1px;
    border-bottom: 1px solid var(--border);
    z-index: 5;
  }

  .tab-button {
    background: transparent;
    border: none;
    padding: var(--space-xs) var(--default-padding);
    font-size: var(--fs--1);
    line-height: 1;
    font-weight: 400;
    cursor: pointer;
    border-top: 1px solid var(--border);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: all 0.2s ease;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tab-button.tab-active {
    background-color: var(--text);
    color: var(--bg);
    border-bottom-color: var(--border);
  }

  .tab-content {
    display: none;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .tab-content.tab-content-active {
    display: flex;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow-y: auto;
    scroll-snap-type: y proximity;
    scroll-behavior: smooth;
    flex: 1;
    min-height: 0;
  }

  /* Mobile: stack everything */
  @media (max-width: 799px) {
    .projects-section {
      display: block;
      height: auto;
    }

    .tab-content.tab-content-active {
      display: block;
    }

    .projects-list {
      overflow: visible;
      height: auto;
      flex: none;
    }
  }
</style>

