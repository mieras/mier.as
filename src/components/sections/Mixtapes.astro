---
import { getRecentCloudcasts } from '../../lib/mixcloud';

const mixcloudUsername = import.meta.env.PUBLIC_MIXCLOUD_USERNAME || 'mieras';

let mixtapes: any[] = [];
let hasError = false;

try {
  mixtapes = await getRecentCloudcasts(mixcloudUsername, 5);
} catch (error) {
  console.error('Error fetching Mixcloud data:', error);
  hasError = true;
}

// Helper function to format relative time
function getRelativeTime(dateString: string): string {
  if (!dateString) return '';
  
  try {
    const now = new Date();
    const uploadDate = new Date(dateString);
    const diffMs = now.getTime() - uploadDate.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);
    
    if (diffMins < 1) return 'zojuist geüpload';
    if (diffMins < 60) return `${diffMins} min geleden geüpload`;
    if (diffHours < 24) return `${diffHours} uur geleden geüpload`;
    if (diffDays === 1) return 'gisteren geüpload';
    if (diffDays < 7) return `${diffDays} dagen geleden geüpload`;
    if (diffDays < 30) {
      const weeks = Math.floor(diffDays / 7);
      return `${weeks} ${weeks === 1 ? 'week' : 'weken'} geleden geüpload`;
    }
    if (diffDays < 365) {
      const months = Math.floor(diffDays / 30);
      return `${months} ${months === 1 ? 'maand' : 'maanden'} geleden geüpload`;
    }
    const years = Math.floor(diffDays / 365);
    return `${years} ${years === 1 ? 'jaar' : 'jaren'} geleden geüpload`;
  } catch (error) {
    return '';
  }
}
---

<div class="mixtapes">
  {mixtapes.length > 0 ? (
    <ul class="mixtapes-list">
      {mixtapes.map((mixtape, index) => {
        const thumbnail = mixtape.thumbnail;
        const mixcloudId = mixtape.mixcloudId;
        const genres = mixtape.genres || [];
        
        return (
          <li class="mixtape-item" data-mixcloud-id={mixcloudId} data-index={index}>
            <div class="mixtape-content">
              <div class="mixtape-header">
                {thumbnail && (
                  <div class="mixtape-thumb">
                    <img 
                      src={thumbnail} 
                      alt={mixtape.name || 'Mixtape thumbnail'}
                      loading="lazy"
                    />
                  </div>
                )}
                <button class="mixtape-play-btn" aria-label={`Play ${mixtape.name}`} data-mixcloud-id={mixcloudId} data-action="play">
                  <svg class="play-icon" width="20" height="20" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 2.5v11l9-5.5-9-5.5z"/>
                  </svg>
                  <svg class="pause-icon" width="20" height="20" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="display: none;">
                    <path d="M3 2.5h3v11H3V2.5zm7 0h3v11h-3V2.5z"/>
                  </svg>
                </button>
              </div>
              <div class="mixtape-info">
                <h4 class="mixtape-title">{mixtape.name}</h4>
                {genres.length > 0 && (
                  <div class="mixtape-genres">
                    {genres.map((genre: string) => (
                      <span class="mixtape-genre">{genre}</span>
                    ))}
                  </div>
                )}
                {mixtape.createdTime && (
                  <span class="mixtape-date">
                    {getRelativeTime(mixtape.createdTime)}
                  </span>
                )}
              </div>
            </div>
            <div class="mixtape-player-embed" data-mixcloud-id={mixcloudId} style="display: none;">
              <iframe
                class="mixtape-iframe"
                width="100%"
                height="60"
                src=""
                frameborder="0"
                allow="encrypted-media; fullscreen; autoplay; idle-detection; speaker-selection; web-share;"
              ></iframe>
            </div>
          </li>
        );
      })}
    </ul>
  ) : hasError ? (
    <p class="no-mixtapes">Error loading mixtapes</p>
  ) : (
    <p class="no-mixtapes">No mixtapes available</p>
  )}
</div>


<script>
  // Handle mixtape play/embed toggle - player appears below item content
  document.addEventListener('DOMContentLoaded', () => {
    const mixtapeItems = document.querySelectorAll('.mixtape-item');
    let currentlyPlaying: HTMLElement | null = null;
    
    // Close all players and reset buttons
    const closeAllPlayers = () => {
      mixtapeItems.forEach((item) => {
        const playerEmbed = item.querySelector('.mixtape-player-embed') as HTMLElement;
        const playButton = item.querySelector('.mixtape-play-btn') as HTMLElement;
        const iframe = item.querySelector('.mixtape-iframe') as HTMLIFrameElement;
        const playIcon = playButton?.querySelector('.play-icon') as HTMLElement;
        const pauseIcon = playButton?.querySelector('.pause-icon') as HTMLElement;
        
        if (playerEmbed) playerEmbed.style.display = 'none';
        if (iframe) iframe.src = '';
        if (playButton) {
          playButton.setAttribute('data-active', 'false');
          playButton.setAttribute('data-action', 'play');
        }
        if (playIcon) playIcon.style.display = 'block';
        if (pauseIcon) pauseIcon.style.display = 'none';
      });
      currentlyPlaying = null;
    };
    
    // Handle play button clicks
    mixtapeItems.forEach((item) => {
      const playButton = item.querySelector('.mixtape-play-btn') as HTMLElement;
      const playerEmbed = item.querySelector('.mixtape-player-embed') as HTMLElement;
      const iframe = item.querySelector('.mixtape-iframe') as HTMLIFrameElement;
      const mixcloudId = item.getAttribute('data-mixcloud-id');
      const playIcon = playButton?.querySelector('.play-icon') as HTMLElement;
      const pauseIcon = playButton?.querySelector('.pause-icon') as HTMLElement;
      
      if (!playButton || !playerEmbed || !iframe || !mixcloudId) return;
      
      playButton.addEventListener('click', () => {
        const isActive = playButton.getAttribute('data-active') === 'true';
        const action = playButton.getAttribute('data-action');
        
        if (isActive && action === 'pause') {
          // Pause - stop embed
          iframe.src = '';
          playerEmbed.style.display = 'none';
          playButton.setAttribute('data-active', 'false');
          playButton.setAttribute('data-action', 'play');
          if (playIcon) playIcon.style.display = 'block';
          if (pauseIcon) pauseIcon.style.display = 'none';
          currentlyPlaying = null;
        } else if (isActive && action === 'play') {
          // Resume - show embed again
          iframe.src = `https://player-widget.mixcloud.com/widget/iframe/?hide_cover=1&mini=1&autoplay=1&feed=%2F${mixcloudId}%2F`;
          playerEmbed.style.display = 'block';
          playButton.setAttribute('data-action', 'pause');
          if (playIcon) playIcon.style.display = 'none';
          if (pauseIcon) pauseIcon.style.display = 'block';
        } else {
          // Play new - close any other players first
          if (currentlyPlaying && currentlyPlaying !== item) {
            closeAllPlayers();
          }
          
          // Open this player
          iframe.src = `https://player-widget.mixcloud.com/widget/iframe/?hide_cover=1&mini=1&autoplay=1&feed=%2F${mixcloudId}%2F`;
          playerEmbed.style.display = 'block';
          playButton.setAttribute('data-active', 'true');
          playButton.setAttribute('data-action', 'pause');
          if (playIcon) playIcon.style.display = 'none';
          if (pauseIcon) pauseIcon.style.display = 'block';
          currentlyPlaying = item as HTMLElement;
        }
      });
    });
  });
</script>

<style>
  .mixtapes {
    margin-bottom: var(--space-xl);
  }

  .mixtapes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    gap: var(--space-l);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .mixtapes-list::-webkit-scrollbar {
    height: 4px;
  }

  .mixtapes-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .mixtapes-list::-webkit-scrollbar-thumb {
    background: var(--clr-border);
    border-radius: 2px;
  }

  .mixtape-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 20rem;
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  .mixtape-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .mixtape-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
  }

  .mixtape-thumb {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--clr-thumb-bg);
    flex: 1;
  }

  .mixtape-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .mixtape-thumb:hover img {
    opacity: 0.8;
  }

  .mixtape-play-btn {
    background: transparent;
    border: 1px solid var(--clr-border);
    border-radius: 50%;
    width: 3rem;
    height: 3rem;
    min-width: 3rem;
    min-height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--clr-text);
    padding: 0;
    transition: all 0.3s ease;
    flex-shrink: 0;
    margin-top: 0;
  }

  .mixtape-play-btn:hover {
    background-color: var(--clr-button-hover-bg);
    color: var(--clr-button-hover-text);
  }

  .mixtape-play-btn[data-active="true"] {
    background-color: var(--clr-button-active-bg);
    color: var(--clr-button-active-text);
  }

  .mixtape-play-btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .mixtape-player-embed {
    width: 100%;
    margin-top: var(--space-s);
    background-color: var(--clr-thumb-bg);
  }

  .mixtape-iframe {
    width: 100%;
    height: 60px;
    border: none;
  }

  .mixtape-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .mixtape-title {
    font-size: var(--fs-0);
    font-weight: 400;
    margin: 0;
    line-height: 1.3;
  }

  .mixtape-date {
    font-size: var(--fs--2);
    opacity: 0.5;
    font-weight: 300;
    margin-top: var(--space-2xs);
  }

  .mixtape-genres {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  .mixtape-genre {
    font-size: var(--fs--2);
    opacity: 0.6;
    font-weight: 300;
    padding: var(--space-3xs) var(--space-2xs);
    background-color: var(--clr-genre-bg);
    color: var(--clr-genre-text);
    border-radius: 0.125rem;
  }

  .no-mixtapes {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
  }

</style>

