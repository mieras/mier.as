---
import { getRecentlyPlayed } from '../../../lib/lastfm';
import { getRelativeTimeLastFm } from '../../../lib/music-helpers';
import MusicItem from './ui/MusicItem.astro';

// Try server-side env vars first, fallback to PUBLIC_ for local dev
const lastfmUsername =
  import.meta.env.LASTFM_USERNAME ||
  import.meta.env.PUBLIC_LASTFM_USERNAME ||
  '';
const lastfmApiKey =
  import.meta.env.LASTFM_API_KEY || import.meta.env.PUBLIC_LASTFM_API_KEY || '';

let tracks: any[] = [];
let error: string | null = null;

if (lastfmUsername && lastfmApiKey) {
  try {
    tracks = await getRecentlyPlayed(lastfmUsername, lastfmApiKey, 5);
  } catch (e) {
    error = e instanceof Error ? e.message : 'Failed to fetch tracks';
    console.error('Error fetching recently played:', e);
  }
} else {
  error = 'Last.fm credentials not configured';
}
---

<div class="recently-played" data-tab="now-listening">
  {
    error ? (
      <div class="error-state">
        <p class="no-tracks">Error loading tracks: {error}</p>
      </div>
    ) : tracks.length === 0 ? (
      <div class="content-state">
        <p class="no-tracks">No recent tracks available</p>
      </div>
    ) : (
      <div class="content-state">
        <div class="swiper music-swiper recently-played-swiper">
          <div class="swiper-wrapper">
            {[...tracks, ...tracks].map((track, index) => {
              const artist = track.artist?.['#text'] || 'Unknown Artist';
              const song = track.name || '';
              const timestamp = track.date
                ? getRelativeTimeLastFm(track.date['#text'], track.date.uts)
                : undefined;

              return (
                <div class="swiper-slide">
                  <MusicItem
                    variant="ticker-thumbnail"
                    thumbnail={track.imageUrl}
                    line1={artist}
                    line2={song}
                    timestamp={timestamp}
                  />
                </div>
              );
            })}
          </div>
          <div class="swiper-pagination" />
        </div>
      </div>
    )
  }
</div>

<script>
  import { initSwiper, musicTickerPreset } from '../../../lib/swiper-utils';

  let initialized = false;

  function initRecentlyPlayedSwiper() {
    if (initialized) return;

    const container = document.querySelector(
      '[data-tab="now-listening"]',
    ) as HTMLElement;
    if (!container) {
      // Retry if container not found (server island might not be loaded yet)
      setTimeout(initRecentlyPlayedSwiper, 100);
      return;
    }

    const swiperEl = container.querySelector(
      '.recently-played-swiper',
    ) as HTMLElement;
    if (!swiperEl) {
      // Retry if swiper not found (server island might not be loaded yet)
      setTimeout(initRecentlyPlayedSwiper, 100);
      return;
    }

    // Wait for content to be loaded (server:defer might still be loading)
    const wrapper = swiperEl.querySelector('.swiper-wrapper');
    if (!wrapper || wrapper.children.length === 0) {
      // Content not loaded yet, retry
      setTimeout(initRecentlyPlayedSwiper, 100);
      return;
    }

    // Check if Swiper is already initialized
    if ((swiperEl as any).swiper) {
      initialized = true;
      return;
    }

    initialized = true;

    // Initialize Swiper now that content is loaded
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const swiper = initSwiper(swiperEl, musicTickerPreset, true);
        if (swiper) {
          requestAnimationFrame(() => {
            swiper.update();
            swiper.updateSize();
          });
        }
      });
    });
  }

  // Try to initialize Swiper - with multiple strategies
  const tryInitSwiper = () => {
    const container = document.querySelector(
      '[data-tab="now-listening"]',
    ) as HTMLElement;
    if (!container) {
      return false;
    }

    const swiperEl = container.querySelector(
      '.recently-played-swiper',
    ) as HTMLElement;
    if (!swiperEl) {
      return false;
    }

    const wrapper = swiperEl.querySelector('.swiper-wrapper');
    if (!wrapper || wrapper.children.length === 0) {
      return false;
    }

    // Check if already initialized
    if ((swiperEl as any).swiper) {
      initialized = true;
      return true;
    }

    // Initialize Swiper
    if (!initialized) {
      initialized = true;
      console.log('Initializing RecentlyPlayed Swiper with', wrapper.children.length, 'slides');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const swiper = initSwiper(swiperEl, musicTickerPreset, true);
          if (swiper) {
            console.log('RecentlyPlayed Swiper initialized successfully');
            requestAnimationFrame(() => {
              swiper.update();
              swiper.updateSize();
            });
          }
        });
      });
      return true;
    }

    return false;
  };

  // Use MutationObserver to detect when server island content is added
  const observeForContent = () => {
    const container = document.querySelector(
      '[data-tab="now-listening"]',
    ) as HTMLElement;
    if (!container) {
      setTimeout(observeForContent, 100);
      return;
    }

    // Try immediately
    if (tryInitSwiper()) {
      return;
    }

    const observer = new MutationObserver(() => {
      if (tryInitSwiper()) {
        observer.disconnect();
      }
    });

    observer.observe(container, {
      childList: true,
      subtree: true,
      attributes: true,
    });

    // Also use interval as fallback
    let attempts = 0;
    const intervalId = setInterval(() => {
      attempts++;
      if (tryInitSwiper() || attempts > 50) {
        clearInterval(intervalId);
        observer.disconnect();
      }
    }, 100);

    // Cleanup after 10 seconds
    setTimeout(() => {
      clearInterval(intervalId);
      observer.disconnect();
    }, 10000);
  };

  // Try to initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', observeForContent);
  } else {
    observeForContent();
  }

  document.addEventListener('astro:page-load', () => {
    initialized = false;
    observeForContent();
  });
</script>

<style>
  .recently-played {
    position: relative;
    /* min-height: 200px; */
  }

  .error-state {
    padding: var(--space-m);
  }

  .content-state {
    width: 100%;
  }

  .recently-played-swiper {
    width: 100%;
  }

  .recently-played-swiper .swiper-slide {
    width: auto;
    height: auto;
  }

  .recently-played-swiper .swiper-slide .ticker-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    white-space: nowrap;
    height: 100%;
  }

  .recently-played-swiper .swiper-slide .ticker-item {
    border-right-color: color-mix(in srgb, var(--border) 10%, transparent);
  }

  .recently-played-swiper .swiper-pagination {
    position: relative;
    text-align: center;
  }

  .recently-played-swiper .swiper-pagination-bullet {
    background: var(--text);
    opacity: 0.3;
  }

  .recently-played-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .no-tracks {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
    text-align: center;
    padding: var(--space-m);
  }
</style>
