---
import MusicItem from './ui/MusicItem.astro';
import { getRelativeTime } from '../../../lib/music-helpers';

let recentTracks: any[] = [];
let hasError = false;

try {
  // Use Astro.url to construct absolute URL for SSR
  const apiUrl = new URL('/api/music.json', Astro.url.origin);
  const apiRes = await fetch(apiUrl);
  
  if (!apiRes.ok) {
    throw new Error(`API returned ${apiRes.status}`);
  }
  
  const { items } = await apiRes.json();
  
  // Filter for lastfm items only
  recentTracks = items.filter((item: any) => item.source === 'lastfm');
} catch (error) {
  console.error('Error fetching music data:', error);
  hasError = true;
}
---

<div class="recently-played">
  {
    recentTracks.length > 0 ? (
      <div class="swiper music-swiper recently-played-swiper">
        <div class="swiper-wrapper">
          {recentTracks.map((track) => {
            const artist = track.artist || 'Unknown Artist';
            const song = track.track || '';
            const timestamp = track.date
              ? getRelativeTime(track.date)
              : undefined;

            return (
              <div class="swiper-slide">
                <MusicItem
                  thumbnail={track.thumb}
                  line1={artist}
                  line2={song}
                  timestamp={timestamp}
                  variant="ticker-thumbnail"
                />
              </div>
            );
          })}
          {/* Duplicate for seamless loop */}
          {recentTracks.map((track) => {
            const artist = track.artist || 'Unknown Artist';
            const song = track.track || '';
            const timestamp = track.date
              ? getRelativeTime(track.date)
              : undefined;

            return (
              <div class="swiper-slide">
                <MusicItem
                  thumbnail={track.thumb}
                  line1={artist}
                  line2={song}
                  timestamp={timestamp}
                  variant="ticker-thumbnail"
                />
              </div>
            );
          })}
        </div>
        <div class="swiper-pagination" />
      </div>
    ) : hasError ? (
      <p class="no-tracks">Error loading tracks</p>
    ) : (
      <p class="no-tracks">No recent tracks available</p>
    )
  }
</div>

<style>
  .recently-played-swiper {
    width: 100%;
  }

  .recently-played-swiper .swiper-slide {
    width: auto;
    height: auto;
  }

  .recently-played-swiper .swiper-slide .ticker-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    white-space: nowrap;
    height: 100%;
  }

  .recently-played-swiper .swiper-slide .ticker-item {
    border-right-color: color-mix(in srgb, var(--border) 10%, transparent);
  }

  .recently-played-swiper .swiper-pagination {
    position: relative;

    text-align: center;
  }

  .recently-played-swiper .swiper-pagination-bullet {
    background: var(--text);
    opacity: 0.3;
  }

  .recently-played-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .no-tracks {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
  }
</style>
