---
import MusicItem from './ui/MusicItem.astro';
import { getRelativeTime } from '../../../lib/music-helpers';

let recentTracks: any[] = [];
let hasError = false;
let isLoading = true;

try {
  // Use Astro.url to construct absolute URL for SSR
  const apiUrl = new URL('/api/music.json', Astro.url.origin);
  const apiRes = await fetch(apiUrl);
  
  if (!apiRes.ok) {
    throw new Error(`API returned ${apiRes.status}`);
  }
  
  const { items } = await apiRes.json();
  
  // Filter for lastfm items only
  recentTracks = items.filter((item: any) => item.source === 'lastfm');
  isLoading = false;
} catch (error) {
  console.error('Error fetching music data:', error);
  hasError = true;
  isLoading = false;
}
---

<div class="recently-played">
  {isLoading ? (
    <!-- Skeleton loading state -->
    <div class="swiper music-swiper recently-played-swiper">
      <div class="swiper-wrapper">
        {[1, 2, 3, 4, 5].map(() => (
          <div class="swiper-slide">
            <div class="ticker-item skeleton-item">
              <div class="skeleton-thumbnail"></div>
              <div class="skeleton-content">
                <div class="skeleton-line"></div>
                <div class="skeleton-line skeleton-line-short"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="swiper-button-next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 11V13H15V14H14V15H13V16H12V17H11V18H10V19H9V20H8V19H7V18H8V17H9V16H10V15H11V14H12V13H13V11H12V10H11V9H10V8H9V7H8V6H7V5H8V4H9V5H10V6H11V7H12V8H13V9H14V10H15V11H16Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="swiper-button-prev">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 13H12V14H13V15H14V16H15V17H16V18H17V19H16V20H15V19H14V18H13V17H12V16H11V15H10V14H9V13H8V11H9V10H10V9H11V8H12V7H13V6H14V5H15V4H16V5H17V6H16V7H15V8H14V9H13V10H12V11H11V13Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="swiper-pagination" />
    </div>
  ) : recentTracks.length > 0 ? (
    <div class="swiper music-swiper recently-played-swiper">
      <div class="swiper-wrapper">
        {recentTracks.map((track) => {
          const artist = track.artist || 'Unknown Artist';
          const song = track.track || '';
          const timestamp = track.date
            ? getRelativeTime(track.date)
            : undefined;

          return (
            <div class="swiper-slide">
              <MusicItem
                thumbnail={track.thumb}
                line1={artist}
                line2={song}
                timestamp={timestamp}
                variant="ticker-thumbnail"
              />
            </div>
          );
        })}
      </div>
      <div class="swiper-button-next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 11V13H15V14H14V15H13V16H12V17H11V18H10V19H9V20H8V19H7V18H8V17H9V16H10V15H11V14H12V13H13V11H12V10H11V9H10V8H9V7H8V6H7V5H8V4H9V5H10V6H11V7H12V8H13V9H14V10H15V11H16Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="swiper-button-prev">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 13H12V14H13V15H14V16H15V17H16V18H17V19H16V20H15V19H14V18H13V17H12V16H11V15H10V14H9V13H8V11H9V10H10V9H11V8H12V7H13V6H14V5H15V4H16V5H17V6H16V7H15V8H14V9H13V10H12V11H11V13Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="swiper-pagination" />
    </div>
  ) : hasError ? (
    <p class="no-tracks">Error loading tracks</p>
  ) : (
    <p class="no-tracks">No recent tracks available</p>
  )}
</div>

<style>
  .recently-played-swiper {
    width: 100%;
  }

  .recently-played-swiper .swiper-slide {
    width: auto;
    height: auto;
  }

  .recently-played-swiper {
    position: relative;
    padding: 0 var(--space-s);
  }

  .recently-played-swiper .swiper-slide .ticker-item {
    display: flex;
    gap: 11px;
    align-items: center;
    padding: 0;
    background: transparent;
    border: none;
    white-space: nowrap;
    height: auto;
    min-width: 256px;
  }

  .recently-played-swiper .swiper-pagination {
    position: relative;

    text-align: center;
  }

  .recently-played-swiper .swiper-pagination-bullet {
    background: var(--text);
    opacity: 0.3;
  }

  .recently-played-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .no-tracks {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
  }

  /* Navigation arrows - chevron style met backdrop blur */
  .recently-played-swiper .swiper-button-next,
  .recently-played-swiper .swiper-button-prev {
    color: #ffffff;
    width: auto;
    height: auto;
    margin-top: 0;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(6.4px);
    border-radius: 999px;
    padding: 6.4px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }

  .recently-played-swiper .swiper-button-prev {
    left: 0;
    mix-blend-mode: exclusion;
  }

  .recently-played-swiper .swiper-button-next {
    right: 0;
    mix-blend-mode: difference;
  }

  .recently-played-swiper .swiper-button-next::after,
  .recently-played-swiper .swiper-button-prev::after {
    display: none;
  }

  .recently-played-swiper .swiper-button-next svg,
  .recently-played-swiper .swiper-button-prev svg {
    width: 15.36px;
    height: 15.36px;
    fill: #ffffff;
  }

  /* Skeleton styles */
  .skeleton-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    height: 100%;
  }

  .skeleton-thumbnail {
    width: 48px;
    height: 48px;
    background: var(--border);
    border-radius: var(--radius-small);
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
  }

  .skeleton-line {
    height: 14px;
    background: var(--border);
    border-radius: 2px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-line-short {
    width: 60%;
  }

  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>
