---
type Props = {
  thumbnail?: string;
  line1: string; // Regel 1 (artist, title, etc.)
  line2?: string; // Regel 2 (track, album, genres, etc.)
  timestamp?: string;
  variant?: 'ticker-text' | 'ticker-thumbnail' | 'list';
  showPlayButton?: boolean;
  mixcloudId?: string;
  genres?: string[]; // Voor genres als pills (regel 2)
};

const {
  thumbnail,
  line1,
  line2,
  genres,
  timestamp,
  variant = 'list',
  showPlayButton = false,
  mixcloudId,
} = Astro.props;

const isTicker = variant === 'ticker-text' || variant === 'ticker-thumbnail';
const hasThumbnail = variant === 'ticker-thumbnail' || variant === 'list';
---

{
  isTicker ? (
    <div class="ticker-item">
      {hasThumbnail && thumbnail && (
        <div class="ticker-thumb-container">
          <img src={thumbnail} alt={line1} class="music-thumb" loading="lazy" />
          {showPlayButton && (
            <button
              class="music-play-btn ticker-play-btn"
              aria-label={`Play ${line1}`}
              data-mixcloud-id={mixcloudId}
              data-action="play"
              data-active="false"
            >
              <svg
                class="play-icon"
                width="20"
                height="20"
                viewBox="0 0 16 16"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M3 2.5v11l9-5.5-9-5.5z" />
              </svg>
              <svg
                class="pause-icon"
                width="20"
                height="20"
                viewBox="0 0 16 16"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
                style="display: none;"
              >
                <path d="M3 2.5h3v11H3V2.5zm7 0h3v11h-3V2.5z" />
              </svg>
            </button>
          )}
        </div>
      )}
      <div class="music-info">
        <span class="music-line1">{line1}</span>
        {line2 && <span class="music-line2">{line2}</span>}
        {timestamp && <span class="music-timestamp">{timestamp}</span>}
      </div>
    </div>
  ) : (
    <div class="music-item-wrapper">
      <div class="music-item">
        {thumbnail && (
          <div class="music-thumb-container">
            <img
              src={thumbnail}
              alt={line1}
              class="music-thumb"
              loading="lazy"
            />
            {showPlayButton && (
              <button
                class="music-play-btn"
                aria-label={`Play ${line1}`}
                data-mixcloud-id={mixcloudId}
                data-action="play"
                data-active="false"
              >
                <svg
                  class="play-icon"
                  width="20"
                  height="20"
                  viewBox="0 0 16 16"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M3 2.5v11l9-5.5-9-5.5z" />
                </svg>
                <svg
                  class="pause-icon"
                  width="20"
                  height="20"
                  viewBox="0 0 16 16"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                  style="display: none;"
                >
                  <path d="M3 2.5h3v11H3V2.5zm7 0h3v11h-3V2.5z" />
                </svg>
              </button>
            )}
          </div>
        )}
        <div class="music-info">
          <div class="music-line1-container">
            {showPlayButton && (
              <button
                class="music-play-btn-inline"
                aria-label={`Play ${line1}`}
                data-mixcloud-id={mixcloudId}
                data-action="play"
                data-active="false"
              >
                <svg
                  class="play-icon"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M3 2.5v11l9-5.5-9-5.5z" />
                </svg>
                <svg
                  class="pause-icon"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="currentColor"
                  xmlns="http://www.w3.org/2000/svg"
                  style="display: none;"
                >
                  <path d="M3 2.5h3v11H3V2.5zm7 0h3v11h-3V2.5z" />
                </svg>
              </button>
            )}
            <h4 class="music-line1">{line1}</h4>
          </div>
          {genres && genres.length > 0 ? (
            <div class="music-genres">
              {genres.map((genre) => (
                <span class="music-genre">{genre}</span>
              ))}
            </div>
          ) : line2 ? (
            <div class="music-line2">{line2}</div>
          ) : null}
          {timestamp && <span class="music-timestamp">{timestamp}</span>}
        </div>
      </div>
      {mixcloudId && (
        <div
          class="music-player-embed"
          data-mixcloud-id={mixcloudId}
          style="display: none;"
        >
          <iframe
            class="music-iframe"
            width="100%"
            height="60"
            src=""
            frameborder="0"
            allow="encrypted-media; fullscreen; autoplay; idle-detection; speaker-selection; web-share;"
          />
        </div>
      )}
    </div>
  )
}

<style>
  /* Ticker variants */
  .ticker-item {
    flex-shrink: 0;
    padding: var(--space-s) var(--space-m);
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    white-space: nowrap;
    overflow: hidden;
  }

  .ticker-thumb-container {
    position: relative;
    width: calc(2rem + var(--space-s));
    height: calc(2rem + var(--space-s));
    flex-shrink: 0;
    border-radius: var(--space-3xs);
    overflow: hidden;
  }

  .ticker-item .music-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    border-radius: var(--space-3xs);
  }

  .ticker-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 2.5rem;
    height: 2.5rem;
    min-width: 2.5rem;
    min-height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 10;
    opacity: 0;
  }

  .ticker-thumb-container:hover .ticker-play-btn {
    opacity: 1;
  }

  .ticker-play-btn:hover {
    background-color: var(--tile-hover);
  }

  .ticker-play-btn .play-icon,
  .ticker-play-btn .pause-icon {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .ticker-item .music-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
    min-width: 0;
    padding-block: 0;
  }

  .ticker-item .music-line1 {
    font-size: var(--fs--3);
    font-weight: 600;
    line-height: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    color: var(--text-light);
  }

  .music-mixcloud-icon-btn {
    background: transparent;
    border: none;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    color: var(--text-light);
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .music-mixcloud-icon-btn:hover {
    opacity: 1;
  }

  .music-mixcloud-icon-btn svg {
    width: 100%;
    height: 100%;
  }

  .ticker-item .music-line2 {
    font-size: var(--fs--2);
    font-weight: 500;
    line-height: 1.2;
    color: var(--text-light);
  }

  .ticker-item .music-timestamp {
    font-family: var(--font-mono);
    font-size: var(--fs--3);
    font-weight: 500;
    line-height: 1.2;
    color: var(--text-light-secondary);
  }

  /* List variant */
  .music-item-wrapper {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .music-item {
    display: flex;
    flex-direction: row;
    gap: var(--space-xs);
    min-height: 100%;
    height: 100%;
  }

  .music-player-embed {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .music-iframe {
    width: 100%;
    height: 60px;
    border: none;
  }

  .music-thumb-container {
    position: relative;
    width: 5rem;
    height: 5rem;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    flex-shrink: 0;
  }

  .music-thumb-container .music-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .music-thumb-container:hover .music-thumb {
    opacity: 0.8;
  }

  .music-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: transparent;
    aspect-ratio: 1 / 1;
    /* border: 1px solid var(--border); */
    border-radius: 50%;
    width: 100%;
    height: 100%;
    min-width: 3rem;
    min-height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 10;
  }

  .music-play-btn:hover {
    background-color: var(--tile-hover);
  }

  .music-play-btn .play-icon,
  .music-play-btn .pause-icon {
    width: 1.2rem;
    height: 1.2rem;
    fill: currentColor;
  }

  .music-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    flex: 1;
    min-height: 0;
  }

  .music-line1-container {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .music-play-btn-inline {
    background: transparent;
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
  }

  .music-play-btn-inline .play-icon,
  .music-play-btn-inline .pause-icon {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .music-item .music-line1 {
    font-size: var(--fs--3);
    font-weight: 400;
    margin: 0;
    line-height: 1;
    flex: 1;
    color: var(--text-light);
  }

  .music-item .music-line2 {
    font-size: var(--fs--2);
    opacity: 0.7;
    font-weight: 300;
    line-height: 1;
    color: var(--text-light);
  }

  .music-item .music-timestamp {
    font-size: var(--fs--2);
    opacity: 0.6;
    font-weight: 300;
    color: var(--text-light-secondary);
  }

  .music-genres {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .music-genre {
    font-size: var(--fs--2);
    opacity: 0.6;
    font-weight: 300;
    padding: var(--space-3xs) var(--space-2xs);
    background-color: var(--text-light);
    color: var(--color-black);
    border-radius: var(--radius-small);
  }
</style>
