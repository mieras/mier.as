---
type Props = {
  thumbnail?: string;
  line1: string; // Artist / Title
  line2?: string; // Track / Album
  timestamp?: string;
  showPlayButton?: boolean;
  mixcloudId?: string;
  genres?: string[]; // Voor genres als pills
};

const {
  thumbnail,
  line1,
  line2,
  genres,
  timestamp,
  showPlayButton = false,
  mixcloudId,
} = Astro.props;
---

<div class="music-item">
  {
    thumbnail && (
      <div class="music-item__thumb">
        <img
          src={thumbnail}
          alt={line1}
          class="music-item__image"
          loading="lazy"
        />
        {showPlayButton && (
          <button
            class="music-item__play-btn"
            aria-label={`Play ${line1}`}
            data-mixcloud-id={mixcloudId}
            data-action="play"
            data-active="false"
          >
            <svg
              class="music-item__play-icon"
              width="20"
              height="20"
              viewBox="0 0 16 16"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M3 2.5v11l9-5.5-9-5.5z" />
            </svg>
            <svg
              class="music-item__pause-icon"
              width="20"
              height="20"
              viewBox="0 0 16 16"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              style="display: none;"
            >
              <path d="M3 2.5h3v11H3V2.5zm7 0h3v11h-3V2.5z" />
            </svg>
          </button>
        )}
      </div>
    )
  }
  <div class="music-item__info">
    <div class="music-item__header">
      {
        showPlayButton && (
          <button
            class="music-item__play-btn-inline"
            aria-label={`Play ${line1}`}
            data-mixcloud-id={mixcloudId}
            data-action="play"
            data-active="false"
          >
            <svg
              class="music-item__play-icon"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M3 2.5v11l9-5.5-9-5.5z" />
            </svg>
            <svg
              class="music-item__pause-icon"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              style="display: none;"
            >
              <path d="M3 2.5h3v11H3V2.5zm7 0h3v11h-3V2.5z" />
            </svg>
          </button>
        )
      }
      <span class="music-item__artist">{line1}</span>
    </div>
    {
      genres && genres.length > 0 ? (
        <div class="music-item__genres">
          {genres.map((genre) => (
            <span class="music-item__genre">{genre}</span>
          ))}
        </div>
      ) : line2 ? (
        <div class="music-item__track">{line2}</div>
      ) : null
    }
    {timestamp && <span class="music-item__meta">{timestamp}</span>}
  </div>
  {
    mixcloudId && (
      <div
        class="music-item__player"
        data-mixcloud-id={mixcloudId}
        style="display: none;"
      >
        <iframe
          class="music-item__iframe"
          width="100%"
          height="60"
          src=""
          frameborder="0"
          allow="encrypted-media; fullscreen; autoplay; idle-detection; speaker-selection; web-share;"
        />
      </div>
    )
  }
</div>

<style>
  .music-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-s);
  }

  .music-item__thumb {
    position: relative;
    width: 5rem;
    height: 5rem;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    flex-shrink: 0;
  }

  .music-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .music-item__thumb:hover .music-item__image {
    opacity: 0.8;
  }

  .music-item__play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: transparent;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    width: 100%;
    height: 100%;
    min-width: 3rem;
    min-height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 10;
  }

  .music-item__play-btn:hover {
    background-color: var(--tile-hover);
  }

  .music-item__play-btn .music-item__play-icon,
  .music-item__play-btn .music-item__pause-icon {
    width: 1.2rem;
    height: 1.2rem;
    fill: currentColor;
  }

  .music-item__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
    min-width: 0;
  }

  .music-item__header {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .music-item__play-btn-inline {
    background: transparent;
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
  }

  .music-item__play-btn-inline .music-item__play-icon,
  .music-item__play-btn-inline .music-item__pause-icon {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .music-item__artist {
    font-size: var(--fs--1);
    font-weight: 400;
    line-height: 100%;
    color: var(--text-light);
  }

  .music-item__track {
    font-size: var(--fs--2);
    font-weight: 400;
    line-height: 100%;
    color: var(--text-light);
  }

  .music-item__meta {
    font-family: var(--font-mono);
    font-size: var(--fs--3);
    font-weight: 400;
    line-height: 100%;
    color: var(--text-light-secondary);
  }

  .music-item__genres {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .music-item__genre {
    font-size: var(--fs--2);
    font-weight: 400;
    padding: var(--space-3xs) var(--space-2xs);
    background-color: var(--text-light);
    color: var(--color-black);
    border-radius: var(--radius-small);
    line-height: 100%;
  }

  .music-item__player {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .music-item__iframe {
    width: 100%;
    height: 60px;
    border: none;
  }
</style>
