---
import MusicItem from './ui/MusicItem.astro';
import { getRelativeTime } from '../../../lib/music-helpers';

let latestRecords: any[] = [];
let isLoading = true;

try {
  // Use Astro.url to construct absolute URL for SSR
  const apiUrl = new URL('/api/music.json', Astro.url.origin);
  const apiRes = await fetch(apiUrl);

  if (!apiRes.ok) {
    throw new Error(`API returned ${apiRes.status}`);
  }

  const { items } = await apiRes.json();

  // Filter for discogs items only
  latestRecords = items.filter((item: any) => item.source === 'discogs');
  isLoading = false;
} catch (error) {
  console.error('Error fetching music data:', error);
  isLoading = false;
}
---

<div class="latest-records">
  {isLoading ? (
    <!-- Skeleton loading state -->
    <ul class="music__list">
      {[1, 2, 3, 4, 5].map(() => (
        <li class="music-item skeleton-item">
          <div class="skeleton-thumbnail"></div>
          <div class="skeleton-content">
            <div class="skeleton-line"></div>
            <div class="skeleton-line skeleton-line-short"></div>
          </div>
        </li>
      ))}
    </ul>
  ) : latestRecords.length > 0 ? (
    <ul class="music__list">
      {latestRecords.map((record) => {
        const artist = record.artist || '';
        const albumYear = [record.title, record.year]
          .filter(Boolean)
          .join(' • ');
        const timestamp = record.date
          ? getRelativeTime(record.date)
          : undefined;

        return (
          <li>
            <MusicItem
              thumbnail={record.thumb}
              line1={artist}
              line2={albumYear}
              timestamp={timestamp}
              variant="list"
            />
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="no-records">No recent records available</p>
  )}
  <a class="music__source" href="https://discogs.com" target="_blank" rel="noopener">
    discogs.com
  </a>
</div>

<style>
  .latest-records {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .music__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-s);
    overflow-y: auto;
    flex: 1;
    min-height: 0;
  }

  .music-item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-s);
    align-items: center;
  }

  .music__source {
    display: inline-flex;
    margin-top: var(--space-s);
    opacity: 0.6;
    text-decoration: none;
    color: var(--text-light);
    font-size: var(--fs--2);
  }

  .music__source:hover {
    opacity: 0.9;
  }

  .no-records {
    font-size: var(--fs--2);
    opacity: 0.7;
    font-style: italic;
    color: var(--text-light);
  }

  /* Skeleton styles */
  .skeleton-item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-s);
    align-items: center;
  }

  .skeleton-thumbnail {
    width: 56px;
    height: 56px;
    background: var(--text-light-secondary);
    border-radius: 10px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
  }

  .skeleton-line {
    height: 14px;
    background: var(--text-light-secondary);
    border-radius: 2px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-line-short {
    width: 60%;
  }

  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }


  .latest-records-swiper .swiper-pagination {
    position: relative;
    /* margin-top: var(--space-s); */
    text-align: center;
  }

  .latest-records-swiper .swiper-pagination-bullet {
    background: var(--text);
    opacity: 0.3;
  }

  .latest-records-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .no-records {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
  }

  /* Navigation arrows */
  .latest-records-swiper .swiper-button-next,
  .latest-records-swiper .swiper-button-prev {
    color: #ffffff;
    width: 2rem;
    height: 2rem;
    margin-top: 0;
    top: 50%;
    transform: translateY(-50%);
    opacity: 1;
    transition: opacity 0.2s ease;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  .latest-records-swiper .swiper-button-next:hover,
  .latest-records-swiper .swiper-button-prev:hover {
    opacity: 0.9;
  }

  .latest-records-swiper .swiper-button-prev {
    left: var(--space-s);
  }

  .latest-records-swiper .swiper-button-next {
    right: var(--space-s);
  }

  .latest-records-swiper .swiper-button-next::after,
  .latest-records-swiper .swiper-button-prev::after {
    display: none;
  }

  .latest-records-swiper .swiper-button-next svg,
  .latest-records-swiper .swiper-button-prev svg {
    width: 1rem;
    height: 1rem;
  }

  /* Skeleton styles */
  .skeleton-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    height: 100%;
  }

  .skeleton-thumbnail {
    width: 48px;
    height: 48px;
    background: var(--border);
    border-radius: var(--radius-small);
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
  }

  .skeleton-line {
    height: 14px;
    background: var(--border);
    border-radius: 2px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-line-short {
    width: 60%;
  }

  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>
