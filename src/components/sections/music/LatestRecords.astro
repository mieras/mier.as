---
import MusicItem from './ui/MusicItem.astro';
import { getRelativeTime } from '../../../lib/music-helpers';

let latestRecords: any[] = [];
let isLoading = true;

try {
  // Use Astro.url to construct absolute URL for SSR
  const apiUrl = new URL('/api/music.json', Astro.url.origin);
  const apiRes = await fetch(apiUrl);

  if (!apiRes.ok) {
    throw new Error(`API returned ${apiRes.status}`);
  }

  const { items } = await apiRes.json();

  // Filter for discogs items only
  latestRecords = items.filter((item: any) => item.source === 'discogs');
  isLoading = false;
} catch (error) {
  console.error('Error fetching music data:', error);
  isLoading = false;
}
---

<div class="latest-records">
  {isLoading ? (
    <!-- Skeleton loading state -->
    <div class="swiper music-swiper latest-records-swiper">
      <div class="swiper-wrapper">
        {[1, 2, 3, 4, 5].map(() => (
          <div class="swiper-slide">
            <div class="ticker-item skeleton-item">
              <div class="skeleton-thumbnail"></div>
              <div class="skeleton-content">
                <div class="skeleton-line"></div>
                <div class="skeleton-line skeleton-line-short"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="swiper-button-next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 11V13H15V14H14V15H13V16H12V17H11V18H10V19H9V20H8V19H7V18H8V17H9V16H10V15H11V14H12V13H13V11H12V10H11V9H10V8H9V7H8V6H7V5H8V4H9V5H10V6H11V7H12V8H13V9H14V10H15V11H16Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="swiper-button-prev">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 13H12V14H13V15H14V16H15V17H16V18H17V19H16V20H15V19H14V18H13V17H12V16H11V15H10V14H9V13H8V11H9V10H10V9H11V8H12V7H13V6H14V5H15V4H16V5H17V6H16V7H15V8H14V9H13V10H12V11H11V13Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="swiper-pagination" />
    </div>
  ) : latestRecords.length > 0 ? (
    <div class="swiper music-swiper latest-records-swiper">
      <div class="swiper-wrapper">
        {latestRecords.map((record) => {
          const artist = record.artist || '';
          const albumYear = [record.title, record.year]
            .filter(Boolean)
            .join(' • ');
          const timestamp = record.date
            ? getRelativeTime(record.date)
            : undefined;

          return (
            <div class="swiper-slide">
              <MusicItem
                thumbnail={record.thumb}
                line1={artist}
                line2={albumYear}
                timestamp={timestamp}
                variant="ticker-thumbnail"
              />
            </div>
          );
        })}
      </div>
      <div class="swiper-button-next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 11V13H15V14H14V15H13V16H12V17H11V18H10V19H9V20H8V19H7V18H8V17H9V16H10V15H11V14H12V13H13V11H12V10H11V9H10V8H9V7H8V6H7V5H8V4H9V5H10V6H11V7H12V8H13V9H14V10H15V11H16Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="swiper-button-prev">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 13H12V14H13V15H14V16H15V17H16V18H17V19H16V20H15V19H14V18H13V17H12V16H11V15H10V14H9V13H8V11H9V10H10V9H11V8H12V7H13V6H14V5H15V4H16V5H17V6H16V7H15V8H14V9H13V10H12V11H11V13Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="swiper-pagination" />
    </div>
  ) : (
    <p class="no-records">No recent records available</p>
  )}
</div>

<script>
  // Swiper initialization is now handled by MusicSection component
  // to ensure it only initializes when the tab is visible
</script>

<style>
  .latest-records-swiper {
    width: 100%;
  }

  .latest-records-swiper .swiper-slide {
    width: auto;
    height: auto;
  }

  .latest-records-swiper .swiper-slide .ticker-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    white-space: nowrap;
    height: 100%;
  }

  .latest-records-swiper .swiper-slide .ticker-item {
    border-right-color: color-mix(in srgb, var(--border) 10%, transparent);
  }

  .latest-records-swiper .swiper-pagination {
    position: relative;
    /* margin-top: var(--space-s); */
    text-align: center;
  }

  .latest-records-swiper .swiper-pagination-bullet {
    background: var(--text);
    opacity: 0.3;
  }

  .latest-records-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .no-records {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
  }

  /* Navigation arrows */
  .latest-records-swiper .swiper-button-next,
  .latest-records-swiper .swiper-button-prev {
    color: var(--text);
    width: 44px;
    height: 44px;
    margin-top: 0;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .latest-records-swiper .swiper-button-next:hover,
  .latest-records-swiper .swiper-button-prev:hover {
    opacity: 1;
  }

  .latest-records-swiper .swiper-button-prev {
    left: 0;
  }

  .latest-records-swiper .swiper-button-next {
    right: 0;
  }

  .latest-records-swiper .swiper-button-next::after,
  .latest-records-swiper .swiper-button-prev::after {
    display: none;
  }

  /* Skeleton styles */
  .skeleton-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    height: 100%;
  }

  .skeleton-thumbnail {
    width: 48px;
    height: 48px;
    background: var(--border);
    border-radius: var(--radius-small);
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
  }

  .skeleton-line {
    height: 14px;
    background: var(--border);
    border-radius: 2px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-line-short {
    width: 60%;
  }

  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>
