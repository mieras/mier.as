---
import MusicItem from './ui/MusicItem.astro';
import { getRelativeTime } from '../../../lib/music-helpers';

let latestRecords: any[] = [];
let isLoading = true;

try {
  // Use Astro.url to construct absolute URL for SSR
  const apiUrl = new URL('/api/music.json', Astro.url.origin);
  const apiRes = await fetch(apiUrl);

  if (!apiRes.ok) {
    throw new Error(`API returned ${apiRes.status}`);
  }

  const { items } = await apiRes.json();

  // Filter for discogs items only and limit to 5
  latestRecords = items.filter((item: any) => item.source === 'discogs').slice(0, 5);
  isLoading = false;
} catch (error) {
  console.error('Error fetching music data:', error);
  isLoading = false;
}
---

<div class="latest-records">
  {isLoading ? (
    <!-- Skeleton loading state -->
    <ul class="music__list">
      {[1, 2, 3, 4, 5].map(() => (
        <li class="skeleton-item">
          <div class="skeleton-thumbnail"></div>
          <div class="skeleton-content">
            <div class="skeleton-line"></div>
            <div class="skeleton-line skeleton-line-short"></div>
          </div>
        </li>
      ))}
    </ul>
  ) : latestRecords.length > 0 ? (
    <ul class="music__list">
      {latestRecords.map((record) => {
        const artist = record.artist || '';
        const albumYear = [record.title, record.year]
          .filter(Boolean)
          .join(' • ');
        const timestamp = record.date
          ? getRelativeTime(record.date)
          : undefined;

        return (
          <li>
            <MusicItem
              thumbnail={record.thumb}
              line1={artist}
              line2={albumYear}
              timestamp={timestamp}
            />
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="no-records">No recent records available</p>
  )}
  <a class="music__source" href="https://discogs.com" target="_blank" rel="noopener">
    discogs.com
  </a>
</div>

<style>
  .latest-records {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .music__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2xs);
    overflow-y: auto;
    flex: 1;
    min-height: 0;
  }

  .music__source {
    display: inline-flex;
    margin-top: var(--space-s);
    opacity: 0.6;
    text-decoration: none;
    color: var(--text-light);
    font-size: var(--fs--2);
  }

  .music__source:hover {
    opacity: 0.9;
  }

  .no-records {
    font-size: var(--fs--2);
    opacity: 0.7;
    font-style: italic;
    color: var(--text-light);
  }

  /* Skeleton styles */
  .skeleton-item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-s);
    align-items: center;
  }

  .skeleton-thumbnail {
    width: 56px;
    height: 56px;
    background: var(--text-light-secondary);
    border-radius: 10px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
  }

  .skeleton-line {
    height: 14px;
    background: var(--text-light-secondary);
    border-radius: 2px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-line-short {
    width: 60%;
  }

  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>
