---
import { getLatestRecords } from '../../../lib/discogs';
import MusicItem from './ui/MusicItem.astro';

const discogsUsername = import.meta.env.PUBLIC_DISCOGS_USERNAME || '';
const discogsToken = import.meta.env.PUBLIC_DISCOGS_TOKEN || '';

let latestRecords: any[] = [];

if (discogsUsername && discogsToken) {
  try {
    latestRecords = await getLatestRecords(discogsUsername, discogsToken, 5);
  } catch (error) {
    console.error('Error fetching Discogs data:', error);
  }
} else {
  console.warn(
    '⚠️ Discogs credentials not configured. Add PUBLIC_DISCOGS_USERNAME and PUBLIC_DISCOGS_TOKEN to .env',
  );
}

// Helper function to format relative time (similar to Last.fm)
function getRelativeTime(dateString?: string): string {
  if (!dateString) return '';

  try {
    const now = new Date();
    const addedDate = new Date(dateString);
    const diffMs = now.getTime() - addedDate.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    if (diffMins < 1) return 'zojuist toegevoegd';
    if (diffMins < 60) return `${diffMins} min geleden toegevoegd`;
    if (diffHours < 24) return `${diffHours} uur geleden toegevoegd`;
    if (diffDays === 1) return 'gisteren toegevoegd';
    if (diffDays < 7) return `${diffDays} dagen geleden toegevoegd`;
    if (diffDays < 30) {
      const weeks = Math.floor(diffDays / 7);
      return `${weeks} ${weeks === 1 ? 'week' : 'weken'} geleden toegevoegd`;
    }
    if (diffDays < 365) {
      const months = Math.floor(diffDays / 30);
      return `${months} ${months === 1 ? 'maand' : 'maanden'} geleden toegevoegd`;
    }
    const years = Math.floor(diffDays / 365);
    return `${years} ${years === 1 ? 'jaar' : 'jaren'} geleden toegevoegd`;
  } catch (error) {
    return '';
  }
}
---

<div class="latest-records">
  {
    latestRecords.length > 0 ? (
      <div class="swiper music-swiper latest-records-swiper">
        <div class="swiper-wrapper">
          {latestRecords.map((record) => {
            const artist = record.artist || '';
            const albumYear = [record.title, record.year]
              .filter(Boolean)
              .join(' • ');
            const timestamp = record.dateAdded
              ? getRelativeTime(record.dateAdded)
              : undefined;

            return (
              <div class="swiper-slide">
                <MusicItem
                  thumbnail={record.thumb}
                  line1={artist}
                  line2={albumYear}
                  timestamp={timestamp}
                  variant="ticker-thumbnail"
                />
              </div>
            );
          })}
          {/* Duplicate for seamless loop */}
          {latestRecords.map((record) => {
            const artist = record.artist || '';
            const albumYear = [record.title, record.year]
              .filter(Boolean)
              .join(' • ');
            const timestamp = record.dateAdded
              ? getRelativeTime(record.dateAdded)
              : undefined;

            return (
              <div class="swiper-slide">
                <MusicItem
                  thumbnail={record.thumb}
                  line1={artist}
                  line2={albumYear}
                  timestamp={timestamp}
                  variant="ticker-thumbnail"
                />
              </div>
            );
          })}
        </div>
        <div class="swiper-pagination" />
      </div>
    ) : (
      <p class="no-records">No recent records available</p>
    )
  }
</div>

<script>
  // Swiper initialization is now handled by MusicSection component
  // to ensure it only initializes when the tab is visible
</script>

<style>
  .latest-records-swiper {
    width: 100%;
  }

  .latest-records-swiper .swiper-slide {
    width: auto;
    height: auto;
  }

  .latest-records-swiper .swiper-slide .ticker-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    white-space: nowrap;
    height: 100%;
  }

  .latest-records-swiper .swiper-slide .ticker-item {
    border-right-color: color-mix(in srgb, var(--border) 10%, transparent);
  }

  .latest-records-swiper .swiper-pagination {
    position: relative;
    /* margin-top: var(--space-s); */
    text-align: center;
  }

  .latest-records-swiper .swiper-pagination-bullet {
    background: var(--text);
    opacity: 0.3;
  }

  .latest-records-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .no-records {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
  }
</style>
