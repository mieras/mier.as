---
import { getLatestRecords } from '../../../lib/discogs';
import { getRelativeTimeDiscogs } from '../../../lib/music-helpers';
import MusicItem from './ui/MusicItem.astro';

// Try server-side env vars first, fallback to PUBLIC_ for local dev
const discogsUsername =
  import.meta.env.DISCOGS_USERNAME ||
  import.meta.env.PUBLIC_DISCOGS_USERNAME ||
  '';
const discogsToken =
  import.meta.env.DISCOGS_TOKEN || import.meta.env.PUBLIC_DISCOGS_TOKEN || '';

let records: any[] = [];
let error: string | null = null;

if (discogsUsername && discogsToken) {
  try {
    records = await getLatestRecords(discogsUsername, discogsToken, 5);
  } catch (e) {
    error = e instanceof Error ? e.message : 'Failed to fetch records';
    console.error('Error fetching latest records:', e);
  }
} else {
  error = 'Discogs credentials not configured';
}
---

<div class="latest-records" data-tab="collections">
  {
    error ? (
      <div class="error-state">
        <p class="no-records">Error loading records: {error}</p>
      </div>
    ) : records.length === 0 ? (
      <div class="content-state">
        <p class="no-records">No recent records available</p>
      </div>
    ) : (
      <div class="content-state">
        <div class="swiper music-swiper latest-records-swiper">
          <div class="swiper-wrapper">
            {[...records, ...records].map((record, index) => {
              const artist = record.artist || 'Unknown Artist';
              const album = record.title || '';
              const albumYear = record.year ? `(${record.year})` : undefined;
              const timestamp = record.dateAdded
                ? getRelativeTimeDiscogs(record.dateAdded)
                : undefined;

              return (
                <div class="swiper-slide">
                  <MusicItem
                    variant="ticker-thumbnail"
                    thumbnail={record.thumb}
                    line1={artist}
                    line2={albumYear ? `${album} ${albumYear}` : album}
                    timestamp={timestamp}
                  />
                </div>
              );
            })}
          </div>
          <div class="swiper-pagination" />
        </div>
      </div>
    )
  }
</div>

<script>
  import { initSwiper, musicTickerPreset } from '../../../lib/swiper-utils';

  let initialized = false;

  function initLatestRecordsSwiper() {
    if (initialized) return;

    const container = document.querySelector(
      '[data-tab="collections"]',
    ) as HTMLElement;
    if (!container) {
      // Retry if container not found (server island might not be loaded yet)
      setTimeout(initLatestRecordsSwiper, 100);
      return;
    }

    const swiperEl = container.querySelector(
      '.latest-records-swiper',
    ) as HTMLElement;
    if (!swiperEl) {
      // Retry if swiper not found (server island might not be loaded yet)
      setTimeout(initLatestRecordsSwiper, 100);
      return;
    }

    // Wait for content to be loaded (server:defer might still be loading)
    const wrapper = swiperEl.querySelector('.swiper-wrapper');
    if (!wrapper || wrapper.children.length === 0) {
      // Content not loaded yet, retry
      setTimeout(initLatestRecordsSwiper, 100);
      return;
    }

    // Check if Swiper is already initialized
    if ((swiperEl as any).swiper) {
      initialized = true;
      return;
    }

    initialized = true;

    // Initialize Swiper now that content is loaded
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const swiper = initSwiper(swiperEl, musicTickerPreset, true);
        if (swiper) {
          requestAnimationFrame(() => {
            swiper.update();
            swiper.updateSize();
          });
        }
      });
    });
  }

  // Try to initialize Swiper - with multiple strategies
  const tryInitSwiper = () => {
    const container = document.querySelector(
      '[data-tab="collections"]',
    ) as HTMLElement;
    if (!container) {
      return false;
    }

    const swiperEl = container.querySelector(
      '.latest-records-swiper',
    ) as HTMLElement;
    if (!swiperEl) {
      return false;
    }

    const wrapper = swiperEl.querySelector('.swiper-wrapper');
    if (!wrapper || wrapper.children.length === 0) {
      return false;
    }

    // Check if already initialized
    if ((swiperEl as any).swiper) {
      initialized = true;
      return true;
    }

    // Initialize Swiper
    if (!initialized) {
      initialized = true;
      console.log(
        'Initializing LatestRecords Swiper with',
        wrapper.children.length,
        'slides',
      );
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const swiper = initSwiper(swiperEl, musicTickerPreset, true);
          if (swiper) {
            console.log('LatestRecords Swiper initialized successfully');
            requestAnimationFrame(() => {
              swiper.update();
              swiper.updateSize();
            });
          }
        });
      });
      return true;
    }

    return false;
  };

  // Use MutationObserver to detect when server island content is added
  const observeForContent = () => {
    const container = document.querySelector(
      '[data-tab="collections"]',
    ) as HTMLElement;
    if (!container) {
      setTimeout(observeForContent, 100);
      return;
    }

    // Try immediately
    if (tryInitSwiper()) {
      return;
    }

    const observer = new MutationObserver(() => {
      if (tryInitSwiper()) {
        observer.disconnect();
      }
    });

    observer.observe(container, {
      childList: true,
      subtree: true,
      attributes: true,
    });

    // Also use interval as fallback
    let attempts = 0;
    const intervalId = setInterval(() => {
      attempts++;
      if (tryInitSwiper() || attempts > 50) {
        clearInterval(intervalId);
        observer.disconnect();
      }
    }, 100);

    // Cleanup after 10 seconds
    setTimeout(() => {
      clearInterval(intervalId);
      observer.disconnect();
    }, 10000);
  };

  // Try to initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', observeForContent);
  } else {
    observeForContent();
  }

  document.addEventListener('astro:page-load', () => {
    initialized = false;
    observeForContent();
  });
</script>

<style>
  .latest-records {
    position: relative;
    /* min-height: 200px; */
  }

  .error-state {
    padding: var(--space-m);
  }

  .content-state {
    width: 100%;
  }

  .latest-records-swiper {
    width: 100%;
  }

  .latest-records-swiper .swiper-slide {
    width: auto;
    height: auto;
  }

  .latest-records-swiper .swiper-slide .ticker-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    white-space: nowrap;
    height: 100%;
  }

  .latest-records-swiper .swiper-slide .ticker-item {
    border-right-color: color-mix(in srgb, var(--border) 10%, transparent);
  }

  .latest-records-swiper .swiper-pagination {
    position: relative;
    text-align: center;
  }

  .latest-records-swiper .swiper-pagination-bullet {
    background: var(--text);
    opacity: 0.3;
  }

  .latest-records-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .no-records {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
    text-align: center;
    padding: var(--space-m);
  }
</style>
