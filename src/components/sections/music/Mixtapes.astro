---
import MusicItem from './ui/MusicItem.astro';
import { getRelativeTime } from '../../../lib/music-helpers';

let mixtapes: any[] = [];
let hasError = false;
let isLoading = true;

try {
  // Use Astro.url to construct absolute URL for SSR
  const apiUrl = new URL('/api/music.json', Astro.url.origin);
  const apiRes = await fetch(apiUrl);

  if (!apiRes.ok) {
    throw new Error(`API returned ${apiRes.status}`);
  }

  const { items } = await apiRes.json();

  // Filter for mixcloud items only
  mixtapes = items.filter((item: any) => item.source === 'mixcloud');
  isLoading = false;
} catch (error) {
  console.error('Error fetching music data:', error);
  hasError = true;
  isLoading = false;
}
---

<div class="mixtapes">
  {isLoading ? (
    <!-- Skeleton loading state -->
    <ul class="music__list">
      {[1, 2, 3, 4, 5].map(() => (
        <li class="music-item skeleton-item">
          <div class="skeleton-thumbnail"></div>
          <div class="skeleton-content">
            <div class="skeleton-line"></div>
            <div class="skeleton-line skeleton-line-short"></div>
          </div>
        </li>
      ))}
    </ul>
  ) : mixtapes.length > 0 ? (
    <>
      <ul class="music__list">
        {mixtapes.map((mixtape, index) => {
          const thumbnail = mixtape.thumb;
          const mixcloudId = mixtape.mixcloudId;
          const genres = mixtape.genres || [];
          const timestamp = mixtape.date
            ? getRelativeTime(mixtape.date)
            : undefined;
          const genresText =
            genres.length > 0 ? genres.join(', ') : undefined;

          return (
            <li
              class="mixtape-item"
              data-mixcloud-id={mixcloudId}
              data-index={index}
            >
              <MusicItem
                thumbnail={thumbnail}
                line1={mixtape.title}
                line2={genresText}
                timestamp={timestamp}
                variant="list"
                showPlayButton={true}
                mixcloudId={mixcloudId}
              />
            </li>
          );
        })}
      </ul>
      {/* Embed container */}
      <div class="mixtapes-embed-container" style="display: none;">
        <iframe
          class="mixtapes-embed-iframe"
          width="100%"
          height="100%"
          src=""
          frameborder="0"
          allow="encrypted-media; fullscreen; autoplay; idle-detection; speaker-selection; web-share;"
        />
        <button class="mixtapes-embed-close" aria-label="Close player">
          ×
        </button>
      </div>
    </>
  ) : hasError ? (
    <p class="no-mixtapes">Error loading mixtapes</p>
  ) : (
    <p class="no-mixtapes">No mixtapes available</p>
  )}
  <a class="music__source" href="https://mixcloud.com" target="_blank" rel="noopener">
    mixcloud.com
  </a>
</div>

<script>
  const handleEmbedOpen = (mixcloudId: string) => {
    const embedContainer = document.querySelector(
      '.mixtapes-embed-container',
    ) as HTMLElement;
    const embedIframe = document.querySelector(
      '.mixtapes-embed-iframe',
    ) as HTMLIFrameElement;

    if (!embedContainer || !embedIframe) return;

    // Toon embed
    embedContainer.style.display = 'flex';
    embedIframe.src = `https://player-widget.mixcloud.com/widget/iframe/?hide_cover=1&autoplay=1&feed=%2F${mixcloudId}%2F`;
  };

  const handleEmbedClose = () => {
    const embedContainer = document.querySelector(
      '.mixtapes-embed-container',
    ) as HTMLElement;
    const embedIframe = document.querySelector(
      '.mixtapes-embed-iframe',
    ) as HTMLIFrameElement;

    if (!embedContainer || !embedIframe) return;

    // Stop embed
    embedIframe.src = '';
    embedContainer.style.display = 'none';
  };

  const initEmbedHandlers = () => {
    const mixtapeItems = document.querySelectorAll('.mixtape-item');
    let currentlyPlaying: HTMLElement | null = null;

    // Close all players and reset buttons
    const closeAllPlayers = () => {
      mixtapeItems.forEach((item) => {
        const mixcloudIconBtn = item.querySelector(
          '.music-mixcloud-icon-btn',
        ) as HTMLElement;
        const playBtn = item.querySelector(
          '.music-play-btn, .ticker-play-btn',
        ) as HTMLElement;

        // Reset mixcloud icon button
        if (mixcloudIconBtn) {
          mixcloudIconBtn.setAttribute('data-active', 'false');
          mixcloudIconBtn.setAttribute('data-action', 'play');
        }

        // Reset play button on thumbnail
        if (playBtn) {
          playBtn.setAttribute('data-active', 'false');
          playBtn.setAttribute('data-action', 'play');
          const playIcon = playBtn.querySelector('.play-icon') as HTMLElement;
          const pauseIcon = playBtn.querySelector('.pause-icon') as HTMLElement;
          if (playIcon) playIcon.style.display = '';
          if (pauseIcon) pauseIcon.style.display = 'none';
        }
      });
      currentlyPlaying = null;
    };

    // Handle play button clicks (both mixcloud icon and thumbnail play button)
    mixtapeItems.forEach((item) => {
      const mixcloudIconBtn = item.querySelector(
        '.music-mixcloud-icon-btn',
      ) as HTMLElement;
      const playBtn = item.querySelector(
        '.music-play-btn, .ticker-play-btn',
      ) as HTMLElement;
      const mixcloudId = item.getAttribute('data-mixcloud-id');

      if (!mixcloudId) return;

      const handlePlayClick = (button: HTMLElement) => {
        const isActive = button.getAttribute('data-active') === 'true';
        const action = button.getAttribute('data-action');

        if (isActive && action === 'pause') {
          // Pause - close embed
          handleEmbedClose();
          closeAllPlayers();
        } else {
          // Play new - close any other players first
          if (currentlyPlaying && currentlyPlaying !== item) {
            closeAllPlayers();
            handleEmbedClose();
          }

          // Open embed
          handleEmbedOpen(mixcloudId);

          // Update button state
          button.setAttribute('data-active', 'true');
          button.setAttribute('data-action', 'pause');
          
          // Update play/pause icons
          const playIcon = button.querySelector('.play-icon') as HTMLElement;
          const pauseIcon = button.querySelector('.pause-icon') as HTMLElement;
          if (playIcon) playIcon.style.display = 'none';
          if (pauseIcon) pauseIcon.style.display = '';

          currentlyPlaying = item as HTMLElement;
        }
      };

      // Handle mixcloud icon button
      if (mixcloudIconBtn) {
        mixcloudIconBtn.addEventListener('click', () => handlePlayClick(mixcloudIconBtn));
      }

      // Handle play button on thumbnail
      if (playBtn) {
        playBtn.addEventListener('click', () => handlePlayClick(playBtn));
      }

      // Handle inline play button
      const inlinePlayBtn = item.querySelector(
        '.music-play-btn-inline',
      ) as HTMLElement;
      if (inlinePlayBtn) {
        inlinePlayBtn.addEventListener('click', () => handlePlayClick(inlinePlayBtn));
      }
    });

    // Close button handler
    const closeButton = document.querySelector(
      '.mixtapes-embed-close',
    ) as HTMLElement;
    if (closeButton) {
      closeButton.addEventListener('click', () => {
        handleEmbedClose();
        closeAllPlayers();
      });
    }
  };

  // Initialize embed handlers on page load
  // Swiper initialization is handled by MusicSection component
  document.addEventListener('DOMContentLoaded', () => {
    initEmbedHandlers();
  });

  // Re-initialize embed handlers on Astro page load (for view transitions)
  document.addEventListener('astro:page-load', () => {
    initEmbedHandlers();
  });

  // Also initialize immediately if DOM is already loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initEmbedHandlers();
    });
  } else {
    initEmbedHandlers();
  }
</script>

<style>
  .mixtapes {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .music__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-s);
    overflow-y: auto;
    flex: 1;
    min-height: 0;
  }

  .music-item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-s);
    align-items: center;
  }

  .music__source {
    display: inline-flex;
    margin-top: var(--space-s);
    opacity: 0.6;
    text-decoration: none;
    color: var(--text-light);
    font-size: var(--fs--2);
  }

  .music__source:hover {
    opacity: 0.9;
  }

  .no-mixtapes {
    font-size: var(--fs--2);
    opacity: 0.7;
    font-style: italic;
    color: var(--text-light);
  }

  /* Embed container */
  .mixtapes-embed-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background: var(--section-music-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 20;
  }

  .mixtapes-embed-iframe {
    width: calc(100% - 2rem);
    padding-right: 1.5rem;
    height: 60px;
    background: var(--section-music-bg);
    border: none;
  }

  .mixtapes-embed-close {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    background: var(--text-light);
    color: var(--section-music-bg);
    border: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .mixtapes-embed-close:hover {
    opacity: 0.8;
  }

  /* Skeleton styles */
  .skeleton-item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-s);
    align-items: center;
  }

  .skeleton-thumbnail {
    width: 56px;
    height: 56px;
    background: var(--text-light-secondary);
    border-radius: 10px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
  }

  .skeleton-line {
    height: 14px;
    background: var(--text-light-secondary);
    border-radius: 2px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-line-short {
    width: 60%;
  }

  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>
