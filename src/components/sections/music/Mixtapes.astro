---
import { getRecentCloudcasts } from '../../../lib/mixcloud';
import { getRelativeTimeMixcloud } from '../../../lib/music-helpers';
import MusicItem from './ui/MusicItem.astro';

// Try server-side env vars first, fallback to PUBLIC_ for local dev
const mixcloudUsername =
  import.meta.env.MIXCLOUD_USERNAME ||
  import.meta.env.PUBLIC_MIXCLOUD_USERNAME ||
  'mieras';

let mixtapes: any[] = [];
let error: string | null = null;

try {
  mixtapes = await getRecentCloudcasts(mixcloudUsername, 5);
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to fetch mixtapes';
  console.error('Error fetching mixtapes:', e);
}
---

<div class="mixtapes" data-tab="mixtapes">
  {
    error ? (
      <div class="error-state">
        <p class="no-mixtapes">Error loading mixtapes: {error}</p>
      </div>
    ) : mixtapes.length === 0 ? (
      <div class="content-state">
        <p class="no-mixtapes">No mixtapes available</p>
      </div>
    ) : (
      <div class="content-state">
        <div class="swiper music-swiper mixtapes-swiper">
          <div class="swiper-wrapper">
            {[...mixtapes, ...mixtapes].map((mixtape) => {
              const timestamp = mixtape.createdTime
                ? getRelativeTimeMixcloud(mixtape.createdTime)
                : undefined;

              return (
                <div class="swiper-slide">
                  <div
                    class="mixtape-item"
                    data-mixcloud-id={mixtape.mixcloudId}
                  >
                    <MusicItem
                      variant="ticker-thumbnail"
                      thumbnail={mixtape.thumbnail}
                      line1={mixtape.name}
                      line2={mixtape.genres?.join(', ')}
                      timestamp={timestamp}
                      mixcloudId={mixtape.mixcloudId}
                    />
                  </div>
                </div>
              );
            })}
          </div>
          <div class="swiper-pagination" />
        </div>
        {/* Embed container die over de carousel komt */}
        <div class="mixtapes-embed-container" style="display: none;">
          <iframe
            class="mixtapes-embed-iframe"
            width="100%"
            height="400"
            src=""
            style="border: 0"
            allow="encrypted-media; fullscreen; autoplay; idle-detection; speaker-selection; web-share;"
          />
          <button class="mixtapes-embed-close" aria-label="Close player">
            ×
          </button>
        </div>
      </div>
    )
  }
</div>

<script>
  import { initSwiper, mixtapesPreset } from '../../../lib/swiper-utils';

  // Swiper instance reference
  let mixtapesSwiper: any = null;

  // Function to get Swiper instance
  const getMixtapesSwiper = () => {
    if (!mixtapesSwiper) {
      const swiperElement = document.querySelector(
        '.mixtapes-swiper',
      ) as HTMLElement;
      if (swiperElement) {
        mixtapesSwiper = (swiperElement as any).swiper;
      }
    }
    return mixtapesSwiper;
  };

  let swiperInitialized = false;

  // Try to initialize Swiper - with multiple strategies
  const tryInitSwiper = () => {
    const container = document.querySelector(
      '[data-tab="mixtapes"]',
    ) as HTMLElement;
    if (!container) {
      return false;
    }

    const swiperEl = container.querySelector('.mixtapes-swiper') as HTMLElement;
    if (!swiperEl) {
      return false;
    }

    const wrapper = swiperEl.querySelector('.swiper-wrapper');
    if (!wrapper || wrapper.children.length === 0) {
      return false;
    }

    // Check if already initialized
    if ((swiperEl as any).swiper) {
      swiperInitialized = true;
      mixtapesSwiper = (swiperEl as any).swiper;
      return true;
    }

    // Initialize Swiper
    if (!swiperInitialized) {
      swiperInitialized = true;
      console.log(
        'Initializing Mixtapes Swiper with',
        wrapper.children.length,
        'slides',
      );
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const swiper = initSwiper(swiperEl, mixtapesPreset, true);
          if (swiper && swiperEl) {
            (swiperEl as any).swiper = swiper;
            mixtapesSwiper = swiper;
            console.log('Mixtapes Swiper initialized successfully');
            requestAnimationFrame(() => {
              swiper.update();
              swiper.updateSize();
            });
          }
        });
      });
      return true;
    }

    return false;
  };

  // Use MutationObserver to detect when server island content is added
  const observeForContent = () => {
    const container = document.querySelector(
      '[data-tab="mixtapes"]',
    ) as HTMLElement;
    if (!container) {
      setTimeout(observeForContent, 100);
      return;
    }

    // Try immediately
    if (tryInitSwiper()) {
      initEmbedHandlers();
      return;
    }

    const observer = new MutationObserver(() => {
      if (tryInitSwiper()) {
        observer.disconnect();
        initEmbedHandlers();
      }
    });

    observer.observe(container, {
      childList: true,
      subtree: true,
      attributes: true,
    });

    // Also use interval as fallback
    let attempts = 0;
    const intervalId = setInterval(() => {
      attempts++;
      if (tryInitSwiper() || attempts > 50) {
        clearInterval(intervalId);
        observer.disconnect();
        if (attempts <= 50) {
          initEmbedHandlers();
        }
      }
    }, 100);

    // Cleanup after 10 seconds
    setTimeout(() => {
      clearInterval(intervalId);
      observer.disconnect();
    }, 10000);
  };

  const handleEmbedOpen = (mixcloudId: string) => {
    const swiperElement = document.querySelector(
      '.mixtapes-swiper',
    ) as HTMLElement;
    const embedContainer = document.querySelector(
      '.mixtapes-embed-container',
    ) as HTMLElement;
    const embedIframe = document.querySelector(
      '.mixtapes-embed-iframe',
    ) as HTMLIFrameElement;

    if (!swiperElement || !embedContainer || !embedIframe) return;

    // Pause Swiper
    const swiper = getMixtapesSwiper();
    if (swiper) {
      swiper.autoplay?.stop();
    }

    // Toon embed over carousel (carousel blijft zichtbaar maar embed komt erover)
    embedContainer.style.display = 'flex';
    embedIframe.src = `https://player-widget.mixcloud.com/widget/iframe/?hide_cover=1&mini=1&autoplay=1&feed=%2F${mixcloudId}%2F`;
  };

  const handleEmbedClose = () => {
    const swiperElement = document.querySelector(
      '.mixtapes-swiper',
    ) as HTMLElement;
    const embedContainer = document.querySelector(
      '.mixtapes-embed-container',
    ) as HTMLElement;
    const embedIframe = document.querySelector(
      '.mixtapes-embed-iframe',
    ) as HTMLIFrameElement;

    if (!swiperElement || !embedContainer || !embedIframe) return;

    // Stop embed
    embedIframe.src = '';
    embedContainer.style.display = 'none';
  };

  const initEmbedHandlers = () => {
    const mixtapeItems = document.querySelectorAll('.mixtape-item');
    let currentlyPlaying: HTMLElement | null = null;

    // Close all players and reset buttons
    const closeAllPlayers = () => {
      mixtapeItems.forEach((item) => {
        const mixcloudIconBtn = item.querySelector(
          '.music-mixcloud-icon-btn',
        ) as HTMLElement;

        // Reset mixcloud icon button
        if (mixcloudIconBtn) {
          mixcloudIconBtn.setAttribute('data-active', 'false');
          mixcloudIconBtn.setAttribute('data-action', 'play');
        }
      });
      currentlyPlaying = null;
    };

    // Handle mixcloud icon button clicks
    mixtapeItems.forEach((item) => {
      const mixcloudIconBtn = item.querySelector(
        '.music-mixcloud-icon-btn',
      ) as HTMLElement;
      const mixcloudId = item.getAttribute('data-mixcloud-id');

      if (!mixcloudId || !mixcloudIconBtn) return;

      // Remove existing listeners to prevent duplicates
      const newBtn = mixcloudIconBtn.cloneNode(true) as HTMLElement;
      mixcloudIconBtn.parentNode?.replaceChild(newBtn, mixcloudIconBtn);

      const handlePlayClick = () => {
        const isActive = newBtn.getAttribute('data-active') === 'true';
        const action = newBtn.getAttribute('data-action');

        if (isActive && action === 'pause') {
          // Pause - close embed
          handleEmbedClose();
          closeAllPlayers();
        } else {
          // Play new - close any other players first
          if (currentlyPlaying && currentlyPlaying !== item) {
            closeAllPlayers();
            handleEmbedClose();
          }

          // Open embed
          handleEmbedOpen(mixcloudId);

          // Update button state
          newBtn.setAttribute('data-active', 'true');
          newBtn.setAttribute('data-action', 'pause');
          currentlyPlaying = item as HTMLElement;
        }
      };

      newBtn.addEventListener('click', handlePlayClick);
    });

    // Close button handler
    const closeButton = document.querySelector(
      '.mixtapes-embed-close',
    ) as HTMLElement;
    if (closeButton) {
      closeButton.addEventListener('click', () => {
        handleEmbedClose();
        closeAllPlayers();
      });
    }
  };

  // Try to initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', observeForContent);
  } else {
    observeForContent();
  }

  document.addEventListener('astro:page-load', () => {
    swiperInitialized = false;
    mixtapesSwiper = null;
    observeForContent();
  });
</script>

<style>
  .mixtapes {
    position: relative;
    /* min-height: 200px; */
  }

  .error-state {
    padding: var(--space-m);
  }

  .content-state {
    width: 100%;
    position: relative;
  }

  .mixtapes-swiper {
    width: 100%;
  }

  .mixtapes-swiper .swiper-slide {
    width: auto;
    height: auto;
  }

  .mixtapes-swiper .swiper-slide .ticker-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    white-space: nowrap;
    height: 100%;
  }

  .mixtapes-swiper .swiper-slide .ticker-item {
    border-right-color: color-mix(in srgb, var(--border) 10%, transparent);
  }

  .mixtapes-swiper .swiper-pagination {
    position: relative;
    text-align: center;
  }

  .mixtapes-swiper .swiper-pagination-bullet {
    background: var(--text);
    opacity: 0.3;
  }

  .mixtapes-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .mixtapes-embed-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.8);
  }

  .mixtapes-embed-iframe {
    width: 100%;
    height: 60px;
    border: none;
  }

  .mixtapes-embed-close {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    z-index: 21;
  }

  .mixtapes-embed-close:hover {
    background: var(--tile-hover);
  }

  .no-mixtapes {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
    text-align: center;
    padding: var(--space-m);
  }
</style>
