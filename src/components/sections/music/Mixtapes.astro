---
import MusicItem from './ui/MusicItem.astro';
import { getRelativeTime } from '../../../lib/music-helpers';

let mixtapes: any[] = [];
let hasError = false;
let isLoading = true;

try {
  // Use Astro.url to construct absolute URL for SSR
  const apiUrl = new URL('/api/music.json', Astro.url.origin);
  const apiRes = await fetch(apiUrl);

  if (!apiRes.ok) {
    throw new Error(`API returned ${apiRes.status}`);
  }

  const { items } = await apiRes.json();

  // Filter for mixcloud items only and limit to 5
  mixtapes = items.filter((item: any) => item.source === 'mixcloud').slice(0, 5);
  isLoading = false;
} catch (error) {
  console.error('Error fetching music data:', error);
  hasError = true;
  isLoading = false;
}
---

<div class="mixtapes">
  {isLoading ? (
    <!-- Skeleton loading state -->
    <ul class="music__list">
      {[1, 2, 3, 4, 5].map(() => (
        <li class="skeleton-item">
          <div class="skeleton-thumbnail"></div>
          <div class="skeleton-content">
            <div class="skeleton-line"></div>
            <div class="skeleton-line skeleton-line-short"></div>
          </div>
        </li>
      ))}
    </ul>
  ) : mixtapes.length > 0 ? (
    <>
      <ul class="music__list">
        {mixtapes.map((mixtape, index) => {
          const thumbnail = mixtape.thumb;
          const mixcloudId = mixtape.mixcloudId;
          const genres = mixtape.genres || [];
          const timestamp = mixtape.date
            ? getRelativeTime(mixtape.date)
            : undefined;
          const genresText =
            genres.length > 0 ? genres.join(', ') : undefined;

          return (
            <li
              class="mixtape-item"
              data-mixcloud-id={mixcloudId}
              data-index={index}
            >
              <MusicItem
                thumbnail={thumbnail}
                line1={mixtape.title}
                line2={genresText}
                timestamp={timestamp}
                showPlayButton={true}
                mixcloudId={mixcloudId}
              />
            </li>
          );
        })}
      </ul>
    </>
  ) : hasError ? (
    <p class="no-mixtapes">Error loading mixtapes</p>
  ) : (
    <p class="no-mixtapes">No mixtapes available</p>
  )}
  <a class="music__source" href="https://mixcloud.com" target="_blank" rel="noopener">
    mixcloud.com
  </a>
</div>

<script>
  const handleEmbedOpen = (mixcloudId: string) => {
    const playerContainer = document.querySelector(
      '.mixcloud-player',
    ) as HTMLElement;
    const playerIframe = document.querySelector(
      '.mixcloud-player__iframe',
    ) as HTMLIFrameElement;

    if (!playerContainer || !playerIframe) return;

    // Toon player
    playerContainer.style.display = 'flex';
    playerIframe.src = `https://player-widget.mixcloud.com/widget/iframe/?hide_cover=1&autoplay=1&feed=%2F${mixcloudId}%2F`;
  };

  const handleEmbedClose = () => {
    const playerContainer = document.querySelector(
      '.mixcloud-player',
    ) as HTMLElement;
    const playerIframe = document.querySelector(
      '.mixcloud-player__iframe',
    ) as HTMLIFrameElement;

    if (!playerContainer || !playerIframe) return;

    // Stop player
    playerIframe.src = '';
    playerContainer.style.display = 'none';
  };

  const initEmbedHandlers = () => {
    const mixtapeItems = document.querySelectorAll('.mixtape-item');
    let currentlyPlaying: HTMLElement | null = null;

    // Close all players and reset buttons
    const closeAllPlayers = () => {
      mixtapeItems.forEach((item) => {
        const playBtn = item.querySelector(
          '.music-item__play-btn',
        ) as HTMLElement;
        const inlinePlayBtn = item.querySelector(
          '.music-item__play-btn-inline',
        ) as HTMLElement;

        // Reset play button on thumbnail
        if (playBtn) {
          playBtn.setAttribute('data-active', 'false');
          playBtn.setAttribute('data-action', 'play');
          const playIcon = playBtn.querySelector('.music-item__play-icon') as HTMLElement;
          const pauseIcon = playBtn.querySelector('.music-item__pause-icon') as HTMLElement;
          if (playIcon) playIcon.style.display = '';
          if (pauseIcon) pauseIcon.style.display = 'none';
        }

        // Reset inline play button
        if (inlinePlayBtn) {
          inlinePlayBtn.setAttribute('data-active', 'false');
          inlinePlayBtn.setAttribute('data-action', 'play');
          const playIcon = inlinePlayBtn.querySelector('.music-item__play-icon') as HTMLElement;
          const pauseIcon = inlinePlayBtn.querySelector('.music-item__pause-icon') as HTMLElement;
          if (playIcon) playIcon.style.display = '';
          if (pauseIcon) pauseIcon.style.display = 'none';
        }
      });
      currentlyPlaying = null;
    };

    // Handle play button clicks (both thumbnail and inline play button)
    mixtapeItems.forEach((item) => {
      const playBtn = item.querySelector(
        '.music-item__play-btn',
      ) as HTMLElement;
      const inlinePlayBtn = item.querySelector(
        '.music-item__play-btn-inline',
      ) as HTMLElement;
      const mixcloudId = item.getAttribute('data-mixcloud-id');

      if (!mixcloudId) return;

      const handlePlayClick = (button: HTMLElement) => {
        const isActive = button.getAttribute('data-active') === 'true';
        const action = button.getAttribute('data-action');

        if (isActive && action === 'pause') {
          // Pause - close embed
          handleEmbedClose();
          closeAllPlayers();
        } else {
          // Play new - close any other players first
          if (currentlyPlaying && currentlyPlaying !== item) {
            closeAllPlayers();
            handleEmbedClose();
          }

          // Open embed
          handleEmbedOpen(mixcloudId);

          // Update button state
          button.setAttribute('data-active', 'true');
          button.setAttribute('data-action', 'pause');
          
          // Update play/pause icons
          const playIcon = button.querySelector('.music-item__play-icon') as HTMLElement;
          const pauseIcon = button.querySelector('.music-item__pause-icon') as HTMLElement;
          if (playIcon) playIcon.style.display = 'none';
          if (pauseIcon) pauseIcon.style.display = '';

          currentlyPlaying = item as HTMLElement;
        }
      };

      // Handle play button on thumbnail
      if (playBtn) {
        playBtn.addEventListener('click', () => handlePlayClick(playBtn));
      }

      // Handle inline play button
      if (inlinePlayBtn) {
        inlinePlayBtn.addEventListener('click', () => handlePlayClick(inlinePlayBtn));
      }
    });

    // Close button handler
    const closeButton = document.querySelector(
      '.mixcloud-player__close',
    ) as HTMLElement;
    if (closeButton) {
      closeButton.addEventListener('click', () => {
        handleEmbedClose();
        closeAllPlayers();
      });
    }
  };

  // Initialize embed handlers on page load
  // Swiper initialization is handled by MusicSection component
  document.addEventListener('DOMContentLoaded', () => {
    initEmbedHandlers();
  });

  // Re-initialize embed handlers on Astro page load (for view transitions)
  document.addEventListener('astro:page-load', () => {
    initEmbedHandlers();
  });

  // Also initialize immediately if DOM is already loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initEmbedHandlers();
    });
  } else {
    initEmbedHandlers();
  }
</script>

<style>
  .mixtapes {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .music__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-s);
    overflow-y: auto;
    flex: 1;
    min-height: 0;
  }

  .music__source {
    display: inline-flex;
    margin-top: var(--space-s);
    opacity: 0.6;
    text-decoration: none;
    color: var(--text-light);
    font-size: var(--fs--2);
  }

  .music__source:hover {
    opacity: 0.9;
  }

  .no-mixtapes {
    font-size: var(--fs--2);
    opacity: 0.7;
    font-style: italic;
    color: var(--text-light);
  }

  /* Skeleton styles */
  .skeleton-item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-s);
    align-items: center;
  }

  .skeleton-thumbnail {
    width: 56px;
    height: 56px;
    background: var(--text-light-secondary);
    border-radius: 10px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
  }

  .skeleton-line {
    height: 14px;
    background: var(--text-light-secondary);
    border-radius: 2px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-line-short {
    width: 60%;
  }

  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>
