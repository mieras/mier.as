---
import MusicItem from './ui/MusicItem.astro';
import { getRelativeTime } from '../../../lib/music-helpers';

let mixtapes: any[] = [];
let hasError = false;
let isLoading = true;

try {
  // Use Astro.url to construct absolute URL for SSR
  const apiUrl = new URL('/api/music.json', Astro.url.origin);
  const apiRes = await fetch(apiUrl);

  if (!apiRes.ok) {
    throw new Error(`API returned ${apiRes.status}`);
  }

  const { items } = await apiRes.json();

  // Filter for mixcloud items only
  mixtapes = items.filter((item: any) => item.source === 'mixcloud');
  isLoading = false;
} catch (error) {
  console.error('Error fetching music data:', error);
  hasError = true;
  isLoading = false;
}
---

<div class="mixtapes">
  {isLoading ? (
    <!-- Skeleton loading state -->
    <div class="swiper music-swiper mixtapes-swiper">
      <div class="swiper-wrapper">
        {[1, 2, 3, 4, 5].map(() => (
          <div class="swiper-slide">
            <div class="ticker-item skeleton-item">
              <div class="skeleton-thumbnail"></div>
              <div class="skeleton-content">
                <div class="skeleton-line"></div>
                <div class="skeleton-line skeleton-line-short"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="swiper-button-next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 11V13H15V14H14V15H13V16H12V17H11V18H10V19H9V20H8V19H7V18H8V17H9V16H10V15H11V14H12V13H13V11H12V10H11V9H10V8H9V7H8V6H7V5H8V4H9V5H10V6H11V7H12V8H13V9H14V10H15V11H16Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="swiper-button-prev">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 13H12V14H13V15H14V16H15V17H16V18H17V19H16V20H15V19H14V18H13V17H12V16H11V15H10V14H9V13H8V11H9V10H10V9H11V8H12V7H13V6H14V5H15V4H16V5H17V6H16V7H15V8H14V9H13V10H12V11H11V13Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="swiper-pagination" />
    </div>
  ) : mixtapes.length > 0 ? (
    <>
      <div class="swiper music-swiper mixtapes-swiper">
        <div class="swiper-wrapper">
          {mixtapes.map((mixtape, index) => {
            const thumbnail = mixtape.thumb;
            const mixcloudId = mixtape.mixcloudId;
            const genres = mixtape.genres || [];
            const timestamp = mixtape.date
              ? getRelativeTime(mixtape.date)
              : undefined;
            const genresText =
              genres.length > 0 ? genres.join(', ') : undefined;

            return (
              <div
                class="swiper-slide mixtape-item"
                data-mixcloud-id={mixcloudId}
                data-index={index}
              >
                <MusicItem
                  thumbnail={thumbnail}
                  line1={mixtape.title}
                  line2={genresText}
                  timestamp={timestamp}
                  variant="ticker-thumbnail"
                  showPlayButton={false}
                  mixcloudId={mixcloudId}
                />
              </div>
            );
          })}
        </div>
        <div class="swiper-button-next">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 11V13H15V14H14V15H13V16H12V17H11V18H10V19H9V20H8V19H7V18H8V17H9V16H10V15H11V14H12V13H13V11H12V10H11V9H10V8H9V7H8V6H7V5H8V4H9V5H10V6H11V7H12V8H13V9H14V10H15V11H16Z" fill="currentColor"/>
          </svg>
        </div>
        <div class="swiper-button-prev">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11 13H12V14H13V15H14V16H15V17H16V18H17V19H16V20H15V19H14V18H13V17H12V16H11V15H10V14H9V13H8V11H9V10H10V9H11V8H12V7H13V6H14V5H15V4H16V5H17V6H16V7H15V8H14V9H13V10H12V11H11V13Z" fill="currentColor"/>
          </svg>
        </div>
        <div class="swiper-pagination" />
      </div>
        {/* Embed container die over de carousel komt */}
        <div class="mixtapes-embed-container" style="display: none;">
          <iframe
            class="mixtapes-embed-iframe"
            width="100%"
            height="100%"
            src=""
            frameborder="0"
            allow="encrypted-media; fullscreen; autoplay; idle-detection; speaker-selection; web-share;"
          />
          <button class="mixtapes-embed-close" aria-label="Close player">
            ×
          </button>
        </div>
      </>
    ) : hasError ? (
      <p class="no-mixtapes">Error loading mixtapes</p>
    ) : (
      <p class="no-mixtapes">No mixtapes available</p>
    )
  }
</div>

<script>
  // Swiper initialization is now handled by MusicSection component
  // to ensure it only initializes when the tab is visible
  // We keep a reference to the Swiper instance for embed handlers
  let mixtapesSwiper: any = null;

  // Function to get Swiper instance (called after initialization by MusicSection)
  const getMixtapesSwiper = () => {
    if (!mixtapesSwiper) {
      const swiperElement = document.querySelector(
        '.mixtapes-swiper',
      ) as HTMLElement;
      if (swiperElement) {
        // Try to get instance from element data or global store
        mixtapesSwiper = (swiperElement as any).swiper;
      }
    }
    return mixtapesSwiper;
  };

  const handleEmbedOpen = (mixcloudId: string) => {
    const swiperElement = document.querySelector(
      '.mixtapes-swiper',
    ) as HTMLElement;
    const embedContainer = document.querySelector(
      '.mixtapes-embed-container',
    ) as HTMLElement;
    const embedIframe = document.querySelector(
      '.mixtapes-embed-iframe',
    ) as HTMLIFrameElement;

    if (!swiperElement || !embedContainer || !embedIframe) return;

    // Pause Swiper
    const swiper = getMixtapesSwiper();
    if (swiper) {
      swiper.autoplay?.stop();
    }

    // Toon embed over carousel (carousel blijft zichtbaar maar embed komt erover)
    embedContainer.style.display = 'flex';
    embedIframe.src = `https://player-widget.mixcloud.com/widget/iframe/?hide_cover=1&autoplay=1&feed=%2F${mixcloudId}%2F`;
  };

  const handleEmbedClose = () => {
    const swiperElement = document.querySelector(
      '.mixtapes-swiper',
    ) as HTMLElement;
    const embedContainer = document.querySelector(
      '.mixtapes-embed-container',
    ) as HTMLElement;
    const embedIframe = document.querySelector(
      '.mixtapes-embed-iframe',
    ) as HTMLIFrameElement;

    if (!swiperElement || !embedContainer || !embedIframe) return;

    // Stop embed
    embedIframe.src = '';
    embedContainer.style.display = 'none';
  };

  const initEmbedHandlers = () => {
    const mixtapeItems = document.querySelectorAll('.mixtape-item');
    let currentlyPlaying: HTMLElement | null = null;

    // Close all players and reset buttons
    const closeAllPlayers = () => {
      mixtapeItems.forEach((item) => {
        const mixcloudIconBtn = item.querySelector(
          '.music-mixcloud-icon-btn',
        ) as HTMLElement;

        // Reset mixcloud icon button
        if (mixcloudIconBtn) {
          mixcloudIconBtn.setAttribute('data-active', 'false');
          mixcloudIconBtn.setAttribute('data-action', 'play');
        }
      });
      currentlyPlaying = null;
    };

    // Handle mixcloud icon button clicks
    mixtapeItems.forEach((item) => {
      const mixcloudIconBtn = item.querySelector(
        '.music-mixcloud-icon-btn',
      ) as HTMLElement;
      const mixcloudId = item.getAttribute('data-mixcloud-id');

      if (!mixcloudId || !mixcloudIconBtn) return;

      const handlePlayClick = () => {
        const isActive = mixcloudIconBtn.getAttribute('data-active') === 'true';
        const action = mixcloudIconBtn.getAttribute('data-action');

        if (isActive && action === 'pause') {
          // Pause - close embed
          handleEmbedClose();
          closeAllPlayers();
        } else {
          // Play new - close any other players first
          if (currentlyPlaying && currentlyPlaying !== item) {
            closeAllPlayers();
            handleEmbedClose();
          }

          // Open embed
          handleEmbedOpen(mixcloudId);

          // Update button state
          mixcloudIconBtn.setAttribute('data-active', 'true');
          mixcloudIconBtn.setAttribute('data-action', 'pause');
          currentlyPlaying = item as HTMLElement;
        }
      };

      mixcloudIconBtn.addEventListener('click', handlePlayClick);
    });

    // Close button handler
    const closeButton = document.querySelector(
      '.mixtapes-embed-close',
    ) as HTMLElement;
    if (closeButton) {
      closeButton.addEventListener('click', () => {
        handleEmbedClose();
        closeAllPlayers();
      });
    }
  };

  // Initialize embed handlers on page load
  // Swiper initialization is handled by MusicSection component
  document.addEventListener('DOMContentLoaded', () => {
    initEmbedHandlers();
  });

  // Re-initialize embed handlers on Astro page load (for view transitions)
  document.addEventListener('astro:page-load', () => {
    initEmbedHandlers();
  });

  // Also initialize immediately if DOM is already loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initEmbedHandlers();
    });
  } else {
    initEmbedHandlers();
  }
</script>

<style>
  .mixtapes {
    position: relative;
    /* min-height: 200px; */
  }

  .mixtapes-swiper {
    width: 100%;
  }

  .mixtapes-swiper .swiper-slide {
    width: auto;
    height: auto;
  }

  .mixtapes-swiper .swiper-slide .ticker-item {
  }

  .mixtapes-swiper .swiper-slide .ticker-item {
    border-right-color: color-mix(in srgb, var(--border) 10%, transparent);
  }

  .mixtapes-swiper .swiper-pagination {
    position: relative;
    /* margin-top: var(--space-s); */
    text-align: center;
  }

  .mixtapes-swiper .swiper-pagination-bullet {
    background: var(--text);
    opacity: 0.3;
  }

  .mixtapes-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .mixtape-item {
    height: 100%;
  }

  /* Embed container die over de carousel komt */
  .mixtapes-embed-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background: var(--bg);
    /* border: 1px solid var(--border); */
    /* border-radius: var(--radius-small); */
    /* padding: var(--space-m); */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 20;
  }

  .mixtapes-embed-iframe {
    width: calc(100% - 2rem);
    padding-right: 1.5rem;
    height: 60px;
    background: var(--bg);
    border: none;
    /* border-radius: var(--radius-small); */
  }

  .mixtapes-embed-close {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    background: var(--text);
    color: var(--bg);
    border: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .mixtapes-embed-close:hover {
    opacity: 0.8;
  }

  .no-mixtapes {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
  }

  /* Navigation arrows */
  .mixtapes-swiper .swiper-button-next,
  .mixtapes-swiper .swiper-button-prev {
    color: var(--text);
    width: 44px;
    height: 44px;
    margin-top: 0;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .mixtapes-swiper .swiper-button-next:hover,
  .mixtapes-swiper .swiper-button-prev:hover {
    opacity: 1;
  }

  .mixtapes-swiper .swiper-button-prev {
    left: 0;
  }

  .mixtapes-swiper .swiper-button-next {
    right: 0;
  }

  .mixtapes-swiper .swiper-button-next::after,
  .mixtapes-swiper .swiper-button-prev::after {
    display: none;
  }

  /* Skeleton styles */
  .skeleton-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    height: 100%;
  }

  .skeleton-thumbnail {
    width: 48px;
    height: 48px;
    background: var(--border);
    border-radius: var(--radius-small);
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
  }

  .skeleton-line {
    height: 14px;
    background: var(--border);
    border-radius: 2px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
  }

  .skeleton-line-short {
    width: 60%;
  }

  @keyframes skeleton-pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>
