---
// Client-side data fetching - geen server-side data meer
import { getRelativeTimeMixcloud } from '../../../lib/music-helpers';
import MusicItem from './ui/MusicItem.astro';
---

<div class="mixtapes" data-tab="mixtapes">
  <div class="loading-state" data-loading="true">
    <p>Loading mixtapes...</p>
  </div>
  <div class="error-state" data-error="false" style="display: none;">
    <p class="no-mixtapes">Error loading mixtapes</p>
  </div>
  <div class="content-state" data-content="false" style="display: none;">
    <div class="swiper music-swiper mixtapes-swiper">
      <div class="swiper-wrapper">
        <!-- Content wordt hier geïnjecteerd via JavaScript -->
      </div>
      <div class="swiper-pagination"></div>
    </div>
    {/* Embed container die over de carousel komt */}
    <div class="mixtapes-embed-container" style="display: none;">
      <iframe
        class="mixtapes-embed-iframe"
        width="100%"
        height="400"
        src=""
        style="border: 0"
        allow="encrypted-media; fullscreen; autoplay; idle-detection; speaker-selection; web-share;"
      ></iframe>
      <button class="mixtapes-embed-close" aria-label="Close player">
        ×
      </button>
    </div>
  </div>
</div>

<script>
  import { initSwiper, mixtapesPreset } from '../../../lib/swiper-utils';
  import { getRelativeTimeMixcloud } from '../../../lib/music-helpers';

  let isLoading = false;
  let swiperInitialized = false;
  let mixtapesSwiper: any = null;

  const CACHE_DURATION = 5 * 60 * 1000; // 5 minuten

  // Function to get Swiper instance
  const getMixtapesSwiper = () => {
    if (!mixtapesSwiper) {
      const swiperElement = document.querySelector(
        '.mixtapes-swiper',
      ) as HTMLElement;
      if (swiperElement) {
        mixtapesSwiper = (swiperElement as any).swiper;
      }
    }
    return mixtapesSwiper;
  };

  async function loadMixtapes() {
    if (isLoading) {
      console.log('Already loading, skipping...');
      return;
    }

    const container = document.querySelector(
      '[data-tab="mixtapes"]',
    ) as HTMLElement;
    if (!container) return;

    const loadingState = container.querySelector(
      '[data-loading="true"]',
    ) as HTMLElement;
    const errorState = container.querySelector('[data-error]') as HTMLElement;
    const contentState = container.querySelector(
      '[data-content]',
    ) as HTMLElement;

    // Check cache
    const cachedData = sessionStorage.getItem('mixtapes-data');
    const cachedTimestamp = sessionStorage.getItem('mixtapes-timestamp');

    if (cachedData && cachedTimestamp) {
      const age = Date.now() - parseInt(cachedTimestamp, 10);
      if (age < CACHE_DURATION) {
        console.log('Using cached mixtapes');
        const mixtapes = JSON.parse(cachedData);
        renderMixtapes(mixtapes);
        return;
      }
    }

    isLoading = true;
    if (loadingState) loadingState.style.display = 'block';
    if (errorState) {
      errorState.style.display = 'none';
      errorState.setAttribute('data-error', 'false');
    }
    if (contentState) {
      contentState.style.display = 'none';
      contentState.setAttribute('data-content', 'false');
    }

    try {
      const response = await fetch('/api/music/mixtapes');
      if (!response.ok) {
        throw new Error(`API returned ${response.status}`);
      }

      const mixtapes = await response.json();

      // Cache data
      sessionStorage.setItem('mixtapes-data', JSON.stringify(mixtapes));
      sessionStorage.setItem('mixtapes-timestamp', Date.now().toString());

      renderMixtapes(mixtapes);
    } catch (error) {
      console.error('Failed to load mixtapes:', error);
      if (loadingState) loadingState.style.display = 'none';
      if (errorState) {
        errorState.style.display = 'block';
        errorState.setAttribute('data-error', 'true');
      }
    } finally {
      isLoading = false;
    }
  }

  function renderMixtapes(mixtapes: any[]) {
    const container = document.querySelector(
      '[data-tab="mixtapes"]',
    ) as HTMLElement;
    if (!container) return;

    const loadingState = container.querySelector(
      '[data-loading="true"]',
    ) as HTMLElement;
    const errorState = container.querySelector('[data-error]') as HTMLElement;
    const contentState = container.querySelector(
      '[data-content]',
    ) as HTMLElement;
    const wrapper = contentState?.querySelector(
      '.swiper-wrapper',
    ) as HTMLElement;

    if (!wrapper || !contentState) {
      console.error('Wrapper or contentState not found');
      return;
    }

    // Show content, hide loading/error
    if (loadingState) loadingState.style.display = 'none';
    if (errorState) {
      errorState.style.display = 'none';
      errorState.setAttribute('data-error', 'false');
    }
    contentState.style.display = 'block';
    contentState.setAttribute('data-content', 'true');

    // Clear and render mixtapes
    wrapper.innerHTML = '';

    [...mixtapes, ...mixtapes].forEach((mixtape) => {
      const timestamp = mixtape.createdTime
        ? getRelativeTimeMixcloud(mixtape.createdTime)
        : undefined;

      const slide = document.createElement('div');
      slide.className = 'swiper-slide';

      const mixtapeItem = document.createElement('div');
      mixtapeItem.className = 'mixtape-item';
      mixtapeItem.setAttribute('data-mixcloud-id', mixtape.mixcloudId);

      // Create MusicItem structure
      const musicItem = document.createElement('div');
      musicItem.className = 'ticker-item';

      const img = document.createElement('img');
      img.src = mixtape.thumbnail || '';
      img.alt = mixtape.name;

      const content = document.createElement('div');

      const line1 = document.createElement('span');
      line1.className = 'music-line1';
      line1.textContent = mixtape.name;

      const line2 = document.createElement('span');
      line2.className = 'music-line2';
      line2.textContent = mixtape.genres?.join(', ') || '';

      content.appendChild(line1);
      content.appendChild(line2);

      if (timestamp) {
        const timeSpan = document.createElement('span');
        timeSpan.className = 'music-timestamp';
        timeSpan.textContent = timestamp;
        content.appendChild(timeSpan);
      }

      // Add Mixcloud icon button
      if (mixtape.mixcloudId) {
        const iconBtn = document.createElement('button');
        iconBtn.className = 'music-mixcloud-icon-btn';
        iconBtn.setAttribute('data-active', 'false');
        iconBtn.setAttribute('data-action', 'play');
        iconBtn.setAttribute('aria-label', `Play ${mixtape.name}`);
        iconBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14.6663 7.33329V8.66663H13.9997V9.33329H13.333V9.99996H11.9997V10.6666H10.6663V11.3333H9.99967V12H8.66634V12.6666H7.33301V13.3333H6.66634V14H5.33301V14.6666H3.99967V15.3333H1.99967V14.6666H1.33301V1.33329H1.99967V0.666626H3.99967V1.33329H5.33301V1.99996H6.66634V2.66663H7.33301V3.33329H8.66634V3.99996H9.99967V4.66663H10.6663V5.33329H11.9997V5.99996H13.333V6.66663H13.9997V7.33329H14.6663Z" fill="currentColor"/></svg>`;
        line1.appendChild(iconBtn);
      }

      musicItem.appendChild(img);
      musicItem.appendChild(content);
      mixtapeItem.appendChild(musicItem);
      slide.appendChild(mixtapeItem);
      wrapper.appendChild(slide);
    });

    // Initialize Swiper
    if (!swiperInitialized) {
      const swiperEl = container.querySelector(
        '.mixtapes-swiper',
      ) as HTMLElement;
      if (swiperEl && wrapper.children.length > 0) {
        swiperInitialized = true;
        console.log(
          'Initializing Mixtapes Swiper with',
          wrapper.children.length,
          'slides',
        );
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            const swiper = initSwiper(swiperEl, mixtapesPreset, true);
            if (swiper && swiperEl) {
              (swiperEl as any).swiper = swiper;
              mixtapesSwiper = swiper;
              console.log('Mixtapes Swiper initialized successfully');
              requestAnimationFrame(() => {
                swiper.update();
                swiper.updateSize();
              });
              initEmbedHandlers();
            }
          });
        });
      }
    } else {
      // Update existing Swiper
      const swiperEl = container.querySelector(
        '.mixtapes-swiper',
      ) as HTMLElement;
      if ((swiperEl as any).swiper) {
        (swiperEl as any).swiper.update();
        (swiperEl as any).swiper.updateSize();
      }
      initEmbedHandlers();
    }
  }

  const handleEmbedOpen = (mixcloudId: string) => {
    const swiperElement = document.querySelector(
      '.mixtapes-swiper',
    ) as HTMLElement;
    const embedContainer = document.querySelector(
      '.mixtapes-embed-container',
    ) as HTMLElement;
    const embedIframe = document.querySelector(
      '.mixtapes-embed-iframe',
    ) as HTMLIFrameElement;

    if (!swiperElement || !embedContainer || !embedIframe) return;

    // Pause Swiper
    const swiper = getMixtapesSwiper();
    if (swiper) {
      swiper.autoplay?.stop();
    }

    // Toon embed over carousel (carousel blijft zichtbaar maar embed komt erover)
    embedContainer.style.display = 'flex';
    embedIframe.src = `https://player-widget.mixcloud.com/widget/iframe/?hide_cover=1&mini=1&autoplay=1&feed=%2F${mixcloudId}%2F`;
  };

  const handleEmbedClose = () => {
    const swiperElement = document.querySelector(
      '.mixtapes-swiper',
    ) as HTMLElement;
    const embedContainer = document.querySelector(
      '.mixtapes-embed-container',
    ) as HTMLElement;
    const embedIframe = document.querySelector(
      '.mixtapes-embed-iframe',
    ) as HTMLIFrameElement;

    if (!swiperElement || !embedContainer || !embedIframe) return;

    // Stop embed
    embedIframe.src = '';
    embedContainer.style.display = 'none';
  };

  const initEmbedHandlers = () => {
    const mixtapeItems = document.querySelectorAll('.mixtape-item');
    let currentlyPlaying: HTMLElement | null = null;

    // Close all players and reset buttons
    const closeAllPlayers = () => {
      mixtapeItems.forEach((item) => {
        const mixcloudIconBtn = item.querySelector(
          '.music-mixcloud-icon-btn',
        ) as HTMLElement;

        // Reset mixcloud icon button
        if (mixcloudIconBtn) {
          mixcloudIconBtn.setAttribute('data-active', 'false');
          mixcloudIconBtn.setAttribute('data-action', 'play');
        }
      });
      currentlyPlaying = null;
    };

    // Handle mixcloud icon button clicks
    mixtapeItems.forEach((item) => {
      const mixcloudIconBtn = item.querySelector(
        '.music-mixcloud-icon-btn',
      ) as HTMLElement;
      const mixcloudId = item.getAttribute('data-mixcloud-id');

      if (!mixcloudId || !mixcloudIconBtn) return;

      // Remove existing listeners to prevent duplicates
      const newBtn = mixcloudIconBtn.cloneNode(true) as HTMLElement;
      mixcloudIconBtn.parentNode?.replaceChild(newBtn, mixcloudIconBtn);

      const handlePlayClick = () => {
        const isActive = newBtn.getAttribute('data-active') === 'true';
        const action = newBtn.getAttribute('data-action');

        if (isActive && action === 'pause') {
          // Pause - close embed
          handleEmbedClose();
          closeAllPlayers();
        } else {
          // Play new - close any other players first
          if (currentlyPlaying && currentlyPlaying !== item) {
            closeAllPlayers();
            handleEmbedClose();
          }

          // Open embed
          handleEmbedOpen(mixcloudId);

          // Update button state
          newBtn.setAttribute('data-active', 'true');
          newBtn.setAttribute('data-action', 'pause');
          currentlyPlaying = item as HTMLElement;
        }
      };

      newBtn.addEventListener('click', handlePlayClick);
    });

    // Close button handler
    const closeButton = document.querySelector(
      '.mixtapes-embed-close',
    ) as HTMLElement;
    if (closeButton) {
      // Remove existing listeners
      const newCloseBtn = closeButton.cloneNode(true) as HTMLElement;
      closeButton.parentNode?.replaceChild(newCloseBtn, closeButton);

      newCloseBtn.addEventListener('click', () => {
        handleEmbedClose();
        closeAllPlayers();
      });
    }
  };

  // Load data when tab becomes active
  function initMixtapes() {
    const container = document.querySelector(
      '[data-tab="mixtapes"]',
    ) as HTMLElement;
    if (!container) {
      setTimeout(initMixtapes, 100);
      return;
    }

    // Check if tab is active
    const tabContent = container.closest('.tab-content');
    if (tabContent?.classList.contains('tab-content-active')) {
      loadMixtapes();
    }

    // Listen for tab changes
    const musicSection = document.querySelector('.music-section');
    if (musicSection) {
      musicSection.addEventListener('tab-change', (e: any) => {
        if (e.detail.content === tabContent) {
          loadMixtapes();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMixtapes);
  } else {
    initMixtapes();
  }

  document.addEventListener('astro:page-load', () => {
    swiperInitialized = false;
    mixtapesSwiper = null;
    initMixtapes();
  });
</script>

<style>
  .mixtapes {
    position: relative;
    /* min-height: 200px; */
  }

  .loading-state {
    padding: var(--space-m);
    text-align: center;
    font-size: var(--fs--1);
    opacity: 0.7;
  }

  .error-state {
    padding: var(--space-m);
  }

  .content-state {
    width: 100%;
    position: relative;
  }

  .mixtapes-swiper {
    width: 100%;
  }

  .mixtapes-swiper .swiper-slide {
    width: auto;
    height: auto;
  }

  .mixtapes-swiper .swiper-slide .ticker-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) var(--space-m);
    background: var(--bg);
    border-right: 1px solid var(--border);
    white-space: nowrap;
    height: 100%;
  }

  .mixtapes-swiper .swiper-slide .ticker-item {
    border-right-color: color-mix(in srgb, var(--border) 10%, transparent);
  }

  .mixtapes-swiper .swiper-pagination {
    position: relative;
    text-align: center;
  }

  .mixtapes-swiper .swiper-pagination-bullet {
    background: var(--text);
    opacity: 0.3;
  }

  .mixtapes-swiper .swiper-pagination-bullet-active {
    opacity: 1;
  }

  .mixtapes-embed-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.8);
  }

  .mixtapes-embed-iframe {
    width: 100%;
    height: 60px;
    border: none;
  }

  .mixtapes-embed-close {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    z-index: 21;
  }

  .mixtapes-embed-close:hover {
    background: var(--tile-hover);
  }

  .no-mixtapes {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-style: italic;
    text-align: center;
    padding: var(--space-m);
  }
</style>
