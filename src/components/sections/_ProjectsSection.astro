---
import ProjectListItem from './projects/ProjectListItem.astro';
import TabGroup from '../ui/TabGroup.astro';

type Project = {
  _id: string;
  title: string;
  slug: string;
  year?: number;
  subtitle?: string;
  intro?: string;
  role?: string;
  thumbnail?: {
    image?: any;
    aspectRatio?: string;
  };
  client?: {
    title: string;
  };
};

type PhotographyItem = {
  _id: string;
  title: string;
  year?: number;
  city?: string;
  country?: string;
  camera?: string;
  thumbnail?: any;
};

type Props = {
  projects: Project[];
  photography: PhotographyItem[];
};

const { projects, photography } = Astro.props;

const tabs = [
  { id: 'design', label: 'Design', ariaLabel: 'Show design projects' },
  { id: 'photography', label: 'Photography', ariaLabel: 'Show photography' },
];
---

<section class="projects-section relative">
  <TabGroup
    tabs={tabs}
    defaultTab="design"
    sectionClass="projects-section"
    sticky={true}
    variant="work"
  >
    <!-- Design Projects Tab -->
    <div class="tab-content tab-content-active" data-tab-content="design">
      <ul class="projects-list">
        {
          projects.map((project) => (
            <ProjectListItem
              project={project}
              type="design"
              showThumbnail={true}
            />
          ))
        }
      </ul>
    </div>

    <!-- Photography Tab -->
    <div class="tab-content" data-tab-content="photography">
      <ul class="projects-list">
        {
          photography.map((photo) => (
            <ProjectListItem photography={photo} type="photography" />
          ))
        }
      </ul>
    </div>
  </TabGroup>
</section>

<style>
  .projects-section {
    height: 100%;
    min-height: 0;
  }

  .tab-content {
    display: none;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .tab-content.tab-content-active {
    display: flex;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow-y: auto;
    scroll-snap-type: y proximity;
    scroll-behavior: smooth;
    flex: 1;
    min-height: 0;
  }

  /* Mobile: stack everything */
  @media (max-width: 799px) {
    .tab-content.tab-content-active {
      display: block;
    }

    .projects-list {
      overflow: visible;
      height: auto;
      flex: none;
    }
  }
</style>
