---
import { getSiteSettings } from '../../lib/sanity';
import { processNavigationLink } from '../../lib/utils';

const siteSettings = await getSiteSettings();
const menuItems = siteSettings?.navigation?.menuItems || [];

// Sort menu items by order
const sortedMenuItems = [...menuItems].sort(
  (a, b) => (a.order || 0) - (b.order || 0),
);
---

<nav class="hero-navigation" aria-label="Main navigation">
  <ul class="hero-navigation__list">
    {
      sortedMenuItems.map((item) => {
        const linkProps = processNavigationLink(item.link);
        return (
          <li class="hero-navigation__item">
            <a
              href={linkProps.href}
              target={linkProps.target}
              rel={linkProps.rel}
              class="hero-navigation__link"
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .hero-navigation {
    display: flex;
    position: absolute;
    right: 0;
    top: 0;
    width: 2rem;
    height: 100%;
    padding: var(--space-xs) 0;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    overflow: hidden;
    z-index: 20;
    pointer-events: none;
  }

  .hero-navigation__list {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hero-navigation__item {
    pointer-events: auto;
    font-size: var(--fs--3);
    color: var(--text-light, #ffffff);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1;
    white-space: nowrap;
  }

  .hero-navigation__link {
    font-family: var(--font-family-default);
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    transition: opacity 0.3s ease;
    display: block;
  }

  .hero-navigation__link:hover {
    opacity: 0.7;
  }

  .hero-navigation__link:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  /* Mobile: hide on small screens */
  @media (max-width: 899px) {
    .hero-navigation {
      display: none;
    }
  }
</style>
