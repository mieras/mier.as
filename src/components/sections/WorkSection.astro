---
import ScrollMarquee from '../ui/ScrollMarquee.astro';
import TabGroup from '../ui/TabGroup.astro';
import WorkList from './work/WorkList.astro';
import WorkPanel from './work/WorkPanel.astro';
import { urlForImage } from '../../sanity/lib/image';

type Project = {
  _id: string;
  projectTitle?: string;
  title?: string; // Fallback for old data
  slug?: string;
  year?: number;
  preview?: {
    image?: any;
    video?: any;
  };
  client?: {
    title: string;
  };
};

type PhotographyItem = {
  _id: string;
  projectTitle?: string;
  title?: string; // Fallback for old data
  year?: number;
  preview?: any;
};

type Props = {
  projects?: Project[];
  photography?: PhotographyItem[];
  initialProjectSlug?: string | null;
  initialPhotographySlug?: string | null;
  workPlaceholders?: {
    designPlaceholder?: any;
    photographyPlaceholder?: any;
  };
};

const {
  projects = [],
  photography = [],
  initialProjectSlug = null,
  initialPhotographySlug = null,
  workPlaceholders,
} = Astro.props;

// Get placeholder images from homepage settings, fallback to first project if not set
const defaultDesignImage = workPlaceholders?.designPlaceholder?.asset
  ? urlForImage(workPlaceholders.designPlaceholder)
      ?.width(1200)
      .height(800)
      .url()
  : projects[0]?.preview?.image?.asset
    ? urlForImage(projects[0].preview.image)?.width(1200).height(800).url()
    : '';

const defaultPhotoImage = workPlaceholders?.photographyPlaceholder?.asset
  ? urlForImage(workPlaceholders.photographyPlaceholder)
      ?.width(1200)
      .height(800)
      .url()
  : photography[0]?.preview?.asset
    ? urlForImage(photography[0].preview)?.width(1200).height(800).url()
    : '';

const tabs = [
  { id: 'design', label: 'Design', ariaLabel: 'Show design projects' },
  { id: 'photography', label: 'Photography', ariaLabel: 'Show photography' },
];
---

<section
  class="work"
  id="work"
  aria-label="Work"
  data-initial-work-slug={initialProjectSlug || ''}
  data-initial-photography-slug={initialPhotographySlug || ''}
  data-default-design-image={defaultDesignImage}
  data-default-photo-image={defaultPhotoImage}
  data-works={JSON.stringify(projects)}
>
  <div class="work__marquee">
    <ScrollMarquee
      word="Work"
      repeat={12}
      variant="dark"
      direction="left"
      ariaLabel="Work section title"
    />
  </div>

  <div class="work__grid" id="work__grid" aria-label="Work grid">
    <div class="work__left" aria-label="Project list">
      <div class="work__tabs">
        <TabGroup
          tabs={tabs}
          defaultTab="design"
          sectionClass="work-section"
          sticky={true}
          variant="work"
        >
          <!-- Design Projects Tab -->
          <div class="tab-content tab-content-active" data-tab-content="design">
            <WorkList projects={projects} activeTab="design" />
          </div>

          <!-- Photography Tab -->
          <div class="tab-content" data-tab-content="photography">
            <WorkList photography={photography} activeTab="photography" />
          </div>
        </TabGroup>
      </div>
    </div>

    <WorkPanel
      mode="preview"
      defaultImage={defaultDesignImage}
      initialProjectSlug={initialProjectSlug}
    />
  </div>

  <div class="work__cursor" data-work-cursor aria-hidden="true">
    <img class="work__cursor-image" alt="" />
  </div>
</section>

<style>
  .work {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    min-height: 0;
    background: var(--section-work-bg);
  }

  /* Sticky marquee wrapper */
  .work__marquee {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--section-work-bg);
    width: 100%;
    overflow: hidden;
  }

  /* Grid */
  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 34rem), 1fr));
    align-items: start;
    min-width: 0;
    min-height: 100dvh;
  }

  .work__cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: clamp(9rem, 20vw, 14rem);
    height: clamp(9rem, 20vw, 14rem);
    border-radius: 999px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    z-index: 50;
    background: var(--color-black);
  }

  .work__cursor.is-visible {
    opacity: 0.9;
    transform: translate(-50%, -50%) scale(1);
  }

  .work__cursor-image,
  .work__cursor video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Left */
  .work__left {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 0;
    min-width: 0;
  }

  .work__tabs {
    /* padding: 0 var(--space-xs); */
    /* margin: var(--space-xs) 0; */
  }

  .tab-content {
    display: none !important;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    margin-inline: calc(-1 * var(--space-xs));
  }

  .tab-content.tab-content-active {
    display: flex !important;
  }

  /* Tablet: adjust layout */
  @media (max-width: 1024px) and (min-width: 768px) {
    .work {
      height: auto;
      min-height: 60vh;
    }

    .work__grid {
      grid-template-columns: 100%;
      gap: var(--space-s);
      max-width: 100%;
    }

    .work__left {
      min-height: 40vh;
      width: 100%;
      max-width: 100%;
    }

    .work__right {
      width: 100%;
      max-width: 100%;
    }
  }

  /* Mobile: stack everything */
  @media (max-width: 767px) {
    .work {
      height: auto;
      min-height: 50vh;
    }

    .work__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    .work__marquee {
      position: relative;
    }

    .work__left {
      min-height: 30vh;
    }
  }
</style>

<script>
  import { initWorkController } from '../../lib/workController';

  // Initialize work controller
  // Use astro:page-load for view transitions compatibility
  function setupWorkController() {
    // Cleanup existing instance if present
    const existingController = (window as any).__workController;
    if (
      existingController &&
      typeof existingController.destroy === 'function'
    ) {
      existingController.destroy();
    }

    const controller = initWorkController();
    if (controller) {
      (window as any).__workController = controller;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWorkController);
  } else {
    setupWorkController();
  }

  document.addEventListener('astro:page-load', setupWorkController);
</script>
