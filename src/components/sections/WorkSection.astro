---
import WorkMarquee from './WorkMarquee.astro';
import TabGroup from '../ui/TabGroup.astro';
import WorkList from './work/WorkList.astro';
import WorkPanel from './work/WorkPanel.astro';
import { urlForImage } from '../../sanity/lib/image';

type Project = {
  _id: string;
  title: string;
  slug?: string;
  year?: number;
  role?: string;
  thumbnail?: {
    image?: any;
    aspectRatio?: string;
  };
  client?: {
    title: string;
  };
};

type PhotographyItem = {
  _id: string;
  title: string;
  year?: number;
  city?: string;
  country?: string;
  camera?: string;
  thumbnail?: any;
};

type Props = {
  projects?: Project[];
  photography?: PhotographyItem[];
  initialProjectSlug?: string | null;
};

const {
  projects = [],
  photography = [],
  initialProjectSlug = null,
} = Astro.props;

// Get default preview images for each tab
const defaultDesignImage = projects[0]?.thumbnail?.image?.asset
  ? urlForImage(projects[0].thumbnail.image)?.width(1200).height(800).url()
  : '';

const defaultPhotoImage = photography[0]?.thumbnail?.asset
  ? urlForImage(photography[0].thumbnail)?.width(1200).height(800).url()
  : '';

const tabs = [
  { id: 'design', label: 'Design', ariaLabel: 'Show design projects' },
  { id: 'photography', label: 'Photography', ariaLabel: 'Show photography' },
];
---

<section
  class="work"
  id="work"
  aria-label="Work"
  data-initial-project-slug={initialProjectSlug || ''}
  data-default-design-image={defaultDesignImage}
  data-default-photo-image={defaultPhotoImage}
  data-projects={JSON.stringify(projects)}
>
  <div class="work__marquee">
    <WorkMarquee />
  </div>

  <div class="work__grid" aria-label="Work grid">
    <div class="work__left" aria-label="Project list">
      <div class="work__tabs">
        <TabGroup
          tabs={tabs}
          defaultTab="design"
          sectionClass="work-section"
          sticky={true}
          variant="work"
        >
          <!-- Design Projects Tab -->
          <div class="tab-content tab-content-active" data-tab-content="design">
            <WorkList projects={projects} activeTab="design" />
          </div>

          <!-- Photography Tab -->
          <div class="tab-content" data-tab-content="photography">
            <WorkList photography={photography} activeTab="photography" />
          </div>
        </TabGroup>
      </div>
    </div>

    <WorkPanel
      mode="preview"
      defaultImage={defaultDesignImage}
      initialProjectSlug={initialProjectSlug}
    />
  </div>
</section>

<style>
  .work {
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    min-height: 0;
    background: var(--section-work-bg);
  }

  /* Sticky marquee wrapper */
  .work__marquee {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--section-work-bg);
    width: 100%;
    overflow: hidden;
  }

  /* Grid */
  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 34rem), 1fr));
    align-items: start;
    min-width: 0;
    min-height: 0;
  }

  /* Left */
  .work__left {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 0;
    min-width: 0;
  }

  .work__tabs {
    padding: 0 var(--space-xs);
    margin: var(--space-xs) 0;
  }

  .tab-content {
    display: none;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .tab-content.tab-content-active {
    display: flex;
  }

  /* Mobile: stack everything */
  @media (max-width: 899px) {
    .work {
      height: auto;
      min-height: 50vh;
    }

    .work__grid {
      grid-template-columns: 1fr;
    }

    .work__marquee {
      position: relative;
    }
  }
</style>

<script>
  import { initWorkController } from '../../lib/workController';

  // Initialize work controller
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWorkController);
  } else {
    initWorkController();
  }

  document.addEventListener('astro:page-load', initWorkController);
</script>
