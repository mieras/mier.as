---
// Intro sectie met grote tekst en beschrijving
// Data kan uit siteSettings of homepage query komen

const title = 'Maarten Mieras'; // TODO: Haal uit Sanity
const description =
  'Digital Designer based in Rotterdam. Designs clear and intuitive digital products. Shoots film. Collects weird music.'; // TODO: Haal uit Sanity
---

<section class="intro-section">
  <div class="ticker-wrap">
    <div class="ticker">
      <span class="item-collection-1">
        <span class="item">{title}</span>
        <span class="item">{title}</span>
        <span class="item">{title}</span>
        <span class="item">{title}</span>
      </span>
      <span class="item-collection-2">
        <span class="item">{title}</span>
        <span class="item">{title}</span>
        <span class="item">{title}</span>
        <span class="item">{title}</span>
      </span>
    </div>
  </div>
  <p class="intro-description">{description}</p>
</section>

<style>
  .intro-section {
    text-align: center;
    max-width: 100%;
    overflow: hidden;
    padding: var(--site-padding);
  }

  .ticker-wrap {
    display: block;
    width: 100%;
    /* height: 3.5rem; */
    margin: 0 auto;
    /* overflow: hidden; */
    white-space: nowrap;
    position: relative;
  }

  .ticker {
    display: inline-block;
    /* margin-top: 5px; */
    animation: marquee 200s linear infinite;
  }

  .item-collection-1 {
    position: relative;
    left: 0%;
    /* animation: swap 100s linear infinite; */
  }

  .item {
    display: inline-block;
    padding: 0 1rem;
    font-size: calc(2 * var(--fs-6));
    font-weight: 400;
    font-family: var(--font-family-special);
    line-height: 0.8;
    white-space: nowrap;
    letter-spacing: -0.05em;
  }

  .intro-description {
    font-size: var(--fs-0);
    font-weight: 400;
    line-height: 1.4;
    margin: var(--space-m) 0 0 0;
    max-width: 60ch;
  }

  /* Ticker animations */
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  @keyframes swap {
    0%,
    50% {
      left: 0%;
    }
    50.01%,
    100% {
      left: 100%;
    }
  }
</style>
