---
import { urlForImage } from '../../sanity/lib/image';

type HeroMedia = {
  mediaType: 'image' | 'video';
  image?: any;
  videoUrl?: string;
};

type Props = {
  heroMedia?: HeroMedia;
};

const { heroMedia } = Astro.props;

// Debug logging
if (import.meta.env.DEV) {
  console.log('🎨 HeroMediaThree props:', {
    hasHeroMedia: !!heroMedia,
    mediaType: heroMedia?.mediaType,
    hasImage: !!heroMedia?.image,
    imageAsset: !!heroMedia?.image?.asset,
    videoUrl: heroMedia?.videoUrl,
  });
}

// Get image URL if media type is image
const imageUrl =
  heroMedia?.mediaType === 'image' && heroMedia?.image?.asset
    ? urlForImage(heroMedia.image)?.width(1920).height(1080).url()
    : null;

// Get video URL if media type is video
const videoUrl = heroMedia?.mediaType === 'video' ? heroMedia?.videoUrl : null;

if (import.meta.env.DEV) {
  console.log('🖼️ HeroMediaThree URLs:', {
    imageUrl,
    videoUrl,
    hasImageUrl: !!imageUrl,
    hasVideoUrl: !!videoUrl,
  });
}
---

<div
  class="hero-media-three"
  data-image-url={imageUrl || ''}
  data-video-url={videoUrl || ''}
>
</div>

<script client:load>
  // Import Three.js and postprocessing from ESM.sh
  Promise.all([
    import('https://esm.sh/three@0.175.0'),
    import(
      'https://esm.sh/three@0.175.0/examples/jsm/postprocessing/EffectComposer.js'
    ),
    import(
      'https://esm.sh/three@0.175.0/examples/jsm/postprocessing/RenderPass.js'
    ),
    import(
      'https://esm.sh/three@0.175.0/examples/jsm/postprocessing/UnrealBloomPass.js'
    ),
  ])
    .then(
      ([
        THREE,
        EffectComposerModule,
        RenderPassModule,
        UnrealBloomPassModule,
      ]) => {
        // Handle different export formats from ESM.sh
        const THREE_NS = THREE.default || THREE;
        const { EffectComposer } =
          EffectComposerModule.default || EffectComposerModule;
        const { RenderPass } = RenderPassModule.default || RenderPassModule;
        const { UnrealBloomPass } =
          UnrealBloomPassModule.default || UnrealBloomPassModule;

        // Wait a bit for the container to be in the DOM
        setTimeout(() => {
          // Get container element
          const container = document.querySelector('.hero-media-three');
          if (!container) {
            console.warn('HeroMediaThree: Container element not found');
            return;
          }

          let imageUrl = container.dataset.imageUrl || '';
          const videoUrl = container.dataset.videoUrl || '';

          // For testing: use local image in development if CORS issues occur
          // You can also manually set this to test with local images
          const USE_LOCAL_TEST_IMAGE = true; // Set to true to force local test image

          if (USE_LOCAL_TEST_IMAGE && !videoUrl) {
            imageUrl = '/images/91747c72c0c22f55ccde5a2c87ecc8134fb52bf8.png';
            console.log(
              '🧪 HeroMediaThree: Using local test image for development',
            );
          }

          console.log('🎨 HeroMediaThree script loaded:', {
            hasContainer: !!container,
            imageUrl,
            videoUrl,
            hasImageUrl: !!imageUrl,
            hasVideoUrl: !!videoUrl,
          });

          if (!imageUrl && !videoUrl) {
            console.warn('HeroMediaThree: No image or video URL provided');
            return;
          }

          // Scene setup
          const scene = new THREE_NS.Scene();
          const camera = new THREE_NS.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
          camera.position.z = 1;

          // Add ambient light for MeshStandardMaterial
          const ambientLight = new THREE_NS.AmbientLight(0xffffff, 1.0);
          scene.add(ambientLight);

          // Get container dimensions
          const getContainerSize = () => {
            const rect = container.getBoundingClientRect();
            return {
              width: rect.width || window.innerWidth,
              height: rect.height || window.innerHeight,
            };
          };

          const { width, height } = getContainerSize();

          // Renderer setup
          const renderer = new THREE_NS.WebGLRenderer({
            antialias: true,
            alpha: true,
            powerPreference: 'high-performance',
          });
          renderer.setSize(width, height);
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          container.appendChild(renderer.domElement);

          // Create plane geometry for fullscreen quad
          const geometry = new THREE_NS.PlaneGeometry(2, 2);
          let material = null;
          let texture = null;
          let videoElement = null;
          let meshAdded = false;

          if (imageUrl) {
            // Function to load texture from image URL
            const loadTexture = (url, useCrossOrigin = true) => {
              const img = document.createElement('img');
              if (useCrossOrigin) {
                img.crossOrigin = 'anonymous';
              }

              img.onload = () => {
                // Create texture from loaded image
                texture = new THREE_NS.Texture(img);
                texture.minFilter = THREE_NS.LinearFilter;
                texture.magFilter = THREE_NS.LinearFilter;
                texture.needsUpdate = true;

                // Calculate aspect ratios for object-fit: cover behavior
                const imageAspect = img.width / img.height;
                const containerAspect = width / height;

                // Apply object-fit: cover - scale to cover entire area, crop if needed
                if (imageAspect > containerAspect) {
                  // Image is wider than container - fit to height, crop width
                  texture.repeat.set(containerAspect / imageAspect, 1);
                  texture.offset.set(
                    (1 - containerAspect / imageAspect) / 2,
                    0,
                  );
                } else {
                  // Image is taller than container - fit to width, crop height
                  texture.repeat.set(1, imageAspect / containerAspect);
                  texture.offset.set(
                    0,
                    (1 - imageAspect / containerAspect) / 2,
                  );
                }

                // Use MeshStandardMaterial with emissive for better bloom effect
                material = new THREE_NS.MeshStandardMaterial({
                  map: texture,
                  emissive: 0xffffff,
                  emissiveIntensity: 0.3, // Add emissive glow
                  emissiveMap: texture, // Use same texture for emissive
                });
                const mesh = new THREE_NS.Mesh(geometry, material);
                scene.add(mesh);
                meshAdded = true;
                console.log(
                  '✅ HeroMediaThree: Image texture loaded and mesh added with object-fit: cover',
                );
              };

              img.onerror = (error) => {
                if (useCrossOrigin && url.startsWith('http')) {
                  // Try without crossOrigin for remote images
                  console.warn(
                    'HeroMediaThree: CORS error, trying without crossOrigin',
                  );
                  loadTexture(url, false);
                } else if (url.startsWith('http')) {
                  // Remote image failed, try local test image
                  console.warn(
                    'HeroMediaThree: Remote image failed, using local test image',
                  );
                  loadTexture(
                    '/images/91747c72c0c22f55ccde5a2c87ecc8134fb52bf8.png',
                    false,
                  );
                } else {
                  console.error(
                    'HeroMediaThree: Error loading image texture',
                    error,
                  );
                }
              };

              img.src = url;
            };

            // Start loading the image
            loadTexture(imageUrl, true);
          } else if (videoUrl) {
            // Create video element and texture
            videoElement = document.createElement('video');
            videoElement.src = videoUrl;
            videoElement.loop = true;
            videoElement.muted = true;
            videoElement.playsInline = true;
            videoElement.autoplay = true;

            videoElement.addEventListener('loadeddata', () => {
              console.log('✅ HeroMediaThree: Video loaded');
            });

            videoElement.play().catch((err) => {
              console.warn('HeroMediaThree: Video autoplay failed', err);
            });

            texture = new THREE_NS.VideoTexture(videoElement);
            texture.minFilter = THREE_NS.LinearFilter;
            texture.magFilter = THREE_NS.LinearFilter;

            // Function to apply object-fit: cover for video
            const applyVideoCover = () => {
              if (videoElement.videoWidth && videoElement.videoHeight) {
                const videoAspect =
                  videoElement.videoWidth / videoElement.videoHeight;
                const containerAspect = width / height;

                if (videoAspect > containerAspect) {
                  // Video is wider than container - fit to height, crop width
                  texture.repeat.set(containerAspect / videoAspect, 1);
                  texture.offset.set(
                    (1 - containerAspect / videoAspect) / 2,
                    0,
                  );
                } else {
                  // Video is taller than container - fit to width, crop height
                  texture.repeat.set(1, videoAspect / containerAspect);
                  texture.offset.set(
                    0,
                    (1 - videoAspect / containerAspect) / 2,
                  );
                }
              }
            };

            // Apply cover when video metadata is loaded
            videoElement.addEventListener('loadedmetadata', applyVideoCover);

            // Use MeshStandardMaterial with emissive for better bloom effect
            material = new THREE_NS.MeshStandardMaterial({
              map: texture,
              emissive: 0xffffff,
              emissiveIntensity: 0.3,
              emissiveMap: texture,
            });
            const mesh = new THREE_NS.Mesh(geometry, material);
            scene.add(mesh);
            meshAdded = true;
            console.log(
              '✅ HeroMediaThree: Video texture created and mesh added',
            );
          }

          // Post-processing setup
          const composer = new EffectComposer(renderer);
          const renderPass = new RenderPass(scene, camera);
          composer.addPass(renderPass);

          // Add bloom effect - stronger for more "glow"
          const bloomPass = new UnrealBloomPass(
            new THREE_NS.Vector2(width, height),
            1.0, // strength - strong bloom for visible glow
            0.8, // radius - larger bloom radius
            0.3, // threshold - lower threshold for more areas to bloom
          );
          composer.addPass(bloomPass);

          // Mouse tracking for interactive bloom
          const mouse = new THREE_NS.Vector2(0, 0);
          const smoothedMouse = new THREE_NS.Vector2(0, 0);

          // Track mouse position relative to entire window/viewport
          const handleMouseMove = (event) => {
            // Normalize to viewport coordinates (-1 to 1)
            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
          };

          window.addEventListener('mousemove', handleMouseMove);

          // Reset to center when mouse leaves window
          const handleMouseLeave = () => {
            mouse.set(0, 0);
          };
          window.addEventListener('mouseleave', handleMouseLeave);

          // Animation loop
          let animationId;
          const animate = () => {
            animationId = requestAnimationFrame(animate);

            // Only render if we have a mesh in the scene
            if (scene.children.length > 0 || meshAdded) {
              // Smooth mouse movement
              smoothedMouse.lerp(mouse, 0.15);

              // Update video texture if it exists
              if (
                texture &&
                videoElement &&
                texture instanceof THREE_NS.VideoTexture
              ) {
                if (videoElement.readyState >= videoElement.HAVE_CURRENT_DATA) {
                  texture.needsUpdate = true;
                }
              }

              // Interactive bloom based on mouse position
              // Create a "hotspot" effect where bloom is stronger near mouse
              const mouseDistance = Math.sqrt(
                smoothedMouse.x * smoothedMouse.x +
                  smoothedMouse.y * smoothedMouse.y,
              );
              const mouseInfluence = Math.max(0, 1.0 - mouseDistance * 1.2); // Stronger influence near cursor
              const baseStrength = 1.0;
              const maxStrength = 2.0; // Much stronger bloom near mouse
              bloomPass.strength =
                baseStrength + mouseInfluence * (maxStrength - baseStrength);

              // Also adjust radius and emissive intensity for more dramatic effect
              bloomPass.radius = 0.8 + mouseInfluence * 0.4;

              // Increase material emissive intensity near mouse for more glow
              if (material && material.emissiveIntensity !== undefined) {
                material.emissiveIntensity = 0.3 + mouseInfluence * 0.5;
              }

              composer.render();
            }
          };

          // Handle resize
          let resizeTimeout;
          const handleResize = () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
              const { width: newWidth, height: newHeight } = getContainerSize();
              camera.aspect = newWidth / newHeight;
              camera.updateProjectionMatrix();
              renderer.setSize(newWidth, newHeight);
              composer.setSize(newWidth, newHeight);

              // Recalculate object-fit: cover for image texture
              if (texture && !videoElement && texture.image) {
                const img = texture.image;
                if (img.width && img.height) {
                  const imageAspect = img.width / img.height;
                  const containerAspect = newWidth / newHeight;

                  if (imageAspect > containerAspect) {
                    texture.repeat.set(containerAspect / imageAspect, 1);
                    texture.offset.set(
                      (1 - containerAspect / imageAspect) / 2,
                      0,
                    );
                  } else {
                    texture.repeat.set(1, imageAspect / containerAspect);
                    texture.offset.set(
                      0,
                      (1 - imageAspect / containerAspect) / 2,
                    );
                  }
                }
              }

              // Recalculate object-fit: cover for video texture
              if (
                texture &&
                videoElement &&
                videoElement.videoWidth &&
                videoElement.videoHeight
              ) {
                const videoAspect =
                  videoElement.videoWidth / videoElement.videoHeight;
                const containerAspect = newWidth / newHeight;

                if (videoAspect > containerAspect) {
                  texture.repeat.set(containerAspect / videoAspect, 1);
                  texture.offset.set(
                    (1 - containerAspect / videoAspect) / 2,
                    0,
                  );
                } else {
                  texture.repeat.set(1, videoAspect / containerAspect);
                  texture.offset.set(
                    0,
                    (1 - videoAspect / containerAspect) / 2,
                  );
                }
              }
            }, 100);
          };

          window.addEventListener('resize', handleResize);

          // Start animation
          animate();

          // Cleanup function
          const cleanup = () => {
            window.removeEventListener('resize', handleResize);
            window.removeEventListener('mousemove', handleMouseMove);
            window.removeEventListener('mouseleave', handleMouseLeave);
            cancelAnimationFrame(animationId);

            if (texture) {
              texture.dispose();
            }

            if (videoElement) {
              videoElement.pause();
              videoElement.src = '';
              videoElement.load();
            }

            if (material) {
              material.dispose();
            }
            geometry.dispose();
            renderer.dispose();
            composer.dispose();

            if (container && renderer.domElement.parentNode === container) {
              container.removeChild(renderer.domElement);
            }
          };

          // Cleanup on page unload
          window.addEventListener('beforeunload', cleanup);

          // Cleanup on Astro view transitions
          document.addEventListener('astro:before-swap', cleanup);
        }, 100);
      },
    )
    .catch((error) => {
      console.error('HeroMediaThree: Error loading Three.js modules', error);
    });
</script>

<style>
  .hero-media-three {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hero-media-three canvas {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
</style>
