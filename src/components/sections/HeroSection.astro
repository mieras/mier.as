---
import { PortableText } from 'astro-portabletext';
import { urlForImage } from '../../sanity/lib/image';
import SiteNavigation from '../SiteNavigation.astro';

type HeroMedia = {
  mediaType: 'image' | 'video';
  image?: any;
  videoUrl?: string;
};

type Props = {
  heroMedia?: HeroMedia;
  introCols?: Array<{
    _key: string;
    content: any[];
  }>;
};

const { heroMedia, introCols } = Astro.props;

// PortableText components
const components = {
  types: {},
  marks: {},
  block: {},
  list: {},
  listItem: {},
};

// Get bio content - eerste kolom is About, tweede is Contact
const aboutContent = introCols?.[0]?.content;
const contactContent = introCols?.[1]?.content;

// Debug logging
if (import.meta.env.DEV) {
  console.log('🎨 HeroSection props:', {
    hasHeroMedia: !!heroMedia,
    mediaType: heroMedia?.mediaType,
    hasImage: !!heroMedia?.image,
    imageAsset: !!heroMedia?.image?.asset,
  });
}

// Get image URL if media type is image
const imageUrl =
  heroMedia?.mediaType === 'image' && heroMedia?.image?.asset
    ? urlForImage(heroMedia.image)?.width(1920).height(1080).url()
    : null;

if (import.meta.env.DEV) {
  console.log('🖼️ HeroSection image URL:', imageUrl);
}
---

<section class="hero-section">
  <div class="hero-navigation">
    <SiteNavigation />
  </div>
  <div class="hero-media">
    {
      heroMedia?.mediaType === 'image' && imageUrl ? (
        <img
          src={imageUrl}
          alt="Hero image"
          loading="eager"
          class="hero-image"
        />
      ) : heroMedia?.mediaType === 'image' && heroMedia?.image ? (
        <div class="hero-image-placeholder">
          <p>Image loading...</p>
          {import.meta.env.DEV && (
            <pre>{JSON.stringify(heroMedia.image, null, 2)}</pre>
          )}
        </div>
      ) : null
    }
    {
      heroMedia?.mediaType === 'video' && heroMedia?.videoUrl && (
        <video
          src={heroMedia.videoUrl}
          autoplay
          loop
          muted
          playsinline
          class="hero-video"
        />
      )
    }
    {
      !heroMedia && import.meta.env.DEV && (
        <div class="hero-image-placeholder">
          <p>No hero media configured</p>
        </div>
      )
    }
  </div>

  {
    (aboutContent || contactContent) && (
      <div class="hero-bio">
        {aboutContent && (
          <div class="bio-column">
            <p class="bio-label">About</p>
            <div class="bio-content">
              <PortableText value={aboutContent} components={components} />
            </div>
          </div>
        )}
        {contactContent && (
          <div class="bio-column">
            <p class="bio-label">Contact</p>
            <div class="bio-content">
              <PortableText value={contactContent} components={components} />
            </div>
          </div>
        )}
      </div>
    )
  }
</section>

<style>
  .hero-section {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 0;
    height: 100%;
    background: var(--section-hero-bg);
  }

  .hero-media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    grid-row: 1;
    min-height: 0;
    background: var(--section-hero-bg);
  }

  .hero-image,
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--section-hero-bg);
    color: #ffffff;
    padding: var(--space-m);
  }

  .hero-image-placeholder pre {
    font-size: var(--fs-xs);
    overflow: auto;
    max-width: 100%;
    max-height: 100%;
  }

  .hero-navigation {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    mix-blend-mode: exclusion;
  }

  .hero-bio {
    grid-row: 2;
    padding: var(--space-s) var(--default-padding);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    background: var(--color-black);
    color: #ffffff;
  }

  .bio-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .bio-label {
    font-size: var(--fs--3);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.0463px;
    opacity: 0.3;
    color: #ffffff;
    margin: 0;
  }

  .bio-content {
    font-size: var(--fs--2);
    line-height: 1.6;
    color: var(--color-gray-secondary);
  }

  .bio-content :global(p) {
    font-size: var(--fs--2);
    line-height: 1.6;
    margin: 0;
    color: var(--color-gray-secondary);
  }

  .bio-content :global(p + p) {
    margin-top: 1em;
  }

  /* Mobile: adjust padding en layout */
  @media (max-width: 799px) {
    .hero-bio {
      grid-template-columns: 1fr;
      padding: var(--space-s) var(--default-padding);
    }
  }
</style>
