---
// Intro sectie met grote tekst en beschrijving
// Data kan uit siteSettings of homepage query komen

const title = 'Maarten Mieras'; // TODO: Haal uit Sanity
const description =
  'Digital Designer based in Rotterdam. Designs clear and intuitive digital products. Shoots film. Collects weird music.'; // TODO: Haal uit Sanity
---

<section class="intro-section">
  <div class="ticker-wrap">
    <div class="ticker">
      <span class="item-collection-1">
        <span class="item">{title}</span>
        <span class="item">{title}</span>
        <span class="item">{title}</span>
        <span class="item">{title}</span>
      </span>
      <span class="item-collection-2">
        <span class="item">{title}</span>
        <span class="item">{title}</span>
        <span class="item">{title}</span>
        <span class="item">{title}</span>
      </span>
    </div>
  </div>
  <p class="intro-description">{description}</p>
</section>

<style>
  .intro-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
    overflow: hidden;
    padding-block: var(--site-padding);
  }

  .ticker-wrap {
    display: block;
    width: 100%;
    margin: 0 auto;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }

  .ticker {
    display: inline-flex;
    animation: marquee 200s linear infinite;
    will-change: transform;
  }

  .item-collection-1,
  .item-collection-2 {
    display: inline-flex;
  }

  .item {
    display: inline-block;
    padding: 0 1rem;
    font-size: calc(2 * var(--fs-6));
    font-weight: 400;
    font-family: var(--font-family-special);
    line-height: 0.8;
    white-space: nowrap;
    letter-spacing: -0.05em;
  }

  .intro-description {
    font-size: var(--fs-0);
    font-weight: 400;
    line-height: 1.4;
    margin: var(--space-m) auto 0;
    max-width: 60ch;
    text-align: center;
  }

  /* Ticker animations */
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
