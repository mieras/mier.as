---
import { getSiteSettings } from '../lib/sanity';
import DarkMode from './DarkMode.astro';

const siteSettings = await getSiteSettings();

// Verwerk navigation data
const menuItems = siteSettings?.navigation?.menuItems || [];
const sortedMenuItems = menuItems.sort((a, b) => (a.order || 0) - (b.order || 0));

// Extract data voor navigatie
const companyName = siteSettings?.title || 'Mier.as';
const city = siteSettings?.footer?.address?.city || 'Rotterdam';
---

<nav class="z-10 w-full page-layout nav-monochrome">
  <div class="flex justify-between items-center page inner">
    <div class="flex gap-4 items-center text-white nav-left">
      <a href="/" aria-label="Homepage" class="nav-company">
        {companyName}
      </a>
      <span class="nav-city">{city}</span>
    </div>
    <div class="flex gap-4 items-center text-white nav-right">
      <span class="nav-time" id="local-time"></span>
      <span class="nav-temperature" id="temperature">--°C</span>
      <div class="nav-darkmode">
        <DarkMode />
      </div>
    </div>
  </div>
</nav>

<script>
  // Update local time
  function updateTime() {
    const now = new Date();
    const timeString = now.toLocaleTimeString('nl-NL', { 
      hour: '2-digit', 
      minute: '2-digit',
      hour12: false 
    });
    const timeElement = document.getElementById('local-time');
    if (timeElement) {
      timeElement.textContent = timeString;
    }
  }
  
  // Update time every minute
  updateTime();
  setInterval(updateTime, 60000);
  
  // Fetch temperature (placeholder - will be implemented with API later)
  async function fetchTemperature() {
    // TODO: Implement OpenWeatherMap API call
    // For now, just show placeholder
    const tempElement = document.getElementById('temperature');
    if (tempElement) {
      tempElement.textContent = '--°C';
    }
  }
  
  fetchTemperature();
</script>
<style>
  nav.nav-monochrome {
    z-index: 999;
    background-color: var(--clr-bg-alt);
    border-bottom: 1px solid var(--clr-border);
  }

  nav .inner {
    position: relative;
    z-index: 2;
    margin-block: var(--space-s);
  }

  .nav-left,
  .nav-right {
    font-family: var(--font-body);
    font-size: var(--fs--1);
    font-weight: 400;
  }

  .nav-company {
    font-weight: 600;
    text-decoration: none;
    color: var(--clr-text);
    transition: opacity 0.3s ease;
  }

  .nav-company:hover {
    opacity: 0.7;
  }

  .nav-city,
  .nav-time,
  .nav-temperature {
    color: var(--clr-text);
    opacity: 0.8;
  }

  .nav-darkmode {
    display: flex;
    align-items: center;
  }

  .nav-darkmode :global(.dark-mode-toggle) {
    position: static;
    transform: scale(0.8);
    width: 2rem;
    height: 2rem;
    border-color: var(--clr-border);
  }
</style>
