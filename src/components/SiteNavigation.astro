---
import { getSiteSettings } from '../lib/sanity';
import Weather from './Weather.astro';

const siteSettings = await getSiteSettings();

// Extract data voor navigatie
const companyName = siteSettings?.title || 'Mier.as';
const city = siteSettings?.footer?.address?.city || 'Rotterdam';
---

<nav class="nav-monochrome z-10 w-full">
  <div class="inner">
    <div class="nav-left">
      <a href="/" aria-label="Homepage" class="nav-company">
        {companyName}
      </a>
      <span class="nav-city">{city}</span>
    </div>
    <div class="nav-right">
      <span class="nav-time" id="local-time"></span>
      <Weather city={city} />
    </div>
  </div>
</nav>

<script>
  // Update local time
  function updateTime() {
    const now = new Date();
    const timeString = now.toLocaleTimeString('nl-NL', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const timeElement = document.getElementById('local-time');
    if (timeElement) {
      timeElement.textContent = timeString;
    }
  }

  // Update time every minute
  updateTime();
  setInterval(updateTime, 60000);
</script>
<style>
  nav.nav-monochrome {
    z-index: 999;
    border-bottom: none;
    color: #ffffff;
  }

  nav.nav-monochrome .nav-company,
  nav.nav-monochrome .nav-city,
  nav.nav-monochrome .nav-time {
    color: #ffffff;
  }

  /* Hero overlay variant - witte tekst (blijft hetzelfde) */
  .hero-navigation nav.nav-monochrome {
    color: #ffffff;
  }

  .hero-navigation nav.nav-monochrome .nav-company,
  .hero-navigation nav.nav-monochrome .nav-city,
  .hero-navigation nav.nav-monochrome .nav-time {
    color: #ffffff;
  }

  nav .inner {
    position: relative;
    z-index: 2;
    /* margin-block: var(--space-s); */
    padding: var(--space-xs);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-left,
  .nav-right {
    font-family: var(--font-family-default);
    font-size: var(--fs--3);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.0463px;
    line-height: 1;
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .nav-company {
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .nav-company:hover {
    opacity: 0.7;
  }

  .nav-city,
  .nav-time {
    opacity: 1;
  }

  .nav-right {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
  }
</style>
