---
import { getSiteSettings } from '../lib/sanity';
import DarkMode from './DarkMode.astro';
import Weather from './Weather.astro';

const siteSettings = await getSiteSettings();

// Extract data voor navigatie
const companyName = siteSettings?.title || 'Mier.as';
const city = siteSettings?.footer?.address?.city || 'Rotterdam';
---

<nav class="nav-monochrome z-10 w-full">
  <div class="inner flex items-center justify-between">
    <div class="nav-left flex items-center gap-4">
      <a href="/" aria-label="Homepage" class="nav-company">
        {companyName}
      </a>
      <span class="nav-city">{city}</span>
    </div>
    <div class="nav-right flex items-center gap-4">
      <span class="nav-time" id="local-time"></span>
      <Weather city={city} />
      <div class="nav-darkmode">
        <DarkMode />
      </div>
    </div>
  </div>
</nav>

<script>
  // Update local time
  function updateTime() {
    const now = new Date();
    const timeString = now.toLocaleTimeString('nl-NL', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const timeElement = document.getElementById('local-time');
    if (timeElement) {
      timeElement.textContent = timeString;
    }
  }

  // Update time every minute
  updateTime();
  setInterval(updateTime, 60000);
</script>
<style>
  nav.nav-monochrome {
    z-index: 999;
    border-bottom: none;
  }

  /* Hero overlay variant - witte tekst */
  .hero-navigation nav.nav-monochrome {
    color: #ffffff;
  }

  .hero-navigation nav.nav-monochrome .nav-company,
  .hero-navigation nav.nav-monochrome .nav-city,
  .hero-navigation nav.nav-monochrome .nav-time {
    color: #ffffff;
  }

  nav .inner {
    position: relative;
    z-index: 2;
    /* margin-block: var(--space-s); */
    padding: var(--space-s) var(--default-padding);
  }

  .nav-left,
  .nav-right {
    font-family: var(--font-family-default);
    font-size: var(--fs--3);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.0463px;
    line-height: 1;
  }

  .nav-company {
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .nav-company:hover {
    opacity: 0.7;
  }

  .nav-city,
  .nav-time {
    opacity: 1;
  }

  .nav-right {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
  }

  .nav-darkmode {
    display: flex;
    align-items: center;
  }

  .nav-darkmode :global(.dark-mode-toggle) {
    position: static;
    transform: scale(0.8);
    width: 2rem;
    height: 2rem;
    border-color: #ffffff;
  }

  .hero-navigation .nav-darkmode :global(.dark-mode-toggle) {
    border-color: #ffffff;
  }
</style>
