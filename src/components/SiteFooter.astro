      <p class="text-8xl tracking-tight text-balance">We're always up for conversation
<br> <span class="">Let's connect</span></p>
      
      
    </div>
    <div class="page footer__widgets flex flex-col gap-[var(--space-l)]">
      <div class="grid grid-cols-1 gap-12 lg:gap-24 md:grid-cols-4">
        <Widget title="Join our Newsletter">
          <Newsletter />
        </Widget>
        <Widget title="Address">
          <address>
            <ul role="list" class="list-none">
              <li>Bedrijfsnaam</li>
              <li>Adres</li>
              <li>Postcode Plaats</li>
              <li>Land</li>
            </ul>
          </address>
        </Widget>
        <Widget title="Socialize">
          <ul role="list" class="list-none">
            <li><a href="#" aria-label="Follow us on instagram" target="_blank">Instagram</a></li>
            <li><a href="#" aria-label="Follow us on behance" target="_blank">Behance</a></li>
            <li><a href="#" aria-label="Follow us on linkedin" target="_blank">Linkedin</a></li>
          </ul>
        </Widget>
        <Widget title="Get in touch">
          <ul role="list" class="list-none">
            <li><a href="tel:" aria-label="Call us" >Telefoonnummer</a></li>
            <li><a href="mailto:?subject=Hello!"  aria-label="E-mail us" >E-mailadres</a></li>
          </ul>
        </Widget>
      </div>
  <div class="flex justify-between py-[var(--space-s)] items-end text-xs text-2xs legal page">
     <button data-cc="show-preferencesModal" type="button" class="button-cookieconsent">Cookie voorkeuren</button>
        <p>
          &copy; {currentYear} - Mier.as 
        </p>
        <div class="flex gap-4">
         
          <a href="https://astro.build/" aria-label="Read our legal Terms & Conditions" >Terms & Conditions</a>
        </div>
      </div>
      
  </div>
  
</footer>

<style>
  /* * > * {
    border: 1px solid red;

  } */

  p{
    margin:0;
  }

  address {
    font-style: normal;
  }

  footer {
    width: 100%;
    
    min-height: 100vh;
  }

  .footer__top {
    margin-block: 0;}

  .footer__widgets {  
    margin-block: 0;
  }


  ul li {
    margin-block: 0.0125em;
    font-size: var(--fs--3);
    line-height: 150%;
    
  }

    ul li a {
      opacity: 0.9;
      text-decoration: none;
    }

  footer .legal {
    
    font-size: var(--fs--3);
  }

  .button-cookieconsent {
    border:none;
  }


  
</style>
