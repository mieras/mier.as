---
import { getSiteSettings } from '../lib/sanity';
import DarkMode from './DarkMode.astro';

const siteSettings = await getSiteSettings();

// Extract footer data
const address = siteSettings?.footer?.address || {};
const contact = siteSettings?.footer?.contact || {};
const legal = siteSettings?.footer?.legal || {};

// Build address string: "Studio: Het Industriegebouw, Goudsesingel 136 UNIT 5, 3011 KD, Rotterdam (NL), hello@mier.as"
const addressParts = [];
if (address.company) addressParts.push(address.company);
if (address.street) addressParts.push(address.street);
if (address.city) {
  const cityParts = [address.city];
  if (address.country) cityParts.push(`(${address.country})`);
  addressParts.push(cityParts.join(' '));
}
const addressString = addressParts.length > 0 ? addressParts.join(', ') : '';

// Build legal string: "BTW: NL001619749B74 / BANK: NL11INGB0005505348 / KVK: 24486874 /T+C"
const legalParts = [];
if (legal.btw) legalParts.push(`BTW: ${legal.btw}`);
if (legal.bank) legalParts.push(`BANK: ${legal.bank}`);
if (legal.kvk) legalParts.push(`KVK: ${legal.kvk}`);
const legalString =
  legalParts.length > 0 ? `${legalParts.join(' / ')} /T+C` : '/T+C';
---

<footer class="footer-simple">
  <div class="footer-content">
    {
      addressString && (
        <p class="footer-address">
          Studio: {addressString}
          {contact.email && (
            <>
              , <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </>
          )}
        </p>
      )
    }
    {legalString && <p class="footer-legal">{legalString}</p>}
    <div class="footer-darkmode">
      <DarkMode />
    </div>
  </div>
</footer>

<style>
  .footer-simple {
    position: relative;
    width: 100%;
    padding: var(--space-2xs) var(--space-s);
    background: var(--section-footer-bg);
    font-size: var(--fs--3);
    color: var(--footer-text);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.3333px;
  }

  .footer-content {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .footer-darkmode {
    /* position: absolute; */
    bottom: var(--space-xs);
    right: var(--default-padding);
  }

  .footer-address,
  .footer-legal {
    font-size: var(--fs--3);
    font-weight: 500;
    margin: 0;
    line-height: 1;
    opacity: 0.5;
    color: var(--footer-text);
  }

  .footer-address a,
  .footer-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .footer-address a:hover,
  .footer-link:hover {
    opacity: 0.7;
  }
</style>
