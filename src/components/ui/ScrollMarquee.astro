---
interface Props {
  word?: string;
  title?: string;
  repeat?: number;
  direction?: 'left' | 'right';
  speed?: number;
  variant?: 'light' | 'dark';
  ariaLabel?: string;
}

const {
  word,
  title,
  repeat = 10,
  direction = 'left',
  speed = 1,
  variant = 'dark',
  ariaLabel,
} = Astro.props;

const label = word || title || '';
const safeRepeat = Math.max(2, repeat);
---

<section
  class={`mq mq--${variant}`}
  data-marquee
  data-direction={direction}
  data-speed={speed}
  aria-label={ariaLabel || `Section title: ${label}`}
>
  <div class="mq__viewport">
    <div class="mq__rail" data-rail>
      {
        Array.from({ length: safeRepeat }).map(() => (
          <h4 class="mq__item">{label}</h4>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mq {
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .mq--light {
    background-color: var(--section-music-bg);
  }

  .mq--dark {
    background-color: var(--section-work-bg);
  }

  .mq__viewport {
    width: 100%;
  }

  .mq__rail {
    display: flex;
    white-space: nowrap;
    min-height: 1em;
    gap: var(--space-m);
    align-items: center;
  }

  .mq__item {
    font-size: clamp(6rem, 16vw, 13rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    line-height: 1em;
    margin: 0;

    flex-shrink: 0;
  }

  .mq--light .mq__item {
    color: var(--text-light);
  }

  .mq--dark .mq__item {
    color: var(--work-ticker-text);
  }
</style>

<script>
  import { bindMarqueeLifecycle } from '../../scripts/marquee';

  bindMarqueeLifecycle();
</script>
