---
interface Props {
  tabs: Array<{
    id: string;
    label: string;
    ariaLabel?: string;
  }>;
  defaultTab?: string;
  sectionClass?: string;
  sticky?: boolean;
  variant?: 'default' | 'work' | 'music';
}

const {
  tabs,
  defaultTab,
  sectionClass = '',
  sticky = false,
  variant = 'default',
} = Astro.props;
const activeTab = defaultTab || tabs[0]?.id || '';
---

<div class="tab-group-wrapper">
  <div class={`tab-group ${sectionClass} tab-group-${variant}`}>
    {
      variant === 'music' ? (
        <div class="tab-group-tabs-wrapper-music">
          <div
            class={`tab-group-tabs ${sticky ? 'tab-group-tabs-sticky' : ''} tab-group-tabs-${variant}`}
            role="tablist"
            aria-label="Tabs"
            style={`--active-tab-index: ${tabs.findIndex((t) => t.id === activeTab)}; --tab-count: ${tabs.length};`}
          >
            <div class="tab-active-indicator" aria-hidden="true" />
            {tabs.map((tab) => (
              <button
                class={`tab-button ${tab.id === activeTab ? 'tab-active' : ''}`}
                data-tab={tab.id}
                role="tab"
                aria-selected={tab.id === activeTab ? 'true' : 'false'}
                aria-label={tab.ariaLabel || `Show ${tab.label}`}
              >
                {tab.label}
              </button>
            ))}
          </div>
        </div>
      ) : (
        <div
          class={`tab-group-tabs ${sticky ? 'tab-group-tabs-sticky' : ''} tab-group-tabs-${variant}`}
          role="tablist"
          aria-label={variant === 'work' ? 'Work categories' : 'Tabs'}
          style={`--active-tab-index: ${tabs.findIndex((t) => t.id === activeTab)}; --tab-count: ${tabs.length};`}
        >
          <div class="tab-active-indicator" aria-hidden="true" />
          {tabs.map((tab) => (
            <button
              class={`tab-button ${tab.id === activeTab ? 'tab-active' : ''}`}
              data-tab={tab.id}
              role="tab"
              aria-selected={tab.id === activeTab ? 'true' : 'false'}
              aria-label={tab.ariaLabel || `Show ${tab.label}`}
            >
              {tab.label}
            </button>
          ))}
        </div>
      )
    }
    <slot />
  </div>
</div>

<script>
  // Tab switching functionality - scoped to tab group
  const initTabSwitching = (container: HTMLElement) => {
    // Check if already initialized to prevent duplicate listeners
    if (container.hasAttribute('data-tabs-initialized')) {
      return;
    }
    container.setAttribute('data-tabs-initialized', 'true');

    const tabButtons = container.querySelectorAll(
      '.tab-group-tabs .tab-button',
    );
    const tabContents = container.querySelectorAll('.tab-content');
    const tabGroupTabs = container.querySelector(
      '.tab-group-tabs',
    ) as HTMLElement;

    if (tabButtons.length === 0 || tabContents.length === 0) {
      console.warn('TabGroup: No tab buttons or content found');
      return;
    }

    tabButtons.forEach((button, index) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const targetTab = button.getAttribute('data-tab');
        if (!targetTab) {
          console.warn('TabGroup: No data-tab attribute found on button');
          return;
        }

        if (import.meta.env.DEV) {
          console.log('TabGroup: Switching to tab', {
            targetTab,
            index,
            eventTarget: (e.target as HTMLElement)?.className,
          });
        }

        // Update active button
        tabButtons.forEach((btn) => {
          btn.classList.remove('tab-active');
          btn.setAttribute('aria-selected', 'false');
        });
        button.classList.add('tab-active');
        button.setAttribute('aria-selected', 'true');

        // Update active indicator positie (CSS-only animatie)
        if (tabGroupTabs) {
          tabGroupTabs.style.setProperty(
            '--active-tab-index',
            index.toString(),
          );
        }

        // Update active content
        let foundActiveContent = false;
        tabContents.forEach((content) => {
          const contentTab = content.getAttribute('data-tab-content');
          if (contentTab === targetTab) {
            content.classList.add('tab-content-active');
            foundActiveContent = true;
            if (import.meta.env.DEV) {
              console.log(
                'TabGroup: Activated content for tab',
                targetTab,
                content,
              );
            }
          } else {
            content.classList.remove('tab-content-active');
          }
        });

        if (!foundActiveContent && import.meta.env.DEV) {
          console.warn('TabGroup: No content found for tab', targetTab, {
            availableTabs: Array.from(tabContents).map((c) =>
              c.getAttribute('data-tab-content'),
            ),
          });
        }

        // Dispatch custom event for tab change
        const event = new CustomEvent('tab-change', {
          detail: { tabId: targetTab },
          bubbles: true,
        });
        container.dispatchEvent(event);
      });
    });
  };

  const initializeAllTabs = () => {
    const tabGroups = document.querySelectorAll('.tab-group');
    tabGroups.forEach((group) => {
      initTabSwitching(group as HTMLElement);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAllTabs);
  } else {
    initializeAllTabs();
  }

  document.addEventListener('astro:page-load', () => {
    // Remove initialization flag to allow re-initialization after view transition
    const tabGroups = document.querySelectorAll('.tab-group');
    tabGroups.forEach((group) => {
      group.removeAttribute('data-tabs-initialized');
    });
    initializeAllTabs();
  });
</script>

<style>
  .tab-group {
    /* display: grid; */
    /* grid-template-rows: auto 1fr; */
    height: 100%;
    /* min-height: 0; */
    /* background-color: var(--bg); */
    width: 100%;
  }

  /* Work variant: gebruik work achtergrond */
  .tab-group.projects-section {
    background-color: transparent;
    padding: 0 var(--space-xs);
  }

  .tab-group-tabs {
    display: flex;
    gap: 0;
    margin-bottom: -1px;
    border-bottom: 1px solid var(--border);
    z-index: 5;
    background-color: var(--bg);
    width: 100%;
    position: relative;
  }

  /* Active indicator - slide animatie (zoals CodePen voorbeeld) */
  .tab-active-indicator {
    position: absolute;
    top: 0;
    left: 0;

    width: calc(100% / var(--tab-count, 1));
    /* Horizontale slide animatie - CSS only */
    transform: translateX(calc(var(--active-tab-index, 0) * 100%));
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
    pointer-events: none;
  }

  /* Work tabs variant: witte achtergrond, gele active state, rounded pills */
  .tab-group-tabs-work {
    --pad: 0.35rem;
    background-color: var(--work-tabs-bg);
    border-bottom: none;
    border-radius: 999px;
    padding: var(--pad);
    overflow: hidden;
    margin: 0;
    width: 100%;
  }

  /* Active indicator voor work variant */
  .tab-group-tabs-work .tab-active-indicator {
    position: absolute;
    inset: var(--pad);
    width: calc((100% - (var(--pad) * 2)) / var(--tab-count, 1));
    background-color: var(--work-tabs-active-bg);
    border-radius: 999px;
    transform: translateX(calc(var(--active-tab-index, 0) * 100%));
    transition: transform 200ms ease;
  }

  /* Music tabs wrapper: padding voor de tabs container */
  .tab-group-tabs-wrapper-music {
    padding-inline: var(--space-s);
    width: 100%;
  }

  /* Music tabs variant: donkere container */
  .tab-group-tabs-music {
    background-color: var(--color-dark-container);
    border-bottom: none;
    border-radius: 999px;
    overflow: hidden;
    margin: 0;
    width: 100%;
  }

  /* Active indicator voor music variant */
  .tab-group-tabs-music .tab-active-indicator {
    background-color: var(--color-accent-yellow);
    border-radius: 999px;
    height: calc(100% - 10px);
    top: 5px;
    width: calc(100% / var(--tab-count, 1));
    transform: translateX(calc(var(--active-tab-index, 0) * 100%));
  }

  .tab-group-tabs-sticky {
    position: sticky;
    top: 0;
  }

  .tab-button {
    background: transparent;
    border: none;
    padding: var(--space-xs) var(--default-padding);
    font-size: var(--fs--1);
    line-height: 1;
    font-weight: 400;
    cursor: pointer;

    transition: all 0.2s ease;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    position: relative;
    z-index: 2;
  }

  /* Work tabs styling */
  .tab-group-tabs-work .tab-button {
    font-family: var(--font-family-heading);
    font-size: var(--fs-0);
    font-weight: 600;
    text-align: center;
    padding: var(--space-xs) var(--space-m);
    color: var(--work-tabs-inactive-text);
    border-radius: 999px;
    border: 0;
    background: transparent;
    cursor: pointer;
    z-index: 2;
  }

  .tab-group-tabs-work .tab-button.tab-active {
    background-color: transparent;
    color: var(--work-tabs-active-text);
    border-radius: 999px;
  }

  /* Music tabs styling */
  .tab-button {
    font-size: var(--fs--2);
    font-weight: 500;
    padding: var(--space-xs) var(--space-m);
    color: #f1f0ec;
  }

  .tab-group-tabs-music .tab-button.tab-active {
    background-color: transparent;
    color: var(--color-black);
    border-radius: 999px;
    opacity: 1;
  }

  /* Music variant: content van rand tot rand */
  .tab-group-music .tab-content {
    padding: 0;
    margin: 0;
    width: 100%;
  }

  /* Default tabs styling */
  .tab-button.tab-active {
    background-color: transparent;
    color: var(--bg);
    border-bottom-color: var(--border);
  }

  /* Active indicator voor default variant */
  .tab-group-tabs:not(.tab-group-tabs-work):not(.tab-group-tabs-music)
    .tab-active-indicator {
    background-color: var(--text);
    height: calc(100% + 1px);
    top: 0;
  }

  .tab-button:hover:not(.tab-active) {
    opacity: 0.7;
  }

  /* Mobile: stack everything */
  @media (max-width: 799px) {
    .tab-group {
      display: block;
      height: auto;
    }

    .tab-group-tabs {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }
</style>
