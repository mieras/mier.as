---
interface Props {
  tabs: Array<{
    id: string;
    label: string;
    ariaLabel?: string;
  }>;
  defaultTab?: string;
  sectionClass?: string;
  sticky?: boolean;
  variant?: 'default' | 'work' | 'music';
}

const { tabs, defaultTab, sectionClass = '', sticky = false, variant = 'default' } = Astro.props;
const activeTab = defaultTab || tabs[0]?.id || '';
---

<div class={`tab-group ${sectionClass} tab-group-${variant}`}>
  <div class={`tab-group-tabs ${sticky ? 'tab-group-tabs-sticky' : ''} tab-group-tabs-${variant}`}>
    {
      tabs.map((tab) => (
        <button
          class={`tab-button ${tab.id === activeTab ? 'tab-active' : ''}`}
          data-tab={tab.id}
          aria-label={tab.ariaLabel || `Show ${tab.label}`}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <slot />
</div>

<script>
  // Tab switching functionality - scoped to tab group
  const initTabSwitching = (container: HTMLElement) => {
    const tabButtons = container.querySelectorAll(
      '.tab-group-tabs .tab-button',
    );
    const tabContents = container.querySelectorAll('.tab-content');

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetTab = button.getAttribute('data-tab');

        // Update active button
        tabButtons.forEach((btn) => {
          btn.classList.remove('tab-active');
        });
        button.classList.add('tab-active');

        // Update active content
        tabContents.forEach((content) => {
          content.classList.remove('tab-content-active');
          if (content.getAttribute('data-tab-content') === targetTab) {
            content.classList.add('tab-content-active');

            // Dispatch custom event for tab change
            const event = new CustomEvent('tab-change', {
              detail: { tabId: targetTab, content },
              bubbles: true,
            });
            container.dispatchEvent(event);
          }
        });
      });
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    const tabGroups = document.querySelectorAll('.tab-group');
    tabGroups.forEach((group) => {
      initTabSwitching(group as HTMLElement);
    });
  });

  document.addEventListener('astro:page-load', () => {
    const tabGroups = document.querySelectorAll('.tab-group');
    tabGroups.forEach((group) => {
      initTabSwitching(group as HTMLElement);
    });
  });
</script>

<style>
  .tab-group {
    /* display: grid; */
    /* grid-template-rows: auto 1fr; */
    height: 100%;
    /* min-height: 0; */
    background-color: var(--bg);
  }

  .tab-group-tabs {
    display: flex;
    gap: 0;
    margin-bottom: -1px;
    border-bottom: 1px solid var(--border);
    z-index: 5;
    background-color: var(--bg);
    width: 100%;
  }

  /* Work tabs variant: witte achtergrond, gele active state, rounded pills */
  .tab-group-tabs-work {
    background-color: var(--work-tabs-bg);
    border-bottom: none;
    border-radius: 999px;
    padding: 0;
    overflow: hidden;
    margin: var(--space-s) var(--default-padding);
    width: calc(100% - (var(--default-padding) * 2));
  }

  /* Music tabs variant: donkere container */
  .tab-group-tabs-music {
    background-color: var(--section-music-bg);
    border-bottom: none;
    border-radius: 999px;
    padding: 0;
    overflow: hidden;
    margin: var(--space-s) var(--default-padding);
    width: calc(100% - (var(--default-padding) * 2));
  }

  .tab-group-tabs-sticky {
    position: sticky;
    top: 0;
  }

  .tab-button {
    background: transparent;
    border: none;
    padding: var(--space-xs) var(--default-padding);
    font-size: var(--fs--1);
    line-height: 1;
    font-weight: 400;
    cursor: pointer;

    transition: all 0.2s ease;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
  }

  /* Work tabs styling */
  .tab-group-tabs-work .tab-button {
    font-family: var(--font-family-heading);
    font-size: var(--fs-0);
    font-weight: 900;
    text-transform: uppercase;
    padding: var(--space-s) var(--space-xs);
    color: var(--work-tabs-inactive-text);
    border-radius: 999px;
  }

  .tab-group-tabs-work .tab-button.tab-active {
    background-color: var(--work-tabs-active-bg);
    color: var(--work-tabs-active-text);
    border-radius: 999px;
  }

  /* Music tabs styling */
  .tab-group-tabs-music .tab-button {
    font-size: var(--fs--2);
    font-weight: 500;
    padding: var(--space-xs) var(--space-m);
    color: #f1f0ec;
    opacity: 0.8;
  }

  .tab-group-tabs-music .tab-button.tab-active {
    background-color: var(--color-accent-yellow);
    color: #060205;
    border-radius: 999px;
    opacity: 1;
  }

  /* Default tabs styling */
  .tab-button.tab-active {
    background-color: var(--text);
    color: var(--bg);
    border-bottom-color: var(--border);
  }

  .tab-button:hover:not(.tab-active) {
    opacity: 0.7;
  }

  /* Mobile: stack everything */
  @media (max-width: 799px) {
    .tab-group {
      display: block;
      height: auto;
    }

    .tab-group-tabs {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }
</style>
