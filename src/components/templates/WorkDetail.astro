---
import { Image } from 'astro:assets'
import Hero from '../Hero.astro'
import { PortableText } from 'astro-portabletext'
import { urlForImage } from '../../sanity/lib/image'

type Props = {
  data: any
}

const { data } = Astro.props

// DEBUG: Log project detail data
if (import.meta.env.DEV) {
  console.log('🎨 WorkDetail received data:', {
    _type: data._type,
    projectTitle: data.projectTitle,
    title: data.title,
    hasDescription: !!data.description,
    descriptionBlocks: data.description?.length || 0,
  });
}

// Use new structure: projectTitle, subtitle, description
const heroData = {
  title: data.projectTitle || data.title || '',
  subtitle: data.subtitle || '',
  intro: '', // Description is now separate, rendered below
  coverMedia: data.preview?.image || null,
  clients: data.client ? [data.client] : []
};

if (import.meta.env.DEV) {
  console.log('🎨 Processed hero data:', heroData);
  console.log('🎨 Description blocks count:', data.description?.length || 0);
}

// PortableText components for description
const descriptionComponents = {
  types: {},
  marks: {
    strong: ({ children }: any) => <strong>{children}</strong>,
    em: ({ children }: any) => <em>{children}</em>,
  },
  block: {
    normal: ({ children }: any) => <p>{children}</p>,
  },
  list: {},
  listItem: {},
};
---

<Hero data={heroData} />

{
  data.description && data.description.length > 0 && (
    <article class="project full">
      <div class="project-description">
        <PortableText value={data.description} components={descriptionComponents} />
      </div>
    </article>
  )
}

<style>
  .project {
    /* Padding now handled by page-layout grid via --site-padding */
  }

  .project-description {
    padding: var(--site-padding);
  }

  .project-description :global(p) {
    margin-bottom: var(--space-m);
    line-height: 1.6;
  }

  .project-description :global(p:last-child) {
    margin-bottom: 0;
  }

  .project-description :global(strong) {
    font-weight: 600;
  }

  .project-description :global(em) {
    font-style: italic;
  }
</style>
