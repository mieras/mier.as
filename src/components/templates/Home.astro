---
import { getAllProjects } from '../../lib/sanity';
import { getAllPhotography } from '../../lib/sanity';
import IntroSection from '../sections/IntroSection.astro';
import ProjectsSection from '../sections/ProjectsSection.astro';
import ProjectsMedia from '../sections/ProjectsMedia.astro';
import MusicSection from '../sections/MusicSection.astro';

type Project = {
  _id: string;
  title: string;
  slug: string;
  year?: number;
  subtitle?: string;
  intro?: string;
  role?: string;
  thumbnail?: {
    image?: any;
    aspectRatio?: string;
  };
  client?: {
    title: string;
  };
};

// Haal alle projecten en photography op met error handling
let projects: Project[] = [];
let photography: any[] = [];

try {
  projects = (await getAllProjects()) as Project[];
  console.log(`🏗️ Build: Loaded ${projects.length} projects`);
} catch (error) {
  console.error('❌ Failed to load projects during build:', error);
  // Laat de build falen zodat je het ziet
  throw error;
}

try {
  photography = (await getAllPhotography()) as any[];
  console.log(`🏗️ Build: Loaded ${photography.length} photography items`);
} catch (error) {
  console.error('❌ Failed to load photography during build:', error);
  // Laat de build falen zodat je het ziet
  throw error;
}
---

<main class="main">
  <div class="left">
    <IntroSection />

    <ProjectsSection {projects} {photography} />
  </div>
  <div class="right">
    <div class="project-image">
      <ProjectsMedia {projects} {photography} />
    </div>
    <section class="music">
      <MusicSection />
    </section>
  </div>
</main>

<style>
  .main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  /* Left column (nested grid) */
  .left {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border-right: 1px solid var(--border);
    min-height: 0;
    overflow: hidden;
  }

  .hero {
    /* display: flex; */
    align-items: center;
    justify-content: flex-start;
  }

  .projects {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    min-height: 0; /* Important for overflow to work */
  }

  /* Right column (nested grid) */
  .right {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 0; /* Important for overflow to work */
  }

  .project-image {
    padding: var(--space-xs) var(--default-padding);
    display: grid;
    align-items: center;
    min-height: 0; /* Important for overflow to work */
    overflow: hidden;
  }

  .music {
    border-top: 1px solid var(--border);
    overflow-y: auto;
    min-height: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Mobile: stack everything */
  @media (max-width: 799px) {
    .grid {
      display: block;
      height: auto;
      overflow: visible;
    }

    .main {
      display: block;
      border-top: none;
      overflow: visible;
    }

    .left,
    .right {
      display: block;
      border-right: none;
      overflow: visible;
      height: auto;
    }

    .left {
      border-bottom: 1px solid var(--border);
    }

    .hero {
      padding: var(--default-padding);
      border-bottom: 1px solid var(--border);
    }

    .projects {
      overflow: visible;
    }

    .project-image {
      display: none;
    }
  }
</style>
