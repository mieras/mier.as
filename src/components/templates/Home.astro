---
import { getAllProjects } from '../../lib/sanity';
import { getAllPhotography } from '../../lib/sanity';
import { getHomeData } from '../../lib/sanity';
import HeroSection from '../sections/HeroSection.astro';
import WorkSection from '../sections/WorkSection.astro';
import MusicSection from '../sections/MusicSection.astro';
import SiteFooter from '../SiteFooter.astro';

type Project = {
  _id: string;
  projectTitle?: string;
  title?: string; // Fallback for old data
  slug: string;
  year?: number;
  subtitle?: string;
  preview?: {
    image?: any;
    video?: any;
  };
  client?: {
    title: string;
  };
};

type Props = {
  data?: any;
  initialProjectSlug?: string | null;
  initialPhotographySlug?: string | null;
};

const { initialProjectSlug = null, initialPhotographySlug = null } =
  Astro.props as Props;

// Haal alle data op
const homeData = await getHomeData();
const projects = (await getAllProjects()) as Project[];
const photography = (await getAllPhotography()) as any[];

// Extract hero data
const heroMedia = homeData?.heroMedia;
const introCols = homeData?.introCols;

// Debug logging
if (import.meta.env.DEV) {
  console.log('🏠 Home template - homeData:', {
    hasHomeData: !!homeData,
    hasHeroMedia: !!heroMedia,
    heroMediaType: heroMedia?.mediaType,
    hasImage: !!heroMedia?.image,
    imageAsset: !!heroMedia?.image?.asset,
    videoUrl: heroMedia?.videoUrl,
    introColsCount: introCols?.length || 0,
    fullHeroMedia: heroMedia,
  });

  if (!heroMedia) {
    console.warn(
      '⚠️ No heroMedia found in homeData. Make sure heroMedia is configured in Sanity for the homepage.',
    );
  }
}
---

<main class="page">
  <SiteFooter />

  <div class="main-content">
    <section class="hero" id="hero">
      <HeroSection
        heroMedia={heroMedia}
        introCols={introCols}
        useThreeJs={true}
      />
    </section>

    <section class="work">
      <WorkSection
        {projects}
        {photography}
        initialProjectSlug={initialProjectSlug}
        initialPhotographySlug={initialPhotographySlug}
      />
    </section>

    <section class="music">
      <MusicSection />
    </section>

    <!-- Mixcloud player - fixed bottom -->
    <div class="mixcloud-player" style="display: none;">
      <iframe
        class="mixcloud-player__iframe"
        width="100%"
        height="60"
        src=""
        allow="encrypted-media; fullscreen; autoplay; idle-detection; speaker-selection; web-share;"
      ></iframe>
      <button class="mixcloud-player__close" aria-label="Close player">
        ×
      </button>
    </div>
  </div>
</main>

<style>
  .page {
    position: relative;
    min-height: 100vh;
  }

  /* Main content: padding voor footer ruimte op desktop */
  .main-content {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .hero {
    min-height: 90dvh;
    background: var(--section-hero-bg);
  }

  .work {
    min-height: 100dvh;
    background: var(--section-work-bg);
  }

  .music {
    background: var(--section-music-bg);
  }

  /* Mixcloud player - fixed bottom of main-content */
  .mixcloud-player {
    position: fixed;
    bottom: 0;

    right: 0;
    width: calc(100% - 2rem);
    height: 4rem;
    max-width: 100%;
    background: var(--section-music-bg);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    /* padding: var(--space-s); */
    box-sizing: border-box;
  }

  .mixcloud-player__iframe {
    width: 100%;
    max-width: 100%;
    height: 100%;
    border: none;
    background: var(--section-music-bg);
  }

  .mixcloud-player__close {
    position: absolute;
    top: -1rem;
    right: 1rem;
    background: var(--text-light);
    color: var(--section-music-bg);
    border: none;
    width: 2rem;
    height: 2rem;
    border-radius: 100vw;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .mixcloud-player__close:hover {
    opacity: 0.8;
  }
</style>
