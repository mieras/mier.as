# Sanity Configuration
# Vul hier je eigen Sanity Project ID in (vind je in https://www.sanity.io/manage)
PUBLIC_SANITY_PROJECT_ID=your-project-id-here

# Dataset naam (meestal "production" of "development")
PUBLIC_SANITY_DATASET=production

# API versie (standaard: "2025-01-28")
PUBLIC_SANITY_API_VERSION=2025-01-28

# Optioneel: Voor Visual Editing (draft preview)
# SANITY_API_READ_TOKEN=your-read-token-here

# Optioneel: Voor image domain whitelisting
# IMAGE_DOMAIN=your-domain.com
